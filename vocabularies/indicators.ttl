indicator:WageElasticity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The percentage change in job-search, application, labor-supply, or labor-demand response associated with a one-percent change in wages." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Wage elasticity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measures state:JobApplicationBehavior .

indicator:WageGap a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "wage gaps" ;
    skos:definition "An absolute or relative difference in average or median pay between defined groups of workers, occupations, sectors, or locations." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Wage gap" ;
    skos:scopeNote "Use for a computed pay contrast between defined groups. Use wage inequality for the underlying labor-market distributional condition." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:WageInequality .

indicator:WalkingSpeedOutcome a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:definition "Gait speed measured over a standardised distance, used as a functional performance indicator in rehabilitation, ageing, and musculoskeletal research." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072797> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Walking speed" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:WeightForAgeZScore a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://www.who.int/tools/child-growth-standards/standards/weight-for-age> ;
    skos:definition "Age- and sex-standardized body weight expressed in standard deviation units relative to a specified child growth reference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Weight-for-age z-score" ;
    skos:scopeNote "Continuous WAZ; retain growth reference and age range on the finding. Do not interpret a mean score as underweight prevalence." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth .

indicator:ZeroTariffLineShare a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 10.a.1" ;
    skos:definition "Proportion of tariff lines applied to imports from least developed countries and developing countries with zero tariff." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/10_a_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Zero-tariff line share" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
    ue:measures state:TradePolicyOpenness .

indicator:FailureToRescueRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "FTR rate" ;
    skos:definition "The rate at which patients who develop a serious complication during a healthcare encounter subsequently die, used as an indicator of healthcare quality and patient safety." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067248> ;
    skos:example "Hospital-level failure-to-rescue rate measured as deaths among surgical patients with postoperative complications." ;
    skos:hiddenLabel "failure to rescue mortality" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Failure to rescue rate" ;
    skos:related state:AdverseEvents,
        state:CriticalCareOutcome,
        indicator:HealthcareNearMissRate ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:GlobalDiseaseburden a skos:Concept,
        ue:Indicator ;
    skos:altLabel "DALYs",
        "GBD",
        "disease burden" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000087509> ;
    skos:definition "Aggregate population-level measures of the total impact of diseases, injuries, and risk factors on health, typically expressed as disability-adjusted life years (DALYs) lost across populations and geographies." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071219> ;
    skos:example "IHME GBD estimates of DALYs attributable to ischemic heart disease by country and year." ;
    skos:hiddenLabel "burden of disease",
        "global disease burden" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Global burden of disease" ;
    skos:related indicator:DiseasePrevalence,
        state:MaternalMortality,
        state:NeonatalMortality,
        state:UnderFiveMortality ;
    skos:scopeNote "Refers to composite summary measures (e.g., DALYs, YLDs, YLLs) used to compare and track health loss across conditions and regions; distinct from condition-specific prevalence or mortality." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:HeartRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Cardiac rate",
        "Pulse rate" ;
    skos:definition "Measured number of heartbeats per unit time, used as a clinical indicator of cardiovascular function, physiological stress, or response to treatment." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070276> ;
    skos:example "Measuring resting heart rate before and after a cardiac rehabilitation program to assess physiological improvement." ;
    skos:hiddenLabel "HR measurement",
        "heart rate determination" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Heart rate" ;
    skos:related indicator:CardiorespiratoryfFitness ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:InfectionIncidence a skos:Concept,
        ue:Indicator ;
    skos:definition "An incidence indicator quantifying newly acquired infections or new infection episodes, including asymptomatic and symptomatic infections, in a population or study group during a specified period, expressed as a count, proportion, cumulative risk, or rate." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Infection incidence" ;
    skos:related indicator:VaccineImmunogenicity ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Infections .

indicator:PotentiallyInappropriateMedicationRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "PIM prevalence",
        "inappropriate prescribing rate" ;
    skos:definition "The measured proportion of patients — typically older adults — prescribed one or more medications identified as potentially inappropriate based on established criteria such as the Beers or STOPP lists." ;
    skos:example "Proportion of nursing home residents receiving at least one Beers Criteria-listed medication at admission." ;
    skos:hiddenLabel "Beers criteria rate",
        "STOPP rate" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Potentially inappropriate medication rate" ;
    skos:related indicator:MedicalOveruseRate ;
    skos:relatedMatch <http://id.nlm.nih.gov/mesh/D000067561> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:SustainedVirologicResponse a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "SVR",
        "SVR12",
        "SVR24" ;
    skos:definition "Undetectable viral load in the blood at a defined time point (typically 12 or 24 weeks) after completion of antiviral therapy, indicating successful treatment of a viral infection such as hepatitis C. A standard efficacy endpoint in antiviral clinical trials." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072230> ;
    skos:example "SVR12 used as primary efficacy endpoint in direct-acting antiviral trials for hepatitis C." ;
    skos:hiddenLabel "sustained virological response",
        "virologic cure" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Sustained virologic response" ;
    skos:related indicator:DiseasePrevalence ;
    skos:scopeNote "Primarily used as a treatment response outcome in hepatitis C and other chronic viral infection trials; distinct from general disease prevalence measures." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ViralSuppression .

indicator:VaccineImmunogenicity a skos:Concept,
        ue:Indicator ;
    skos:altLabel "seroconversion rate",
        "vaccine immune response" ;
    skos:definition "Measurable immune response elicited by a vaccine, including antibody titres, seroconversion rates, and cellular immune markers, used to assess the biological efficacy of immunization." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071497> ;
    skos:example "Geometric mean antibody titres measured 28 days after COVID-19 booster vaccination in a clinical trial." ;
    skos:hiddenLabel "immunogenicity of vaccine",
        "vaccine antibody titre" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Vaccine immunogenicity" ;
    skos:related indicator:InfectionIncidence ;
    skos:scopeNote "Distinct from vaccination coverage (uptake) and clinical protection; focuses on the biological immune response as an intermediate outcome." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:AntibodyResponse .

indicator:AlertFatigueRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "alarm override rate",
        "alert override rate" ;
    skos:definition "The proportion or frequency of clinical alerts that are overridden, missed, ignored, or receive a delayed response as an operational measure of alert fatigue." ;
    skos:example "Proportion of medication alerts overridden without clinical review in an inpatient setting." ;
    skos:hiddenLabel "alert fatigue measurement" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Alert fatigue rate" ;
    skos:related indicator:HealthcareNearMissRate,
        indicator:MedicalOveruseRate ;
    skos:relatedMatch <http://id.nlm.nih.gov/mesh/D000071064> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:AlertFatigueCondition .

indicator:DiseasePrevalence a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Chronic Disease Indicators",
        "Infectious disease control",
        "Malaria control" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000079662>,
        unbis:1000181,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#12262> ;
    skos:definition "Proportion of a population with a disease or condition at a specified time or over a specified period." ;
    skos:exactMatch <https://id.nlm.nih.gov/mesh/D015995> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Disease prevalence" ;
    skos:related indicator:GlobalDiseaseburden,
        indicator:SustainedVirologicResponse ;
    skos:relatedMatch <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#12250> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:FunctionalWalkTestOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "6-minute walk test",
        "Six-minute walk distance",
        "Timed walk test" ;
    skos:definition "Measured physical performance on a standardized walking test — such as the six-minute walk test or timed up-and-go test — used as an indicator of functional capacity, cardiorespiratory fitness, or mobility." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070857> ;
    skos:example "Measuring six-minute walk distance at baseline and three months post-intervention in patients enrolled in a pulmonary rehabilitation program." ;
    skos:hiddenLabel "6MWT",
        "six minute walk test",
        "walk test" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Walk test performance" ;
    skos:related indicator:CardiorespiratoryfFitness,
        state:CriticalCareOutcome,
        indicator:MaximalRespiratoryPressures ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:HealthcareNearMissRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Missed Diagnosis",
        "close call rate",
        "near miss incidents" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000081006> ;
    skos:definition "The measured frequency of incidents in healthcare settings that could have caused harm to patients but did not reach the patient, used as a patient safety quality indicator." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067491> ;
    skos:example "Rate of reported near-miss medication errors in hospital wards captured through voluntary incident reporting systems." ;
    skos:hiddenLabel "near-miss reporting rate" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Healthcare near-miss rate" ;
    skos:related indicator:AlertFatigueRate,
        indicator:FailureToRescueRate ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:MaximalRespiratoryPressures a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "MEP",
        "MIP",
        "PEmax",
        "PImax",
        "maximal expiratory pressure",
        "maximal inspiratory pressure" ;
    skos:definition "Measured maximal inspiratory and expiratory pressures generated against an occluded airway, used to assess respiratory muscle strength. Common functional outcome in pulmonary and neuromuscular disease studies." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072277> ;
    skos:example "MIP and MEP measured before and after inspiratory muscle training in COPD patients." ;
    skos:hiddenLabel "mouth pressure",
        "respiratory muscle strength" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Maximal respiratory pressures" ;
    skos:related indicator:CardiorespiratoryfFitness,
        indicator:FunctionalWalkTestOutcome ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:MedicalOveruseRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "low-value care rate",
        "overtreatment rate",
        "unnecessary care rate" ;
    skos:definition "Measurable proportion of patients receiving health care services — including tests, treatments, or referrals — that are not supported by clinical evidence and may cause harm." ;
    skos:example "Measuring the proportion of patients with low back pain receiving imaging within six weeks of symptom onset without red flags." ;
    skos:hiddenLabel "medical overutilization",
        "overuse of health services" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Medical overuse rate" ;
    skos:related indicator:AlertFatigueRate,
        state:HealthServiceUse,
        indicator:PotentiallyInappropriateMedicationRate ;
    skos:relatedMatch <http://id.nlm.nih.gov/mesh/D000069342> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:MedicalOveruseCondition .

indicator:CardiorespiratoryfFitness a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "CRF",
        "VO2 max",
        "aerobic fitness",
        "cardiorespiratory endurance" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000076663> ;
    skos:definition "The measurable capacity of the cardiovascular and respiratory systems to supply oxygen to skeletal muscles during sustained physical activity, typically quantified by maximal oxygen uptake (VO2 max) or submaximal exercise tests." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072599> ;
    skos:example "VO2 max measured before and after a structured exercise program in patients with cardiovascular disease." ;
    skos:hiddenLabel "aerobic capacity",
        "cardiovascular fitness",
        "maximal oxygen uptake" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Cardiorespiratory fitness" ;
    skos:related indicator:FunctionalWalkTestOutcome,
        indicator:HeartRate,
        indicator:MaximalRespiratoryPressures,
        state:PhysicalActivity ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .


indicator: a skos:ConceptScheme ;
    skos:prefLabel "Indicators"@en ;
    skos:definition "Measures used to describe conditions and outcomes."@en .
