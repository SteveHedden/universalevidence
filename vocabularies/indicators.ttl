indicator:SIDASTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of five SIDAS items after reverse scoring controllability; range 0-50, with higher values indicating greater severity of suicidal thoughts." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Suicidal Ideation Attributes Scale total score" ;
    skos:scopeNote "The original instrument uses past-month recall. The saved trial result description does not establish whether the original recall window was retained at each assessment; do not infer a trial-specific window. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[3]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SuicidalIdeation .

indicator:SIPDUDichotomousTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of 15 yes/no Short Inventory of Problems Modified for Drug Use items coded 0 or 1; range 0-15, with higher scores indicating more drug-use problems." ;
    skos:inScheme indicator: ;
    skos:prefLabel "SIP-DU 15-item dichotomous total score" ;
    skos:scopeNote "Retain this dichotomous response format; do not equate to frequency-rated variants. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[5]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:DrugUseProblems .

