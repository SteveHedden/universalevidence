    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://clinicaltrials.gov/study/NCT00659061> ;
    skos:definition "Proportion or percentage of assessed children reported by a source as falling below its stated height-for-age or length-for-age classification threshold, without asserting equivalence of underlying growth references." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Reported low height-for-age classification prevalence" ;
    skos:scopeNote "Preserve the source threshold, age range, denominator, population and timepoint. Record the growth reference when named and explicitly mark it unknown when absent. This reported classification measure does not establish WHO or SDG stunting eligibility, cross-reference comparability, clinical diagnosis or intervention effects. Counts, continuous scores and prevalence contrasts are separate statistics. Do not infer a growth reference from study date or setting." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth .

indicator:ResponseTime a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "reaction time" ;
    skos:definition "An individual's speed of cognitive or behavioral response to a stimulus, cue, or task prompt, as measured in behavioral and cognitive-science tasks." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Response time" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:CognitiveProcessesAndAbilities .

indicator:RetentionInCareRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-04"^^xsd:date ;
    skos:altLabel "care engagement rate",
        "loss-to-follow-up rate",
        "patient retention rate" ;
    skos:definition "The proportion of patients who remain continuously enrolled and actively engaged in a treatment program (e.g., HIV, TB, chronic disease management) over a specified follow-up period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Retention in care rate" ;
    skos:relatedMatch <http://id.nlm.nih.gov/mesh/D000076522> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

indicator:RoadTrafficAccidentRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Road crash rate",
        "Traffic accident incidence" ;
    skos:definition "Measured incidence, prevalence, or severity of road traffic crashes, injuries, or fatalities in a defined population or area." ;
    skos:example "Annual road traffic fatality rate per 100,000 population before and after a road safety intervention." ;
    skos:hiddenLabel "MVA rate",
        "motor vehicle accident rate" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Road traffic accident rate" ;
    skos:related state:DisasterLoss ;
    skos:relatedMatch <http://id.nlm.nih.gov/mesh/D000063> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:RoadTrafficInjury .

indicator:RoadTrafficFatalityRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Road traffic mortality rate",
        "Traffic fatality rate" ;
    skos:definition "Measured death rate or count attributable to road traffic crashes or injuries in a defined population or area." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Road traffic fatality rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:RoadTrafficInjury .

