indicator:PatientReportedOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "PROMs",
        "PROs",
        "patient-reported outcome",
        "patient-reported outcomes" ;
    skos:definition "A standardized instrument or measure through which patients directly report their health status, symptoms, functioning, quality of life, or treatment impact without clinician interpretation." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071066> ;
    skos:example "PROMIS-29 or EQ-5D scores reported directly by trial participants." ;
    skos:hiddenLabel "patient reported outcome measure",
        "patient reported outcome measures",
        "patient reported outcomes",
        "self-reported health outcome measure" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Patient-reported outcome measures" ;
    skos:scopeNote "Use for explicitly named PROM/PRO measure classes and named standardized instruments whose purpose is direct patient report. Map standalone symptoms, functioning, quality of life, satisfaction, perceived health, and other reported constructs to the state they measure. Do not use merely because an outcome concerns a patient or was obtained by questionnaire, self-report, proxy report, clinical record, or clinician assessment." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:PopulationHealthStatus .

indicator:PerceivedStressScale14TotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Total of 14 Perceived Stress Scale items rated 0-4 after reverse scoring positive items; range 0-56, with higher values indicating greater perceived stress." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Perceived Stress Scale 14-item total score" ;
    skos:scopeNote "Retain the 14-item version; do not reuse 10-item or 4-item variants. The registry does not specify a recall window. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[14]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:PerceivedStress .

