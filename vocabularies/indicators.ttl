indicator:DiagnosticAssessmentDuration a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Elapsed time required to complete the stated diagnostic assessment procedure, retaining its included steps and reported summary statistic." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic assessment duration" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticEffort .

indicator:DiagnosticClassificationAgreement a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Proportion of assessments for which index-test and reference-standard classifications agree, retaining the stated binary or multicategory classification scheme." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic classification agreement" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticAccuracy .

indicator:DiagnosticClassificationKappa a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Reported kappa agreement statistic for index-test and reference-standard classifications, retaining the stated classification scheme and weighting method; no weighting is inferred." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic classification kappa" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticAccuracy .

indicator:DiagnosticNegativePredictiveValue a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Proportion of index-test-negative assessments classified negative by the reference standard; dependent on the population and positivity threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic negative predictive value" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticAccuracy .

indicator:DiagnosticPositivePredictiveValue a skos:Concept,
        ue:Indicator ;
