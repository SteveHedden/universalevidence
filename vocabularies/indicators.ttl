    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Proportion of index-test-positive assessments classified positive by the reference standard; dependent on the population and positivity threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic positive predictive value" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticAccuracy .

indicator:DiagnosticSensitivity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Proportion of reference-standard-positive assessments classified positive by an index test at the stated positivity threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic sensitivity" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measures state:DiagnosticAccuracy .

indicator:DiagnosticSpecificity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1371/journal.pgph.0001592> ;
    skos:definition "Proportion of reference-standard-negative assessments classified negative by an index test at the stated positivity threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Diagnostic specificity" ;
    skos:scopeNote "Retain the target condition, index method, reference standard, threshold or category scheme, population and source statistic. Preserve paired/overlapping assessments. This measure is not disease prevalence or a treatment effect; external equivalence is not asserted." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
