@prefix indicator: <https://universalevidence.com/vocab/indicators/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix state: <https://universalevidence.com/vocab/states/> .
@prefix ue: <https://universalevidence.com/ontology/> .
@prefix unbis: <http://metadata.un.org/thesaurus/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

indicator:AUDITTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Total of ten AUDIT items, range 0-40; higher scores indicate more hazardous or harmful alcohol-use features." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Alcohol Use Disorders Identification Test total score" ;
    skos:scopeNote "Continuous screening score, not a prevalence estimate or confirmed alcohol use disorder diagnosis; do not turn thresholds into case counts. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[4]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:HazardousAlcoholUse .

indicator:AbnormalInvoluntaryMovementScale a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "AIMS" ;
    skos:definition "A clinician-administered rating scale used to assess the presence and severity of abnormal involuntary movements, including dyskinesias." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067399> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Abnormal involuntary movement scale" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NeurologicalDisorders .

indicator:AcademicCheatingRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "academic dishonesty rate",
        "academic fraud" ;
    skos:definition "Measured incidence or prevalence of cheating, plagiarism, or other forms of academic dishonesty among students." ;
    skos:hiddenLabel "exam cheating",
        "plagiarism rate" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Academic cheating / dishonesty" ;
    skos:scopeNote "Captures cheating as a measurable outcome variable; distinct from the condition AcademicIntegrityFailure which describes the systemic problem." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:AcademicChoiceEnrollment a skos:Concept,
        ue:Indicator ;
    skos:altLabel "course selection",
        "school choice",
        "track selection" ;
    skos:definition "Measurable decisions by students or families regarding educational pathways, subject choices, track selection, or school choice." ;
    skos:hiddenLabel "academic track",
        "educational choice",
        "subject choice" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Academic choice / track selection" ;
    skos:scopeNote "Covers choice and sorting outcomes in education; related to SchoolEnrollment but focused specifically on selection among available academic options rather than enrollment per se." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:AccidentIncidence a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Injury incidence",
        "Unintentional injury rate" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000060>,
        <http://id.nlm.nih.gov/mesh/D000061> ;
    skos:definition "Measured incidence, prevalence, or rate of unintentional accidents and resulting injuries across any setting." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000059> ;
    skos:example "Annual rate of unintentional injury hospitalizations per 100,000 population." ;
    skos:hiddenLabel "accident rate",
        "injury burden" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Accident incidence" ;
    skos:related state:CrimeAndViolence,
        state:DisasterLoss,
        state:RadiationExposure ;
    skos:scopeNote "Covers unintentional accidents broadly; more specific outcomes such as road traffic accidents or occupational accidents are narrower instances." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:InjuryIncidenceRiskAndSeverity .

indicator:AccidentalFallsIncidence a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Fall incidence",
        "Falls rate" ;
    skos:definition "Measured incidence or prevalence of unintentional falls among a population, including fall-related injuries and hospitalizations." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000058> ;
    skos:example "Number of fall-related emergency department visits per 1,000 elderly residents per year." ;
    skos:hiddenLabel "falling",
        "slip and fall" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Accidental falls incidence" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:InjuryIncidenceRiskAndSeverity .

indicator:AcutePhysiologyScoreOutcome a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "Early Warning Score" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000080162> ;
    skos:definition "Composite clinical severity score summarising physiological derangement in critically ill patients, used to predict mortality and benchmark ICU performance." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072878> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Acute physiology score" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

indicator:AgriculturalYield a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Agricultural development",
        "Agricultural land resources",
        "Agricultural water resources",
        "Food crop production",
        "Industrial crops/export crops",
        "Livestock" ;
    skos:closeMatch <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31120>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31130>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31140>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31161>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31162>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31163>,
        <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31192> ;
    skos:definition "Crop, livestock, or farm output per unit of land, labor, animal, or other production input." ;
    skos:exactMatch unbis:1000171,
        <https://metadata.un.org/sdg/2.3.1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Agricultural yield" ;
    skos:related state:AssetOwnership,
        state:FinancialInclusion,
        state:FoodSecurity,
        state:Income,
        state:LandTenureSecurity ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> ;
    ue:measures state:AgriculturalProductivity .

indicator:AirwayResistance a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:definition "Resistance to airflow in the respiratory tract, often used as a measure of pulmonary function." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000403> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Airway resistance" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:RespiratoryAndGasExchangeFindings .

indicator:AlcoholSales a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:definition "A measure of the volume or value of alcoholic beverages sold in a population or market over a specified period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Alcohol sales" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SubstanceUsePrevalence .

indicator:AngiopoietinLevel a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "Ang-1 level" ;
    skos:definition "Measured concentration of angiopoietin biomarkers in blood or other biological specimens." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Angiopoietin level" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:VascularHealth .

indicator:ApgarScore a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:definition "A newborn assessment score based on appearance, pulse, grimace, activity, and respiration shortly after birth." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001034> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Apgar score" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:InfantHealthStatus .

indicator:AppointmentNoShowRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "DNA rate",
        "missed appointment rate",
        "no-show rate" ;
    skos:definition "The measured rate at which scheduled patients fail to attend health appointments without cancellation, used as an indicator of health service utilization and engagement." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067455> ;
    skos:example "Proportion of outpatient clinic appointments missed by registered patients over a six-month period." ;
    skos:hiddenLabel "did not attend rate",
        "patient no show" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Appointment non-attendance rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

indicator:BIS11MotorScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Score for the eleven-item motor factor of BIS-11; range 11-44, with higher values indicating greater motor impulsiveness." ;
    skos:inScheme indicator: ;
    skos:prefLabel "BIS-11 motor impulsiveness score" ;
    skos:scopeNote "Source lists items 2, 3, 4, 16, 17, 19, 21, 22, 23, 25, 30. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[17]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Impulsivity .

indicator:BIS11NonPlanningScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Score for the eleven-item non-planning factor of BIS-11; range 11-44, with higher values indicating greater non-planning impulsiveness." ;
    skos:inScheme indicator: ;
    skos:prefLabel "BIS-11 non-planning impulsiveness score" ;
    skos:scopeNote "Source lists items 1, 7, 8, 10, 12, 13, 14, 15, 18, 27, 29. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[18]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Impulsivity .

indicator:BSI18ItemMeanScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Mean of 18 Brief Symptom Inventory item ratings from 0 to 4; score range 0-4, with higher values indicating greater psychological distress." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Brief Symptom Inventory 18-item mean score" ;
    skos:scopeNote "This is the reported item mean, not a summed score or a standardized T score. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[1]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:PsychologicalDistress .

indicator:BacterialLoad a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:definition "The amount or concentration of bacteria in a sample, tissue, person, or environment." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D058491> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Bacterial load" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:BacterialInfections .

indicator:Barratt30ItemTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Total score on the 30-item Barratt Impulsiveness Scale with item ratings 1-4; range 30-120, with higher scores indicating greater impulsivity." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Barratt Impulsiveness Scale 30-item total score" ;
    skos:scopeNote "The total-score record names BIS without a version; retain the supported 30-item structure without inferring an unstated version. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[15]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Impulsivity .

indicator:BarrattAttentionalEightItemScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Score for the eight-item attentional factor of the 30-item Barratt Impulsiveness Scale; range 8-32, with higher values indicating greater attentional impulsiveness." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Barratt attentional impulsiveness eight-item score" ;
    skos:scopeNote "Source lists items 6, 5, 9, 11, 20, 24, 26, 28. Do not equate a subscale with the total score. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[16]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Impulsivity .

indicator:BeckAnxietyInventoryTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of 21 Beck Anxiety Inventory items, range 0-63; higher scores indicate greater anxiety symptom severity." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Beck Anxiety Inventory total score" ;
    skos:scopeNote "A symptom score does not establish an anxiety disorder. Recall window is not specified by the saved result description. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[2]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:AnxietySymptoms .

indicator:BeckHopelessnessTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Total of 20 dichotomous Beck Hopelessness Scale items after the designated reverse scoring; range 0-20, with higher scores indicating greater hopelessness." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Beck Hopelessness Scale total score" ;
    skos:scopeNote "Preserve source scoring description; no diagnosis or suicidal behavior is inferred. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[11]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Hopelessness .

indicator:BiodiversityStatus a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Ecosystem diversity",
        "Species richness" ;
    skos:definition "Measurable indicators of the variety and abundance of species, genetic resources, and ecosystems in a defined area or globally." ;
    skos:example "Change in number of threatened species in a protected area before and after a conservation intervention." ;
    skos:hiddenLabel "biodiversity index",
        "species abundance" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Biodiversity status" ;
    skos:relatedMatch <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#41030> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Biodiversity> .

indicator:BirthWeight a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:definition "The body mass of an infant measured at birth, commonly expressed in grams or kilograms." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001724> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Birth weight" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:AnthropometricStatus .

indicator:BloodFlowVelocity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:definition "A measurement of the speed of blood flow through blood vessels or cardiac structures." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001783> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Blood flow velocity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:CardiovascularDiseases .

indicator:BloodPressureMeasurement a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "blood pressure" ;
    skos:definition "A measurement of arterial blood pressure, commonly expressed as systolic and diastolic pressure in millimeters of mercury." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001794> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Blood pressure measurement" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:CardiovascularDiseases .

indicator:BloodUreaNitrogenLevel a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "BUN",
        "blood urea nitrogen" ;
    skos:definition "A blood chemistry measurement of urea nitrogen concentration used to assess kidney function and metabolic status." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001806> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Blood urea nitrogen level" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Morbidity .

indicator:BodyBurden a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:definition "A measurement of the total amount of a chemical, pollutant, or other substance present in a person or organism." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001822> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body burden" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:RadiationExposure .

indicator:BodyCompositionMeasurement a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Anthropometry",
        "Body composition",
        "Kinanthropometry" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000067029> ;
    skos:definition "Quantitative assessment of the body's physical dimensions — including height, weight, skinfold thickness, body mass index, and body fat percentage — used to evaluate nutritional status, fitness, and health risk." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070496> ;
    skos:example "Measuring skinfold thickness and body mass index in athletes to assess body composition changes in response to a training intervention." ;
    skos:hiddenLabel "body fat measurement",
        "kinanthropometry",
        "skinfold measurement" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body composition and anthropometric measurement" ;
    skos:related state:ChildGrowth ;
    skos:scopeNote "Broader than ChildGrowth, which focuses on growth in children; this concept covers anthropometric measurement across the lifespan including in sport and adult health contexts." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:AnthropometricStatus .

indicator:BodyHeight a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "height",
        "stature" ;
    skos:definition "A measurement of standing or recumbent body length used in anthropometry and growth assessment." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001827> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body height" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth,
        state:NutritionalStatus .

indicator:BodyMassIndex a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:definition "A weight-for-height index calculated as body weight in kilograms divided by height in meters squared." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D015992> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body mass index" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NutritionalStatus .

indicator:BodySurfaceArea a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "BSA" ;
    skos:definition "An estimated or measured surface area of the human body used for dosing, physiology, and clinical assessment." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001830> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body surface area" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NutritionalStatus .

indicator:BodyTemperature a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "temperature" ;
    skos:definition "A measurement of internal or surface body temperature used to assess fever, hypothermia, or thermal status." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001831> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body temperature" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Morbidity .

indicator:BodyWeight a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:altLabel "weight" ;
    skos:definition "A measurement of body mass used in anthropometry, nutrition, dosing, and health assessment." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001835> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Body weight" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NutritionalStatus .

indicator:BoneMineralStatus a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "bone mineral content",
        "bone mineral density" ;
    skos:definition "Bone mineral content or density measured at skeletal sites or in the whole body." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Bone mineral status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Osteoporosis .

indicator:BottomFortyIncomeGrowthRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 10.1.1",
        "shared prosperity growth rate" ;
    skos:definition "Growth rate of household income or expenditure per capita among the bottom 40 percent of the population, compared with the overall population growth rate." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/10_1_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Bottom 40 income growth rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Income .

indicator:BreastDensityOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Fibroglandular tissue density",
        "Mammographic breast density" ;
    skos:definition "Measurable proportion of fibroglandular tissue relative to fatty tissue in the breast on mammographic or other imaging, used as a biomarker for breast cancer risk and a measure of radiological response to interventions." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071060> ;
    skos:example "Measuring changes in mammographic breast density after one year of hormone replacement therapy as a surrogate marker for breast cancer risk." ;
    skos:hiddenLabel "breast density measure",
        "mammographic density" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Breast density" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:BuildingEnergyRating a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "An operationalized score or certification of a building’s energy performance, based on modeled or observed energy use, efficiency, or emissions." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Building energy rating" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measures state:InfrastructureConditions .

indicator:CD4CD8Ratio a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:definition "Ratio of CD4-positive to CD8-positive T lymphocytes used as an immune status marker." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D016516> ;
    skos:inScheme indicator: ;
    skos:prefLabel "CD4-CD8 ratio" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
