        ue:Indicator ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "ORAC" ;
    skos:definition "A laboratory measure of the antioxidant capacity of foods, beverages, or biological samples, quantifying the ability to neutralize free radicals. Used as a biomarker of dietary antioxidant intake and oxidative stress." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072257> ;
    skos:example "ORAC values measured in plasma before and after a polyphenol-rich dietary intervention." ;
    skos:hiddenLabel "antioxidant capacity",
        "free radical scavenging capacity" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Oxygen radical absorbance capacity" ;
    skos:related state:DietaryDiversity ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:ParentalSexualOrientationRejectionMeanRating a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Mean of maternal and paternal attitude ratings toward the respondent's sexual orientation, from 1 for accepting to 7 for hostile or rejecting." ;
    skos:inScheme indicator: ;
