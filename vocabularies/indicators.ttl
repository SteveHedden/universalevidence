    ue:measures state:EcosystemServices .

indicator:ElectroencephalographyMeasure a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:altLabel "EEG" ;
    skos:definition "A measurement of brain electrical activity captured with electroencephalography and used to assess cognitive, neurological, emotional, or behavioral states." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Electroencephalography measure" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
