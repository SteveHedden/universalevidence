    skos:inScheme indicator: ;
    skos:prefLabel "Self-reported nonsuicidal self-injury frequency" ;
    skos:scopeNote "The registry reports the mean frequency in self-harm behaviors. Past-three-month/past-week recall assignment is unspecified; do not infer a common duration. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[8]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NonsuicidalSelfInjury .

indicator:SelfReportedSuicidalConsiderationCount a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Number of respondents answering yes to seriously considering attempting suicide during a specified recall period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Self-reported suicidal consideration count" ;
    skos:scopeNote "Participants, not attempts or deaths. The source combines past-three-month and past-week wording without assigning it to classes; retain that recall ambiguity and do not pool windows. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[6]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SuicidalIdeation .

indicator:SelfReportedSuicideAttemptParticipantCount a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Number of respondents reporting an actual suicide attempt during a specified recall period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Self-reported suicide attempt participant count" ;
    skos:scopeNote "Counts people, not number of attempts. Source past-three-month/past-week wording is not assigned to individual assessment classes. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[7]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SuicideAttemptBehavior .

indicator:SerumLipaseLevel a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "lipase level" ;
    skos:definition "The concentration or activity of lipase measured in serum as a clinical laboratory marker." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Serum lipase level" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Pancreatitis .

indicator:SevereChildUnderweightPrevalence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://www.ncbi.nlm.nih.gov/books/NBK487900/table/fm.s1.t1/> ;
    skos:definition "Proportion or percentage of assessed children with weight-for-age z-score below -3." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Severe child underweight prevalence" ;
    skos:scopeNote "Record age range, growth reference, denominator, timepoint and effect unit on the finding. A prevalence difference is not a relative percentage change." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SevereChildUnderweight .

indicator:SevereStuntingCumulativeIncidence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC3721756/> ;
    skos:definition "Proportion of children initially free of severe stunting who newly develop height- or length-for-age below -3 standard deviations during a specified follow-up interval, using the CDC 2000 growth reference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Severe stunting cumulative incidence (CDC 2000)" ;
    skos:scopeNote "CDC 2000 reference only; specify baseline exclusions, interval, censoring and estimation method. Do not substitute severe stunting point prevalence." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SevereStuntingCDC2000 .

indicator:SevereStuntingPrevalence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://www.ncbi.nlm.nih.gov/books/NBK487900/table/fm.s1.t1/> ;
    skos:definition "Proportion or percentage of assessed children with height-for-age or length-for-age z-score below -3." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Severe stunting prevalence" ;
    skos:scopeNote "Record age range, growth reference, denominator, timepoint and effect unit on the finding. A prevalence difference is not a relative percentage change." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SevereStunting .

indicator:SinoNasalOutcomeTest a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SNOT" ;
    skos:definition "A patient-reported outcome instrument used to measure sinonasal symptoms and quality-of-life burden." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000079602> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Sino-Nasal Outcome Test" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Morbidity .

indicator:SlumInformalHousingRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 11.1.1",
        "slum population share" ;
    skos:definition "Proportion of the urban population living in slums, informal settlements, or inadequate housing." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/11_1_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Slum and informal housing rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measures state:Housing .

indicator:SpousalTravelTime a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "Time spent walking or traveling by a spouse, often used to capture household mobility or time-use constraints." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Spousal travel time" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:TimeUse .

indicator:StuntedChildCount a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:source <https://clinicaltrials.gov/api/v2/studies/NCT02944682> ;
    skos:definition "Number of assessed children classified as stunted according to a specified height-for-age or length-for-age growth reference and threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Stunted child count" ;
    skos:scopeNote "Retain the case definition, growth reference, age range, assessment time and group denominator on each source finding. A case count is not a prevalence proportion, incidence rate, z-score or treatment effect; comparisons of counts with unequal denominators do not establish prevalence differences." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Stunting .

indicator:StuntingCumulativeIncidence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC3721756/> ;
    skos:definition "Proportion of children initially free of stunting who newly develop height- or length-for-age below -2 standard deviations during a specified follow-up interval, using the CDC 2000 growth reference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Stunting cumulative incidence (CDC 2000)" ;
    skos:scopeNote "CDC 2000 reference only; specify baseline exclusions, interval, censoring and estimation method. This is incident disease risk, not point prevalence." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:StuntingCDC2000 .

indicator:StuntingPrevalence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:source <https://osf.io/download/uk9xz/> ;
    skos:definition "Proportion of a defined population classified as stunted using a stated height-for-age or length-for-age growth reference and threshold." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Stunting prevalence" ;
    skos:scopeNote "Retain the exact age range, growth reference, threshold, population, assessment time and denominator. This generic prevalence metric does not assert WHO under-five SDG eligibility. Ratios or differences comparing prevalence remain comparison statistics, not prevalence levels. Continuous height-for-age scores and counts are distinct metrics." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Stunting .

indicator:SubmeteringCoverage a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The proportion or extent of households, tenants, devices, or building units equipped with submeters that separately measure utility consumption." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Submetering coverage" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measures state:InfrastructureConditions .

indicator:SustainableConsumptionProductionPolicyAdoptionRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SCP policy adoption rate" ;
    skos:definition "Number or proportion of countries developing, adopting, or implementing policy instruments that support the shift to sustainable consumption and production." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/12_1_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Sustainable consumption and production policy adoption rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
    ue:measures state:SustainableConsumptionProduction .

indicator:TalkingTime a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-22"^^xsd:date ;
    skos:definition "The amount or share of time spent speaking during an interaction, discussion, meeting, classroom, or communication setting. It can reflect participation, dominance, engagement, or communication opportunities." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Talking time" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:GroupBehavior .

indicator:TobaccoUsePrevalence a skos:Concept,
        ue:Indicator ;
    skos:altLabel "smoking prevalence",
        "smoking rate" ;
    skos:definition "Measured proportion of a population currently using tobacco products, including cigarettes, cigars, and smokeless tobacco." ;
    skos:example "Percentage of adults who smoke measured before and after a tobacco control campaign." ;
    skos:hiddenLabel "cigarette prevalence" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Tobacco use prevalence" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:TobaccoUse .

indicator:TreatmentAdherenceRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-04"^^xsd:date ;
    skos:altLabel "compliance rate",
        "medication adherence rate",
        "patient adherence" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000074822>,
        <http://id.nlm.nih.gov/mesh/D000099059> ;
    skos:definition "The proportion of patients who correctly follow prescribed treatment regimens — including medication dosing schedules and clinical follow-up — over a defined observation period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Treatment adherence rate" ;
    skos:related state:TreatmentNonAdherence ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:TreatmentAdherence .

indicator:TwoWeekDiarrhoeaPrevalence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC10750001/> ;
    skos:definition "Proportion or percentage of a specified population reported to have had diarrhoea during the preceding two weeks." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Two-week diarrhoea prevalence" ;
    skos:scopeNote "Retain respondent, case definition and denominator on the finding. This recall-period prevalence is not an incidence rate or an episode count." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:DiarrhoealDisease .

indicator:UnemploymentDuration a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The elapsed time from the start of an unemployment episode until reemployment, labor-force exit, or the observation date." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Unemployment duration" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Unemployment .

