indicator:EqualOpportunityMonitoring a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:definition "The presence, scope, or coverage of formal mechanisms that monitor access, treatment, or outcomes across groups to detect unequal opportunity or discrimination." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Equal opportunity monitoring" ;
    skos:related state:DiscriminationHarassmentExperienceRate,
        state:DiversityInclusion ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SocialInequality .

indicator:ExclusiveBreastfeedingDuration a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC8189218/> ;
    skos:definition "Elapsed time from birth until an infant ceases exclusive breastfeeding." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Exclusive breastfeeding duration" ;
    skos:scopeNote "State time unit, event definition, follow-up restriction and aggregation. Restricted mean survival time and between-group differences retain their horizon and analysis on the measurement." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:BreastfeedingPractices .

indicator:ExclusiveBreastfeedingProportion a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC8189218/> ;
    skos:definition "Proportion of infants exclusively receiving breast milk, apart from medicines, vitamins or minerals, over a specified age range or observation window." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Exclusive breastfeeding proportion" ;
    skos:scopeNote "Record age, recall period and whether the measure is current feeding status or sustained exclusivity since birth. Do not equate different recall windows." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:BreastfeedingPractices .

indicator:FetalWeight a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <https://www.isuog.org/resource/isuog-practice-guidelines-ultrasound-assessment-of-fetal-biometry-and-growth-pdf.html> ;
    skos:altLabel "Estimated fetal weight" ;
    skos:definition "The mass of a fetus in utero, usually estimated from prenatal ultrasound biometric measurements." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020567> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Fetal weight" ;
    skos:related state:FetalGrowthRestriction,
        state:FetalMacrosomia ;
    skos:scopeNote "Used in assessing restricted or excessive fetal growth with gestational age, reference distributions and other clinical findings. The measures links indicate applicability to these conditions, not that a weight measurement alone diagnoses either or that both conditions coexist." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:FetalGrowthRestriction,
        state:FetalMacrosomia .

indicator:FinancialSoundnessIndicators a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "FSIs",
        "SDG 10.5.1" ;
    skos:definition "Composite or component indicators used to monitor the stability and soundness of financial institutions and markets." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/10_5_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Financial soundness indicators" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/FinancialSystem> ;
    ue:measures state:FinancialSystemStability .

indicator:FiscalRedistributionGiniImpact a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 10.4.2" ;
    skos:definition "Change in the Gini index attributable to fiscal policy, reflecting the redistributive effect of taxes and transfers." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/10_4_2> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Fiscal redistribution impact on Gini index" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:IncomeInequality .

indicator:FoodSafetyStatus a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Dietary Exposure",
        "Food contamination levels",
        "Foodborne illness incidence" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000074341> ;
    skos:definition "Measurable indicators of the safety and quality of food consumed by households, including rates of contamination, foodborne illness incidence, and compliance with food safety standards." ;
    skos:example "Reduction in aflatoxin concentration in maize samples before and after food safety intervention." ;
    skos:hiddenLabel "aflatoxin levels",
        "food quality outcome" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Food safety status" ;
    skos:related state:DiarrhoealDisease,
        state:Morbidity ;
    skos:relatedMatch <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#43073> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

indicator:GRRSGenderInclusive12ItemScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Score on the gender-inclusive 12-item adaptation of the Gay-Related Rejection Sensitivity Scale described with range 1-36; higher scores indicate greater sexual-orientation-related rejection sensitivity." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Gender-inclusive 12-item gay-related rejection sensitivity score" ;
    skos:scopeNote "Registry-supported adapted format; item wording and calculation are not fully specified, so no identity with other versions or executable scoring algorithm is asserted. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[20]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SexualOrientationRejectionSensitivity .

indicator:GeneticRiskScore a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "genomic risk score",
        "polygenic risk score" ;
    skos:definition "A quantitative score summarizing inherited genetic variants associated with risk for a disease or health condition." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000096442> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Genetic risk score" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:GeneticPredispositionToDisease .

indicator:GlycemicControl a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "HbA1c control" ;
    skos:definition "Measures of blood glucose control, such as HbA1c or fasting glucose, used to assess diabetes and metabolic disease management." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000085002> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Glycemic control" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:NonCommunicableDiseases .

indicator:GlycemicLoad a skos:Concept,
        ue:Indicator ;
    skos:altLabel "GL",
        "dietary glycemic load" ;
    skos:definition "A dietary quality measure that quantifies the overall impact of carbohydrate consumption on blood glucose levels, combining both the glycemic index and the quantity of carbohydrates consumed." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067940> ;
    skos:example "Mean dietary glycemic load calculated from 24-hour dietary recall data in a cohort study of type-2 diabetes risk." ;
    skos:hiddenLabel "glycaemic load",
        "glycemic index load" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Glycemic load" ;
    skos:related state:NutritionalStatus ;
    skos:scopeNote "Glycemic load is a dietary exposure/outcome measure used in nutrition studies; distinct from clinical blood glucose measures which fall under NonCommunicableDiseases." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

indicator:HIVInfectionIncidence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "HIV acquisition",
        "new HIV infection rate" ;
    skos:definition "An incidence measure of new HIV infections occurring in a population or study group over a specified period, expressed as a count, proportion, rate, cumulative risk, or time to acquisition." ;
    skos:inScheme indicator: ;
    skos:prefLabel "HIV infection incidence" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:HIVAIDS .

indicator:HealthEquityOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Health disparities reduction",
        "Health inequality gap",
        "Universal Health Care" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000069576> ;
    skos:definition "Measurable reduction in systematic differences in health status, health service access, or health outcomes across socially defined population groups, including by income, ethnicity, geography, or gender." ;
    skos:example "Tracking changes in the gap in vaccination coverage between rural and urban children following an equity-focused immunization campaign." ;
    skos:hiddenLabel "equitable health outcomes",
        "health equity measure" ;
    skos:inScheme indicator: ;
    skos:prefLabel "Health equity" ;
    skos:related state:IncomeInequality,
        state:WomensEconomicParticipation ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

indicator:HealthyLifeExpectancy a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "HALE" ;
    skos:definition "Expected years of life lived in good health, combining mortality and morbidity into a population health summary measure." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000087508> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Healthy life expectancy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Morbidity .

indicator:HeightAboveMinusTwoSDSProportion a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-08"^^xsd:date ;
    dcterms:source <https://doi.org/10.1159/000530572> ;
    skos:definition "Proportion of assessed people whose height standard deviation score is strictly greater than minus two relative to a specified sex-specific and age-specific growth reference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Proportion with height SDS above minus two" ;
    skos:scopeNote "Retain the reference population, reference age (chronological or adult), assessment time, numerator and denominator. This is a threshold attainment proportion, not a continuous height score or WHO under-five stunting prevalence. Do not assume an upper normality limit or invert the threshold into a differently defined stunting indicator." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth .

indicator:HeightForAgeZScore a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://www.who.int/tools/child-growth-standards/standards/length-height-for-age> ;
    skos:definition "Age- and sex-standardized height or recumbent length expressed in standard deviation units relative to a specified child growth reference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Height-for-age z-score" ;
    skos:scopeNote "Continuous HAZ/LAZ; state the reference (for example WHO or NCHS), population and aggregation on the finding. A z-score mean or change does not measure stunting prevalence." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth,
        state:Stunting .

indicator:HemoglobinConcentration a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "haemoglobin concentration",
        "hemoglobin" ;
    skos:definition "The concentration of hemoglobin in blood, commonly used to assess anemia and related nutritional or health status." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Hemoglobin concentration" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Anaemia .

indicator:HeritageConservationExpenditure a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 11.4.1" ;
    skos:definition "Total per capita expenditure on preservation, protection, and conservation of cultural and natural heritage." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/11_4_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Heritage conservation expenditure" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Climate> ;
    ue:measures state:HeritageSiteDegradation .

indicator:IatTest a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "IAT" ;
    skos:definition "A reaction-time measure of the strength of automatic associations between social categories and attributes." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Implicit association test" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Bias .

indicator:IfoBusinessClimate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The Ifo Institute's monthly survey-based index of German firms' assessment of current business conditions and near-term expectations." ;
    skos:inScheme indicator: ;
    skos:prefLabel "IFO business climate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:FirmExpectations .

indicator:InfectiousIllnessIncidence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "infectious disease incidence" ;
    skos:definition "An incidence indicator quantifying new episodes of clinically manifest infectious disease in a population over a specified period." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Infectious illness incidence" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:CommunicableDiseases .

indicator:InternalizedHomophobiaNineItemMeanScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Mean of nine Internalized Homophobia Scale items in the reported 1-4 response format; higher scores indicate greater internalized sexual-orientation stigma." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Internalized Homophobia Scale nine-item mean score" ;
    skos:scopeNote "Retain mean rather than sum and the stated 1-4 format; no equivalence to other item counts or response formats. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[23]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:SelfStigma .

indicator:KneeHeelLength a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://doi.org/10.1371/journal.pmed.1004227> ;
    skos:definition "Linear distance between the knee at the lateral femoral condyle and the heel at the calcaneus, measured by a knee-heel caliper as a measure of lower-leg length." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Knee-heel length" ;
    skos:scopeNote "Retain measurement method, units, side, participant age, and timing. Absolute levels and changes are distinct from whole-body height and height-for-age standardized scores; this metric alone does not classify stunting." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildGrowth .

indicator:LGBIdentityCentralityFourItemScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of four LGB Identity Centrality items rated 1-7; range 4-28, with higher scores indicating greater centrality of lesbian, gay, or bisexual identity." ;
    skos:inScheme indicator: ;
    skos:prefLabel "LGB identity centrality four-item score" ;
    skos:scopeNote "Measures centrality of identity, not pathology, disclosure, or acceptance by others. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[12]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:GroupIdentity .

indicator:LGBTVictimizationTenItemTotalScore a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of ten LGBT Victimization Experiences items coded 0 for never through 3 for three or more times; range 0-30, with higher scores indicating more victimization associated with being known or perceived as LGBTQ." ;
    skos:inScheme indicator: ;
    skos:prefLabel "LGBT victimization experiences ten-item total score" ;
    skos:scopeNote "Summed ordinal frequency categories are not a literal incident count or prevalence. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[27]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:LgbtqDiscrimination .

indicator:LaborForceParticipation a skos:Concept,
        ue:Indicator ;
    skos:definition "Participation in the labor market — working or actively seeking work — at the individual or household level." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Labor force participation" ;
    skos:related state:Employment ;
    skos:relatedMatch <https://metadata.un.org/sdg/8.5.2> ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measures state:LaborForceandEmployment .

indicator:LaborSupplyElasticity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The percentage change in labor supplied associated with a one-percent change in wages, taxes, benefits, or another economic incentive." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Labor supply elasticity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measures state:LaborSupply .

indicator:LabourShareOfGDP a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 10.4.1",
        "labor share of GDP" ;
    skos:definition "The share of gross domestic product paid to labor through wages, salaries, and social protection transfers." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/10_4_1> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Labour share of GDP" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measures state:Income .

