    skos:definition "Direct economic loss attributed to disasters in relation to gross domestic product." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/11_5_2>,
        <https://unstats.un.org/sdgs/indicator/1_5_2> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Disaster economic loss as GDP share" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measures state:DisasterLoss .

indicator:DisasterInfrastructureServiceDisruption a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "SDG 11.5.3" ;
    skos:definition "Damage to critical infrastructure and disruptions to basic services attributed to disasters." ;
    skos:exactMatch <https://unstats.un.org/sdgs/indicator/11_5_3> ;
    skos:inScheme indicator: ;
    skos:prefLabel "Disaster infrastructure and service disruption" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measures state:DisasterLoss .

indicator:DrugAbsorptionRate a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "absorption rate constant",
        "ka" ;
    skos:definition "The rate at which a drug is absorbed into systemic circulation, often estimated as a pharmacokinetic parameter." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Drug absorption rate" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:DrugPharmacokineticProfile .

indicator:EDSOLifeHardshipRating a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "EDSO Part 2 item 2 rating, from 0 to 3, of how much harder life has been because of sexual-orientation discrimination; higher scores indicate greater hardship." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Sexual orientation discrimination life-hardship rating" ;
    skos:scopeNote "Single item, distinct from life interference and the nine-item sum. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[26]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:LgbtqDiscrimination .

indicator:EDSOLifeInterferenceRating a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "EDSO Part 2 item 1 rating, from 0 to 3, of how much sexual-orientation discrimination interferes with a full and productive life; higher scores indicate greater interference." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Sexual orientation discrimination life-interference rating" ;
    skos:scopeNote "Single item, distinct from the life-hardship item and the nine-item sum. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[25]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:LgbtqDiscrimination .

indicator:EDSOSexualOrientationNineItemSum a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Sum of nine Everyday Discrimination Sexual Orientation Part 1 ratings from 1 to 6; range 9-54, with higher scores indicating greater perceived discrimination." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Everyday sexual orientation discrimination nine-item sum" ;
    skos:scopeNote "Not a prevalence estimate, SDG population percentage, or the Part 2 global items. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[24]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:LgbtqDiscrimination .

indicator:ESGRatings a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "environmental social and governance ratings" ;
    skos:definition "Assessments or scores of environmental, social, and governance performance." ;
    skos:inScheme indicator: ;
    skos:prefLabel "ESG ratings" ;
    skos:related state:ESGDisclosure ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> ;
    ue:measures state:CorporateSustainability .

indicator:EarlyChildhoodEnvironmentRatingScale a skos:Concept,
        ue:Indicator ;
