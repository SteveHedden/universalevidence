indicator:ChildMinimumAcceptableDietFourOfSeven a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC5941766/> ;
    skos:definition "Proportion of children aged 6-23 months meeting both minimum meal frequency and the four-of-seven-food-group minimum dietary diversity criterion in a 24-hour recall." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Child minimum acceptable diet, four-of-seven diversity" ;
    skos:scopeNote "Retain age, breastfeeding status, milk-feed eligibility and study operationalization. This legacy composite is not interchangeable with revised five-of-eight diversity criteria." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:FeedingPractices .

indicator:ChildMinimumDietaryDiversityFourOfSeven a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC5941766/> ;
    skos:definition "Proportion of children aged 6-23 months consuming foods from at least four of seven food groups in the preceding 24 hours." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Child minimum dietary diversity, four of seven groups" ;
    skos:scopeNote "Legacy seven-group definition: grains/roots/tubers; legumes/nuts; dairy; flesh foods; eggs; vitamin-A-rich fruits/vegetables; other fruits/vegetables. Not the later five-of-eight definition. Retain breastfeeding and sample restrictions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:DietaryDiversity .

indicator:ChildMinimumMealFrequency a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC5941766/> ;
    skos:definition "Proportion of children aged 6-23 months meeting the age- and breastfeeding-specific minimum number of daily solid or semi-solid feeds in a 24-hour recall." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Child minimum meal frequency" ;
    skos:scopeNote "Thresholds: two feeds for breastfed ages 6-8 months, three for breastfed ages 9-23 months, four for non-breastfed ages 6-23 months. Preserve exact study feeding definitions and exclusions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:FeedingPractices .

indicator:ChildUnderweightPrevalence a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:source <https://www.ncbi.nlm.nih.gov/books/NBK487900/table/fm.s1.t1/> ;
    skos:definition "Proportion or percentage of assessed children with weight-for-age z-score below -2." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Child underweight prevalence" ;
    skos:scopeNote "Record age range, growth reference, denominator, timepoint and effect unit on the finding. A prevalence difference is not a relative percentage change." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ChildUnderweight .

indicator:ChoiceSetSize a skos:Concept,
