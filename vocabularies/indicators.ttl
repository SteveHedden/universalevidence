indicator:EngelCoefficient a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:definition "The share of household expenditure spent on food, used as an indicator of household welfare or living standards." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Engel coefficient" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
