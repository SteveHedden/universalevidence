indicator:ColumbiaCardTaskCardsTurned a skos:Concept,
        ue:Indicator ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03751020> ;
    skos:definition "Number of cards turned during a Columbia Card Task trial before stopping or encountering a loss card; more cards turned indicate greater risk taking within a specified task configuration." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Columbia Card Task cards turned" ;
    skos:scopeNote "Task payoff/loss probabilities must remain contextual. The assigned study never collected this outcome and specifies no aggregation statistic; this is a planned metric identity only. Source evidence: resultsSection.outcomeMeasuresModule.outcomeMeasures[19]. Taxonomy identity does not imply supported statistical interpretation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:RiskTakingBehavior .

