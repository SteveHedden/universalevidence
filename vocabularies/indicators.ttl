    skos:altLabel "EGRA" ;
    skos:definition "A standardized assessment of foundational reading skills among children in the early grades." ;
    skos:inScheme indicator: ;
    skos:prefLabel "Early grade reading assessment" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:Literacy .

indicator:EcoScore a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:definition "A score or label summarizing the environmental performance or footprint of a product, service, or behavior." ;
    skos:inScheme indicator: ;
    skos:prefLabel "EcoScore" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
