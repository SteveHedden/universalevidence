    skos:inScheme state: ;
    skos:prefLabel "Cultured meat acceptance" ;
    skos:scopeNote "Use specifically for acceptance of cultured or cultivated meat. Use MeatSubstitution for switching to plant-based or other alternative proteins, ConsumerChoice for observed product selection, and ConsumerWillingnessToPay for monetary valuation." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

