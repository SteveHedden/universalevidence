<https://universalevidence.com/vocab/states/Bursitis>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002062> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/SoftTissueDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Inflammation or irritation of a SYNOVIAL BURSA, the fibrous sac that acts as a cushion between moving structures of bones, muscles, tendons or skin." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002062> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Bursitis" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:BuschkeLowensteinTumor a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:CarcinomaVerrucous ;
    skos:related state:CondylomataAcuminata ;
    skos:definition "A giant condylomatous tumor associated with human papillomavirus infection and locally aggressive anogenital growth." ;
