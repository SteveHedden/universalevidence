<https://universalevidence.com/vocab/states/SubstanceUsePrevalence>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Substance use behavior" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Substance use prevalence" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Substance use" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "alcohol use rate" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "drug use prevalence" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HealthBehavior> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Patterns and extent of alcohol, illicit-drug, or other psychoactive-substance use among individuals or populations, including whether, how often, and how much substances are used." ;
    <http://www.w3.org/2004/02/skos/core#example> "Population prevalence, frequency, or quantity of alcohol or illicit-drug use changing over time." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "alcohol abuse prevalence" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "drug abuse rate" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Substance use patterns" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/AdolescentHealth> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/SubstanceUseDisorder> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for observed consumption, frequency, quantity, or prevalence without inferring a clinical disorder. Use SubstanceUseDisorder when diagnosis, dependence, impaired control, clinically significant harm or impairment, or explicit abuse, misuse, or disorder terminology is present. Exclude attitudes, intentions, motivation, psychological flexibility, communication, treatment or care uptake, medication utilization, screening, drug resistance, and substance-policy measures." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/SDG352AlcoholPerCapitaConsumption> .

