    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007414> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal neoplasms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalObstruction a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "Bowel obstruction" ;
    skos:broader state:ColorectalAndIntestinalDiseases ;
    skos:definition "Partial or complete interference with the passage of intestinal contents through the bowel, caused by mechanical blockage or absent intestinal motility." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007415> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal obstruction" ;
    skos:scopeNote "Umbrella concept for bowel obstruction and its named anatomic, mechanical, congenital, and motility-related forms. Excludes intestinal failure without evidence of obstruction and nonspecific intestinal symptoms or measurements." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalPerforation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:broader state:GastrointestinalDiseases ;
    skos:definition "A health condition or disease state corresponding to the MeSH descriptor \"Intestinal Perforation\"." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007416> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal perforation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalPolyposis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
