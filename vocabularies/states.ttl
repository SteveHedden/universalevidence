    skos:prefLabel "Dihydropyrimidine dehydrogenase deficiency" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/DilatedCardiomyopathy>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002311> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Cardiomyopathy, Dilated" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Cardiomyopathies> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A form of CARDIAC MUSCLE disease that is characterized by ventricular dilation, VENTRICULAR DYSFUNCTION, and HEART FAILURE. Risk factors include SMOKING; ALCOHOL DRINKING; HYPERTENSION; INFECTION; PREGNANCY; and mutations in the LMNA gene encoding LAMIN TYPE A, a NUCLEAR LAMINA protein." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002311> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Dilated cardiomyopathy" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:DipetalonemaInfections a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:broader state:Filariasis ;
    skos:definition "Filarial infections caused by nematodes classified in the genus Dipetalonema." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D004154> ;
    skos:inScheme state: ;
    skos:prefLabel "Dipetalonema infections" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Diphtheria>
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D004165> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CorynebacteriumInfections> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A localized infection of mucous membranes or skin caused by toxigenic strains of CORYNEBACTERIUM DIPHTHERIAE. It is characterized by the presence of a pseudomembrane at the site of infection. DIPHTHERIA TOXIN, produced by C. diphtheriae, can cause myocarditis, polyneuritis, and other systemic toxic effects." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D004165> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Diphtheria" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Diphyllobothriasis>
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D004169> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CestodeInfections> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Infection with tapeworms of the genus Diphyllobothrium." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D004169> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Diphyllobothriasis" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Diplopia>
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D004172> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/OcularMotilityDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A visual symptom in which a single object is perceived by the visual cortex as two objects rather than one. Disorders associated with this condition include REFRACTIVE ERRORS; STRABISMUS; OCULOMOTOR NERVE DISEASES; TROCHLEAR NERVE DISEASES; ABDUCENS NERVE DISEASES; and diseases of the BRAIN STEM and OCCIPITAL LOBE." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D004172> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Diplopia" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:DirectAndIndirectCosts a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:broader state:EconomicStatus ;
    skos:definition "The monetary and nonmonetary economic burden borne by people, households, or populations, including direct payments and other financial costs and indirect losses of time, income, productivity, benefits, or foregone alternatives associated with choices, programs, illness, or services." ;
    skos:inScheme state: ;
    skos:altLabel "Direct and indirect costs" ;
    skos:prefLabel "Direct and indirect cost burden" ;
    skos:scopeNote "Use for realized or estimated monetary and nonmonetary cost burdens. Use CostPerceptions for beliefs about cost, DecisionCosts for burdens of making a choice, CostEffectiveness for cost-to-outcome relationships, and HealthCareCosts when the represented construct is specifically health-care spending or treatment cost." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:DirectReciprocity a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:broader state:SocialNorms ;
    skos:definition "Reciprocal behavior in which one actor responds to another actor’s prior action with reward, cooperation, or punishment." ;
    skos:inScheme state: ;
    skos:prefLabel "Direct reciprocity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Dirofilariasis>
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D004184> ;
