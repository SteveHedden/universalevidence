state:ProfessionalLearningCommunities a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:OrganizationalLearning ;
    skos:definition "The established presence and functioning of ongoing professional communities whose members routinely exchange practice knowledge and feedback, reflect on evidence, and develop shared norms." ;
    skos:scopeNote "Use for the standing organizational-learning arrangement or its functioning. Use ProfessionalLearningIntervention for a deliberate program that creates, facilitates, or strengthens such a community; do not use this state to type the practitioner group itself." ;
