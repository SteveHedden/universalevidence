<https://universalevidence.com/vocab/states/Kernicterus>
    <http://purl.org/dc/terms/bibliographicCitation> "Menkes, Textbook of Child Neurology, 5th ed, p613" ;
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D007647> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/MetabolicBrainDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Neurological injury caused by bilirubin toxicity in the brain, most commonly occurring in newborns." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D007647> ;
