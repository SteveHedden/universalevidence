    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D016117> ;
    skos:broader state:Albinism ;
    skos:definition "Albinism affecting the eye in which pigment of the hair and skin is normal or only slightly diluted. The classic type is X-linked (Nettleship-Falls), but an autosomal recessive form also exists. Ocular abnormalities may include reduced pigmentation of the iris, nystagmus, photophobia, strabismus, and decreased visual acuity." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D016117> ;
    skos:hiddenLabel "D016117" ;
    skos:inScheme state: ;
    skos:prefLabel "Albinism, ocular" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

