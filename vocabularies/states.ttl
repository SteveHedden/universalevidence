    skos:broader state:LaborMarketInequality ;
    skos:definition "Unequal treatment or labor-market outcomes in hiring, pay, promotion, retention, or working conditions based on identity or status rather than relevant qualifications or productivity." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market discrimination" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketExpectations a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:EconomicExpectations ;
    skos:definition "Beliefs held by workers, employers, or households about future employment, wages, vacancies, and labor-market conditions." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market expectations" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborMarketFrictions a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "Costs, barriers, and delays that impede efficient matching between workers and jobs or adjustment in employment and wages." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market frictions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketInequality a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketOutcomes ;
    skos:definition "Unequal access to employment, earnings, job quality, or advancement across people and groups." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market inequality" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketIntermediation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:JobSearchMatchingAndEntry ;
    skos:definition "The availability and effectiveness of institutions and services that connect job seekers with employers and vacancies." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market intermediation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketNeeds a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The quantity and types of workers, skills, and occupations required by employers in a labor market." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market needs" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketOrientation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:JobSearchMatchingAndEntry ;
    skos:definition "The extent to which individuals have the knowledge, expectations, and readiness needed to navigate employment opportunities and career pathways." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market orientation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborMarketPolicies a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketPolicyRegulationAndInstitutions ;
    skos:definition "The content, coverage, and implementation of public policies governing employment, wages, worker protection, and labor-market participation." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market policies" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measuredBy state:SDG8B1YouthEmploymentStrategyAdoption ;
    skos:closeMatch <https://unstats.un.org/sdgs/target/8_b> .

state:LaborMarketPolicySupport a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:EconomicPolicyPreferences ;
    skos:definition "The level of public, worker, or employer support for particular labor-market policies and regulations." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market policy support" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborMarketProspect a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "labor market prospects" ;
    skos:broader state:LaborMarketExpectations ;
    skos:definition "Individuals’ beliefs about their own or others’ future opportunities for employment, earnings, job finding, promotion, and career advancement." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market prospect" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborMarketRegulation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketPolicyRegulationAndInstitutions ;
    skos:definition "The scope, strength, and enforcement of rules governing employment contracts, wages, dismissal, working conditions, and collective relations." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market regulation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketSignaling a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:JobSearchMatchingAndEntry ;
    skos:definition "The extent to which workers and employers use credentials, experience, or other observable cues to infer otherwise uncertain qualities in labor-market matching." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market signaling" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMarketSorting a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The pattern by which workers and firms match across jobs, occupations, industries, or locations according to skills, preferences, and constraints." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market sorting" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMigrationPolicy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketPolicies ;
    skos:definition "The content, coverage, and implementation of rules governing migrant workers' admission, employment rights, mobility, and protection." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor migration policy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborMobility a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The ability and realized movement of workers across jobs, occupations, employers, industries, or locations." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor mobility" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborOutcomes a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "Employment-related outcomes experienced by workers, including job attainment, earnings, hours, tenure, and working conditions." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor outcomes" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborPain a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
