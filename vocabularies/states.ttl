<https://universalevidence.com/vocab/states/BiosphereDegradation>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Ecosystem degradation" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Habitat loss" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Natural Resources" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/BiodiversitySystemConditions> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D000067936> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The persistent deterioration of biosphere integrity — including ecosystem function, natural habitats, and the life-support systems of the planet — due to pollution, land-use change, and unsustainable resource extraction." ;
    <http://www.w3.org/2004/02/skos/core#example> "Deforestation-driven loss of forest ecosystem services in the Amazon basin." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "biosphere destruction" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "ecosystem collapse" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Biosphere degradation" ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#41020> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Focuses on the systemic degradation of natural systems rather than on specific species loss (see biodiversity) or site-level damage." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Biodiversity> .

<https://universalevidence.com/vocab/states/BiotinidaseDeficiency>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
