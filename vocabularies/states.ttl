    skos:altLabel "Plaque, atherosclerotic" ;
    skos:broader state:Atherosclerosis ;
    skos:definition "A focal buildup of lipids, inflammatory cells, fibrous tissue, and calcium within an arterial wall. These plaques narrow or destabilize arteries and can contribute to ischemic cardiovascular events." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D058226> ;
    skos:inScheme state: ;
    skos:prefLabel "Atherosclerotic plaque" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Athetosis>
    <http://purl.org/dc/terms/bibliographicCitation> "From Adams et al., Principles of Neurology, 6th ed, p76" ;
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
