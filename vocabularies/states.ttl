    skos:inScheme state: ;
    skos:prefLabel "Tooth diseases" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothErosion a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:ToothDemineralization ;
    skos:related state:ToothWear ;
    skos:definition "Loss of tooth hard tissue caused by chemical dissolution, usually from acidic exposure rather than bacterial decay." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014077> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth erosion" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

