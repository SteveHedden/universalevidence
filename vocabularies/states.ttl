<https://universalevidence.com/vocab/states/GuillainBarreSyndrome>
    <http://purl.org/dc/terms/bibliographicCitation> "From Adams et al., Principles of Neurology, 6th ed, pp1312-1314" ;
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D020275> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/AutoimmuneDiseasesOfTheNervousSystem> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An acute immune-mediated disorder of peripheral nerves and nerve roots that can cause progressive weakness, sensory changes, and autonomic dysfunction." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D020275> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Guillain-Barre syndrome" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:Guilt a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:broader state:Emotions ;
    skos:definition "A self-conscious emotion experienced when a person appraises an action, omission, impulse, or failure as violating a personal, moral, or social responsibility, often involving remorse or a wish to repair harm." ;
    skos:inScheme state: ;
    skos:altLabel "guilt feelings",
        "state guilt" ;
    skos:prefLabel "Guilt" ;
    skos:scopeNote "Use for experienced or experimentally induced guilt and for measures of guilt felt in the moment. Do not use for guilt aversion, which is a prospective preference to avoid guilt or disappointing others; stable guilt proneness; an assessment instrument without a separately interpretable guilt result; or broad psychological distress or wellbeing unless guilt itself is measured." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

