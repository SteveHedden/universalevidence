<https://universalevidence.com/vocab/states/ABVariantTaySachsDisease>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D049290> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Tay-Sachs Disease, AB Variant" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Gangliosidoses> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D013661> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A progressive neurodegenerative disorder that begins with muscle weakness, then progresses to startle reaction, retardation and seizures. It is characterized by the accumulation of G(M2) GANGLIOSIDE in neurons that is caused by a lack of G(M2) ACTIVATOR PROTEIN function. The AB variant designation refers to the increase of both HEXOSAMINIDASE A and HEXOSAMINIDASE B in tissues that lack of G(M2) activator protein." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D049290> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "AB variant Tay-Sachs disease" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:AIAcceptance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:altLabel "artificial intelligence acceptance" ;
    skos:broader state:Acceptance ;
    skos:definition "The degree to which people, workers, organizations, or communities trust, accept, and are willing to use artificial intelligence systems." ;
    skos:inScheme state: ;
    skos:prefLabel "AI acceptance" ;
    skos:related state:ServiceRobotAdoption ;
    skos:scopeNote "Use for attitudes, trust, acceptance, or willingness to use artificial-intelligence systems. Use Acceptance for an unspecified object; AIAdoption for realized uptake or routine use; AlgorithmicExplainability for whether an AI decision can be understood or explained; and AlgorithmicFairness for equitable algorithmic decisions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/AIAdoption>
    <http://purl.org/dc/terms/created> "2026-06-09"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "AI usage" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "artificial intelligence adoption" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/TechnologyAdoption> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The uptake and routine use of artificial intelligence tools by individuals, firms, public agencies, or other organizations." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "AI adoption" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/ServiceRobotAdoption> ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/PrivateSector> .

