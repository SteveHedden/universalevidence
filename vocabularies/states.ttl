state:Menopause a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:PopulationHealthStatus ;
    skos:definition "The normal life stage marked by the permanent end of menstrual periods due to loss of ovarian follicular activity. It is commonly accompanied by hormonal changes and can be associated with vasomotor, sleep, mood, and genitourinary symptoms." ;
    skos:inScheme state: ;
    skos:prefLabel "Menopause" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

