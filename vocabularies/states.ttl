state:AlcoholicCardiomyopathy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D002310> ;
    skos:altLabel "Cardiomyopathy, Alcoholic" ;
    skos:broader state:HeartDiseases ;
    skos:definition "Disease of CARDIAC MUSCLE resulting from chronic excessive alcohol consumption. Myocardial damage can be caused by: (1) a toxic effect of alcohol; (2) malnutrition in alcoholics such as THIAMINE DEFICIENCY; or (3) toxic effect of additives in alcoholic beverages such as COBALT. This disease is usually manifested by DYSPNEA and palpitations with CARDIOMEGALY and congestive heart failure (HEART FAILURE)." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D002310> ;
    skos:inScheme state: ;
    skos:prefLabel "Alcoholic cardiomyopathy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

