state:DarierDisease a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D007644> ;
    skos:broader state:CongenitalAndGeneticDisorders ;
    skos:definition "An autosomal dominantly inherited skin disorder characterized by warty malodorous papules that coalesce into plaques. It is caused by mutations in the ATP2A2 gene encoding SERCA2 protein, one of the SARCOPLASMIC RETICULUM CALCIUM-TRANSPORTING ATPASES. The condition is similar, clinically and histologically, to BENIGN FAMILIAL PEMPHIGUS, another autosomal dominant skin disorder. Both diseases have defective calcium pumps (CALCIUM-TRANSPORTING ATPASES) and unstable desmosomal adhesion junctions (DESMOSOMES) between KERATINOCYTES." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007644> ;
