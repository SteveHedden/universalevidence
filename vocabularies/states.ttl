state:IntestinalDiseases a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:ColorectalAndIntestinalDiseases ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D007579>,
        <http://id.nlm.nih.gov/mesh/D008531>,
        <http://id.nlm.nih.gov/mesh/D011006>,
        <http://id.nlm.nih.gov/mesh/D012778>,
        <http://id.nlm.nih.gov/mesh/D013182>,
        <http://id.nlm.nih.gov/mesh/D058535> ;
    skos:definition "Diseases and disorders affecting the small intestine, large intestine, or associated intestinal function." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007410> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal diseases" ;
    skos:related state:IntestinalNeoplasms ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalFistula a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:DigestiveFistulaDisorders ;
    skos:definition "Abnormal passage involving the intestine and another organ, body surface, or intestinal segment, often causing leakage, infection, or malnutrition." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007412> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal fistula" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalNeoplasms a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:GastrointestinalNeoplasms ;
    skos:related state:IntestinalDiseases ;
