state:LaborShortages a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketNeeds ;
    skos:definition "A condition in which employers' demand for workers or skills exceeds the available supply at prevailing wages and working conditions." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor shortages" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborSubstitution a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "Replacement of one type of labor, skill, task, or worker group with another input in production or service delivery." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor substitution" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborSupply a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The number of people willing and available to work, and the hours they are prepared to offer, at prevailing wages and working conditions." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor supply" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measuredBy state:LaborSupplyElasticity .

state:LaborSupplyElasticity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
