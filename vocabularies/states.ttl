        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "diabetic peripheral neuropathy" ;
    skos:broader state:DiabetesComplications ;
    skos:definition "Peripheral nerve damage caused by diabetes mellitus, often presenting with pain, numbness, tingling, or sensory loss in the extremities. It reflects microvascular and metabolic injury to nerves associated with chronic hyperglycemia." ;
    skos:inScheme state: ;
    skos:prefLabel "Diabetic neuropathy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

