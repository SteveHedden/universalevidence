    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D009976> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Orthomyxoviridae infections" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:OrthostaticHypotension a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "Hypotension, Orthostatic" ;
    skos:broader state:Hypotension ;
    skos:definition "A significant fall in systemic blood pressure after standing, conventionally at least 20 mm Hg systolic or 10 mm Hg diastolic within three minutes of rising from supine." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007024> ;
    skos:inScheme state: ;
    skos:prefLabel "Orthostatic hypotension" ;
    skos:scopeNote "Use for postural hypotension or orthostatic blood-pressure drops meeting or assessing this condition. Use OrthostaticIntolerance for posture-triggered symptoms without an established hypotensive blood-pressure fall, and BloodPressureMeasurement for an orthostatic measurement that does not assert hypotension." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:OrthostaticIntolerance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:CardiovascularDiseases ;
    skos:definition "Symptoms such as lightheadedness, palpitations, weakness, or syncope triggered by upright posture and relieved by recumbency." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D054971> ;
    skos:inScheme state: ;
    skos:prefLabel "Orthostatic intolerance" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:OssificationOfPosteriorLongitudinalLigament a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:BoneDisorders ;
    skos:definition "Abnormal ossification of the posterior longitudinal ligament of the spine, which can narrow the spinal canal and compress neural structures." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D017887> ;
    skos:inScheme state: ;
    skos:prefLabel "Ossification of posterior longitudinal ligament" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:OssifyingFibroma a skos:Concept,
        ue:State ;
