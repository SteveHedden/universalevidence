state:MarketParticipation a skos:Concept,
        ue:State ;
    skos:broader state:EconomicStatus ;
    skos:definition "An individual's, household's, or producer's condition of engagement with markets, trade, and intermediated transactions." ;
    skos:inScheme state: ;
    skos:prefLabel "Market participation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LivelihoodStatus a skos:Concept,
        ue:State ;
    skos:broader state:EconomicStatus ;
    skos:definition "The production, income, and livelihood condition of an individual or household engaged in a specific occupation or enterprise." ;
    skos:inScheme state: ;
    skos:prefLabel "Livelihood status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:EconomicStatus a skos:Concept,
        ue:State ;
    skos:definition "The material and financial condition of an individual, household, or population, including income, wealth, housing, and consumption." ;
    skos:inScheme state: ;
    skos:prefLabel "Economic status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:EmploymentStatus a skos:Concept,
        ue:State ;
    skos:definition "An individual's condition with respect to work, career, and labor force participation, as experienced by the person -- distinct from state:Employment, which is the aggregate labor-market-system condition." ;
    skos:inScheme state: ;
    skos:prefLabel "Employment status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:SafetyAndSecurityStatus a skos:Concept,
        ue:State ;
    skos:definition "The condition of people, households, institutions, communities, or systems with respect to exposure and vulnerability to violence, crime, conflict, disasters, crises, or other shocks, and their capacity and response to such threats." ;
    skos:inScheme state: ;
    skos:prefLabel "Safety and security status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:SocialInclusionAndIdentityStatus a skos:Concept,
        ue:State ;
    skos:definition "The condition of an individual or group with respect to social identity, belonging, discrimination, and inclusion within their community or society." ;
    skos:inScheme state: ;
    skos:prefLabel "Social inclusion and identity status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:CivicAndPoliticalStatus a skos:Concept,
        ue:State ;
    skos:definition "An individual's or population's condition with respect to civic engagement, political participation, and attitudes toward governing institutions." ;
    skos:inScheme state: ;
    skos:prefLabel "Civic and political status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:PsychologicalAndBehavioralStatus a skos:Concept,
        ue:State ;
    skos:definition "An individual's cognitive, psychological, and behavioral condition, including decision-making processes, biases, and behavioral responses studied in behavioral science." ;
    skos:inScheme state: ;
    skos:prefLabel "Psychological and behavioral status" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:PopulationHealthState a skos:Collection ;
    skos:definition "Conditions of individuals and populations, including health, education, and other measurable states experienced directly by persons or groups." ;
