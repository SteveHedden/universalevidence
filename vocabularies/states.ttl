    skos:closeMatch <https://unstats.un.org/sdgs/target/8_2> .

state:LaborRationing a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The allocation of jobs or working hours through constraints or non-price mechanisms when labor supply and demand do not clear through wages." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor rationing" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborResponse a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "Changes in labor supply, participation, hours, employment, or wages in response to economic incentives, policies, or shocks." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor response" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:LaborSavingDevices a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:TechnologyAdoption ;
    skos:definition "Use of tools or technologies that reduce the human time or effort required to perform work tasks." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor-saving device use" ;
