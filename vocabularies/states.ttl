    skos:example "Decline in native pollinator populations threatening agricultural productivity in sub-Saharan Africa." ;
    skos:hiddenLabel "biodiversity decline",
        "extinction crisis",
        "species richness decline" ;
    skos:inScheme state: ;
    skos:prefLabel "Biodiversity loss" ;
    skos:related state:Deforestation ;
    skos:scopeNote "Use for evidenced declines in species, genetic, or ecosystem diversity. Habitat fragmentation and deforestation may cause such declines but are not themselves synonyms for biodiversity loss." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Biodiversity> ;
    ue:measuredBy indicator:BiodiversityStatus,
        indicator:SDG252BreedExtinctionRiskShare,
