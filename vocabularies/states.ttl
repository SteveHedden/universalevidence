state:Myocarditis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D009205> ;
    skos:broader state:Cardiomyopathies ;
    skos:definition "Inflammatory processes of the muscular walls of the heart (MYOCARDIUM) which result in injury to the cardiac muscle cells (MYOCYTES, CARDIAC). Manifestations range from subclinical to sudden death (DEATH, SUDDEN). Myocarditis in association with cardiac dysfunction is classified as inflammatory CARDIOMYOPATHY usually caused by INFECTION, autoimmune diseases, or responses to toxic substances. Myocarditis is also a common cause of DILATED CARDIOMYOPATHY and other cardiomyopathies." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D009205> ;
    skos:inScheme state: ;
    skos:prefLabel "Myocarditis" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

