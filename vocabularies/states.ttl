state:EntrepreneurialCognition a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:altLabel "entrepreneurial decision-making" ;
    skos:broader state:DecisionMakingBehavior ;
    skos:definition "Beliefs, mental models, perceptions, judgments, and decision processes through which entrepreneurs identify, evaluate, and act on opportunities, whether or not venture creation occurs." ;
    skos:inScheme state: ;
    skos:prefLabel "Entrepreneurial cognition" ;
    skos:scopeNote "Use for entrepreneur-level opportunity framing, theory formation, search heuristics, prediction, and strategic judgment. Use EntrepreneurialActivity for realized venture creation, self-employment, or business formation; BusinessStrategy for firm-level strategic choices; and EntrepreneurialIntentions for intentions or willingness to start or grow a business." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

