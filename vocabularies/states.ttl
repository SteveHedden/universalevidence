    skos:broader state:NeurologicalSleepDisorders ;
    skos:definition "A parasomnia marked by sudden episodes of intense fear, autonomic arousal, and incomplete awakening from sleep, most often during non-REM sleep." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020184> ;
    skos:inScheme state: ;
    skos:prefLabel "Night terrors" ;
