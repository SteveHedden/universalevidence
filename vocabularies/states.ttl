<https://universalevidence.com/vocab/states/RettSyndrome>
    <http://purl.org/dc/terms/bibliographicCitation> "From Menkes, Textbook of Child Neurology, 5th ed, p199" ;
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D015518> ;
