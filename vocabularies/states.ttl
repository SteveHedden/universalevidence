state:MenstrualHealth a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:PopulationHealthStatus ;
    skos:definition "A state of complete physical, mental, and social wellbeing in relation to the menstrual cycle, not merely the absence of disease or infirmity." ;
    skos:inScheme state: ;
    skos:prefLabel "Menstrual health" ;
    skos:scopeNote "Includes access to accurate information, effective and affordable menstrual materials, supportive water, sanitation, hygiene and waste services, timely care for menstrual difficulties, freedom from stigma, and participation in daily life. Use a narrower condition, barrier, behavior, or preference concept when the source asserts only that aspect." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:MenstrualStigma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:Stigma ;
    skos:definition "Stigma, shame, restrictions, or discriminatory beliefs associated with menstruation." ;
    skos:inScheme state: ;
    skos:prefLabel "Menstrual stigma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:MenstruationDisturbances a skos:Concept,
        ue:State ;
