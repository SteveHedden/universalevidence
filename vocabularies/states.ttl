state:Progeria a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D011371> ;
    skos:broader state:CongenitalMultisystemMalformationSyndromes ;
    skos:definition "An abnormal congenital condition, associated with defects in the LAMIN TYPE A gene, which is characterized by premature aging in children, where all the changes of cell senescence occur. It is manifested by premature graying; hair loss; hearing loss (DEAFNESS); cataracts (CATARACT); ARTHRITIS; OSTEOPOROSIS; DIABETES MELLITUS; atrophy of subcutaneous fat; skeletal hypoplasia; elevated urinary HYALURONIC ACID; and accelerated ATHEROSCLEROSIS. Many affected individuals develop malignant tumors, especially SARCOMA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D011371> ;
    skos:inScheme state: ;
    skos:prefLabel "Progeria" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

