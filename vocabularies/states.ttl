state:AlgorithmicAccuracy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "Predictive accuracy" ;
    skos:broader state:AlgorithmicDecisionMaking ;
    skos:definition "The degree to which algorithmic predictions, classifications, or recommendations correctly represent the target outcome or decision criterion." ;
    skos:inScheme state: ;
    skos:prefLabel "Algorithmic accuracy" ;
    skos:related state:AlgorithmicBias,
        state:AlgorithmicFairness ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:AlgorithmicBias a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "AI bias",
        "Machine learning bias" ;
    skos:broader state:AlgorithmicDecisionMaking ;
    skos:definition "Systematic error or inequitable differential outcomes generated by algorithmic systems that disadvantage people, groups, or decisions." ;
    skos:inScheme state: ;
    skos:prefLabel "Algorithmic bias" ;
    skos:related state:AlgorithmicAccuracy,
        state:AlgorithmicFairness ;
    skos:scopeNote "Use for bias originating in algorithm design, training data, predictions, rankings, classifications, or automated decision outputs. Use DecisionBias for human cognitive biases, including automation bias caused by over-reliance on automated advice." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

