state:MotorPartialEpilepsy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020938> ;
    skos:altLabel "Epilepsy, Partial, Motor" ;
    skos:broader state:PartialEpilepsies ;
    skos:definition "A disorder characterized by recurrent localized paroxysmal discharges of cerebral neurons that give rise to seizures that have motor manifestations. The majority of partial motor seizures originate in the FRONTAL LOBE (see also EPILEPSY, FRONTAL LOBE). Motor seizures may manifest as tonic or clonic movements involving the face, one limb or one side of the body. A variety of more complex patterns of movement, including abnormal posturing of extremities, may also occur." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020938> ;
    skos:inScheme state: ;
    skos:prefLabel "Motor partial epilepsy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

