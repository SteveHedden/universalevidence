<https://universalevidence.com/vocab/states/CongenitalHipDislocation>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D006618> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Hip Dislocation, Congenital" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/DevelopmentalDysplasiaOfTheHip> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Congenital dislocation of the hip generally includes subluxation of the femoral head, acetabular dysplasia, and complete dislocation of the femoral head from the true acetabulum. This condition occurs in approximately 1 in 1000 live births and is more common in females than in males." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D006618> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Congenital hip dislocation" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CongenitalHyperinsulinism>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D044903> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/InbornErrorsOfMetabolism> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A familial, nontransient HYPOGLYCEMIA with defects in negative feedback of GLUCOSE-regulated INSULIN release. Clinical phenotypes include HYPOGLYCEMIA; HYPERINSULINEMIA; SEIZURES; COMA; and often large BIRTH WEIGHT. Several sub-types exist with the most common, type 1, associated with mutations on an ATP-BINDING CASSETTE TRANSPORTERS (subfamily C, member 8)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D044903> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D044903" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Congenital hyperinsulinism" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

