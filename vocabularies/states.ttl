<https://universalevidence.com/vocab/states/CarotidStenosis>
    <http://purl.org/dc/terms/bibliographicCitation> "From Adams et al., Principles of Neurology, 6th ed, pp 822-3" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D016893> ;
