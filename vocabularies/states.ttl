state:OccupationalAccidentRate a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Work-related accident incidence",
        "Workplace injury rate" ;
    skos:definition "Measured incidence or rate of work-related accidents, injuries, or fatalities among a defined workforce." ;
    skos:example "Number of lost-time injuries per 1,000 workers per year in a manufacturing sector." ;
    skos:hiddenLabel "occupational injury rate",
        "workplace fatality rate" ;
    skos:inScheme state: ;
    skos:prefLabel "Occupational accident rate" ;
