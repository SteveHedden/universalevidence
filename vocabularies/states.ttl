    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinoma, pancreatic ductal" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CarcinomaPapillaryFollicular>
    <http://purl.org/dc/terms/bibliographicCitation> "From DeVita Jr et al., Cancer: Principles & Practice of Oncology, 3d ed, p1271" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018265> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/AdenocarcinomaFollicular> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A thyroid carcinoma displaying both papillary and follicular architectural features." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018265> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018265" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinoma, papillary, follicular" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CarcinomaSkinAppendage>
    <http://purl.org/dc/terms/bibliographicCitation> "From Dorland, 27th ed" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018280> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CutaneousCysticAndProliferativeLesions> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A malignant epithelial tumor arising from skin appendages, including sweat glands, sebaceous glands, or hair-follicle structures." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018280> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018280" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinoma, skin appendage" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CarcinomaSmallCell>
    <http://purl.org/dc/terms/bibliographicCitation> "From Stedman, 25th ed; Holland et al., Cancer Medicine, 3d ed, p1286-7" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018288> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Carcinoma> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An aggressive carcinoma composed of small malignant cells with little cytoplasm, often arising in the lung." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018288> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018288" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinoma, small cell" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CarcinomaVerrucous>
    <http://purl.org/dc/terms/bibliographicCitation> "Segen, Dictionary of Modern Medicine, 1992" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018289> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Carcinoma> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A well-differentiated squamous carcinoma with a wartlike growth pattern, occurring on skin or mucosal surfaces." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018289> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018289" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinoma, verrucous" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Carcinosarcoma>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002296> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Carcinoma> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A malignant neoplasm that contains elements of carcinoma and sarcoma so extensively intermixed as to indicate neoplasia of epithelial and mesenchymal tissue. (Stedman, 25th ed)" ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002296> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Carcinosarcoma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CardiacEdema>
    <http://purl.org/dc/terms/created> "2026-06-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D004489> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Edema, Cardiac" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Edema> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Abnormal fluid retention by the body due to impaired cardiac function or heart failure. It is usually characterized by increase in venous and capillary pressure, and swollen legs when standing. It is different from the generalized edema caused by renal dysfunction (NEPHROTIC SYNDROME)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D004489> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Cardiac edema" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CardiacOutputHigh>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D016534> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HeartDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A state of elevated cardiac output due to conditions of either increased hemodynamic demand or reduced cardiac oxygen output. These conditions may include ANEMIA; ARTERIOVENOUS FISTULA; THYROTOXICOSIS; PREGNANCY; EXERCISE; FEVER; and HYPOXIA. In time, compensatory changes of the heart can lead to pathological form of high cardiac output and eventual HEART FAILURE." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D016534> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D016534" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Cardiac output, high" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

