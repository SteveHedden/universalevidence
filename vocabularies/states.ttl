state:SertoliLeydigCellTumor a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D018310> ;
    skos:broader state:OvarianCancer ;
    skos:definition "A sex cord-gonadal stromal tumor consists of LEYDIG CELLS; SERTOLI CELLS; and FIBROBLASTS in varying proportions and degree of differentiation. Most such tumors produce ANDROGENS in the Leydig cells, formerly known as androblastoma or arrhenoblastoma. Androblastomas occur in the TESTIS or the OVARY causing precocious masculinization in the males, and defeminization, or virilization (VIRILISM) in the females. In some cases, the Sertoli cells produce ESTROGENS." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D018310> ;
    skos:inScheme state: ;
