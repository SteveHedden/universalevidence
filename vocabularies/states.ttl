state:TeacherQuality dcterms:created "2026-06-18"^^xsd:date ;
    a skos:Concept,
        ue:State ;
    skos:altLabel "teacher effectiveness" ;
    skos:broader state:EducationQuality ;
    skos:definition "Teacher knowledge, effort, effectiveness, attendance, beliefs, and classroom practices that affect student learning." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Teacher quality" ;
    skos:scopeNote "Use for measured instructor knowledge, skill, effort, attendance, instructional practice, effectiveness, or teaching quality. Compound teacher-and-student outcome bundles are only close matches. Exclude training attendance alone, coach characteristics, teacher attrition, school-leader decisions, and student outcomes without a teacher-quality measure; use ProfessorEngagement for higher-education instructor effort, feedback, responsiveness, and support." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:WDISEPRETCAQMAZS,
        state:WDISEPRETCAQZS,
        state:WDISEPRMTCAQFEZS,
        state:WDISEPRMTCAQMAZS,
        state:WDISEPRMTCAQZS,
        state:WDISESECTCAQFEZS,
        state:WDISESECTCAQLOZS,
        state:WDISESECTCAQMAZS,
        state:WDISESECTCAQUPZS,
        state:WDISESECTCAQZS .

