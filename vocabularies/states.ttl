state:AlertFatigueCondition a skos:Concept,
        ue:State ;
    skos:altLabel "alarm fatigue",
        "clinical alert fatigue" ;
    skos:broader state:HealthServiceAndQualityOutcome ;
    skos:definition "The persistent desensitization of health personnel to clinical decision support alerts and alarms due to excessive frequency, leading to ignored or overridden warnings and increased risk of patient harm." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071064> ;
    skos:example "Studies measuring the rate at which EHR-generated drug interaction alerts are overridden by clinicians." ;
    skos:hiddenLabel "alarm overload",
        "alert overload" ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Alert fatigue" ;
    skos:scopeNote "Focuses on the system-level condition of excessive alerting in clinical environments, distinct from individual burnout or general occupational stress." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    ue:measuredBy state:AlertFatigueRate .

<https://universalevidence.com/vocab/states/AlexanderDisease>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D038261> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/DemyelinatingDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Rare leukoencephalopathy with infantile-onset accumulation of Rosenthal fibers in the subpial, periventricular, and subependymal zones of the brain. Rosenthal fibers are GLIAL FIBRILLARY ACIDIC PROTEIN aggregates found in ASTROCYTES. Juvenile- and adult-onset types show progressive atrophy of the lower brainstem instead. De novo mutations in the GFAP gene are associated with the disease with propensity for paternal inheritance." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D038261> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D038261" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Alexander disease" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

