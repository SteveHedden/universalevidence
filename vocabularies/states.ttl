state:Dermatofibrosarcoma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D018223> ;
    skos:broader state:SoftTissueNeoplasms ;
    skos:definition "A sarcoma of the deep layers of the skin. The tumors are locally aggressive tends to recur but rarely metastatic. It can be classified into variants depending on the cell type tumors are derived from or by its characteristics: Pigmented variant from MELANIN-containing DERMAL DENDRITIC CELLS; Myxoid variant, myxoid STROMAL CELLS; Giant cell variant characterized by GIANT CELLS in the tumors; and Fibrosarcomatous variant chracterized by tumor areas histologically indistinguishable from FIBROSARCOMA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D018223> ;
    skos:hiddenLabel "D018223" ;
    skos:inScheme state: ;
    skos:prefLabel "Dermatofibrosarcoma" ;
