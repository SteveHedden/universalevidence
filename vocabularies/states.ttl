    skos:broader state:ToothDevelopmentAndStructureDisorders ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D014086> ;
    skos:definition "Abnormal movement or displacement of teeth from their usual position, often associated with periodontal disease." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014085> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth migration" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothResorption a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:DentalHardTissueAndDepositDisorders ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D012391> ;
