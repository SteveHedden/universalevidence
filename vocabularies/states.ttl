state:InformalCreditUse a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:InformalFinance ;
    skos:definition "The extent to which people or firms borrow from moneylenders, relatives, savings groups, suppliers, or other lenders outside regulated formal finance." ;
    skos:inScheme state: ;
    skos:prefLabel "Informal credit use" ;
    skos:scopeNote "Use for actual borrowing, loans, debt, or credit outside regulated formal finance; provider labels such as moneylender alone are only related evidence, and informal saving, insurance, or transfers belong under InformalFinance." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

