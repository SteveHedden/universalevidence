state:GroupBehavior a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:broader state:SocialAndStrategicDecisionBehavior ;
    skos:definition "Patterns and processes of formation, membership, interaction, decision-making, cooperation, competition, conflict, or influence that arise within or between social groups." ;
    skos:hiddenLabel "group beaviour" ;
    skos:inScheme state: ;
    skos:altLabel "Group behaviour" ;
    skos:prefLabel "Group behavior" ;
    skos:scopeNote "Use for broad group-level or intergroup behavioral processes, whether cooperative, competitive, conflictual, inclusive, or exclusionary. Do not use merely because a study has teams, groups, or group-level analysis. Use GroupCollaboration for cooperative joint work, GroupDecisionMaking for collective choices, GroupPerformance for shared-task performance, GroupFormation for group creation or joining, and SocialCohesion for trust, solidarity, inclusion, or connectedness." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:GroupCollaboration a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:broader state:GroupBehavior ;
    skos:definition "The extent and quality of cooperative interaction through which people within a group, or groups working with one another, coordinate work and jointly solve problems toward shared tasks or goals." ;
    skos:inScheme state: ;
    skos:altLabel "team collaboration" ;
    skos:prefLabel "Group collaboration" ;
    skos:scopeNote "Use for collaboration processes within teams or between groups or organizations. Use Teamwork for an individual’s collaboration competency, GroupPerformance for task outputs, GroupDecisionMaking for collective choices, and CooperativeBehavior for cooperation not organized around joint work." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:GroupDecisionMaking a skos:Concept,
        ue:State ;
