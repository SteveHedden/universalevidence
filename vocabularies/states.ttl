        indicator:SDG1A1PovertyReductionOdaShare,
        indicator:SDG2A2OfficialFlowsToAgriculture,
        indicator:SDG3B2OdaToMedicalResearchAndHealthSectors,
        indicator:SDG4B1ScholarshipOdaFlowVolume,
