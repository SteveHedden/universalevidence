state:CentralNervousSystemVenousAngioma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020787> ;
    skos:broader state:CerebrovascularDisorders ;
    skos:definition "A vascular anomaly characterized by a radial or wedge-shaped arrangement of dilated VEINS draining into a larger vein in the brain, spinal cord, or the meninges. Veins in a venous angioma are surrounded by normal nervous tissue, unlike a CENTRAL NERVOUS SYSTEM CAVERNOUS HEMANGIOMA that lacks intervening nervous tissue. Drainage of venous angioma is fully integrated with the body's venous system, therefore, in most cases there is no clinical signs and rare bleeding." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020787> ;
    skos:hiddenLabel "D020787" ;
    skos:inScheme state: ;
    skos:prefLabel "Central nervous system venous angioma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

