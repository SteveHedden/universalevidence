state:BiodiversityLoss a skos:Concept,
        ue:State ;
    skos:altLabel "Species loss" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D044822> ;
    skos:definition "The persistent decline in the variety of species, genetic resources, and ecosystems, reducing the resilience and productive capacity of natural systems." ;
    skos:example "Decline in native pollinator populations threatening agricultural productivity in sub-Saharan Africa." ;
    skos:hiddenLabel "biodiversity decline",
        "extinction crisis",
        "species richness decline" ;
    skos:inScheme state: ;
    skos:prefLabel "Biodiversity loss" ;
    skos:scopeNote "Use for evidenced declines in species, genetic, or ecosystem diversity. Habitat fragmentation and deforestation may cause such declines but are not themselves synonyms for biodiversity loss." ;
    skos:related state:Deforestation ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Biodiversity> ;
    ue:measuredBy state:BiodiversityStatus,
        state:SDG252BreedExtinctionRiskShare,
        state:WDIENBIRTHRDNO,
        state:WDIENFSHTHRDNO,
        state:WDIENHPTTHRDNO,
        state:WDIENMAMTHRDNO,
        state:WDIERLNDPTLDZS,
        state:WDIERMRNPTMRZS,
        state:WDIERPTDTOTLZS ;
    skos:broader state:BiodiversitySystemConditions .

