state:CulturalConsumption a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:ConsumptionBehavior ;
    skos:definition "Patterns of acquiring, purchasing, accessing, using, or consuming cultural goods, media, or services by individuals or households." ;
    skos:inScheme state: ;
    skos:prefLabel "Cultural consumption" ;
    skos:related state:CulturalParticipation ;
    skos:scopeNote "Use when cultural activity is framed as consumption behavior, including purchases or use of cultural goods and services such as museum admission or membership. Use CulturalParticipation when it is framed as attendance, program use, or active involvement; use Wellbeing only for downstream happiness, life satisfaction, or quality of life." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CulturalDifferences>
    <http://purl.org/dc/terms/created> "2026-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
