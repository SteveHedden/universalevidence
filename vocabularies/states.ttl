<https://universalevidence.com/vocab/states/HigherEducationAccess>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "post-secondary education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "tertiary education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "university education" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/EducationalAdmissionsAccess> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/target/4_3> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/target/4_b> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The availability, accessibility, enrollment, completion, and quality of tertiary and post-secondary education and related academic services." ;
    <http://www.w3.org/2004/02/skos/core#example> "Low tertiary enrollment rates among students from low-income households due to high tuition fees." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "college access" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "university access" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Higher education access and quality" ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#11420> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers tertiary and post-secondary levels; distinguished from secondary and vocational education." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> ;
