state:PregnancyInducedHypertension a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "Gestational hypertension",
        "Hypertension, pregnancy-induced" ;
    skos:broader state:PregnancyAndBirthComplications ;
    skos:definition "New-onset hypertension that develops during pregnancy, typically after mid-gestation, without another chronic hypertensive cause. It can progress to preeclampsia and increase maternal and fetal risk." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D046110> ;
    skos:inScheme state: ;
    skos:prefLabel "Pregnancy-induced hypertension" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

