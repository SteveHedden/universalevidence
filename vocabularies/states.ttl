state:Survival a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-01"^^xsd:date ;
    skos:altLabel "Disease-free survival",
        "Event-free survival",
        "Overall survival",
        "Progression-free survival",
        "Survival rate" ;
    skos:broader state:PopulationHealthStatus ;
    skos:definition "The duration, status, or probability of a person or population remaining alive over a defined period and, where specified, remaining free of disease progression, recurrence, or another qualifying clinical event." ;
    skos:inScheme state: ;
    skos:prefLabel "Survival" ;
    skos:related state:SurvivalInCare ;
    skos:scopeNote "Use for overall, patient, hospital, disease-free, event-free, progression-free, recurrence-free, or other clinical time-to-event survival outcomes. Use CancerSurvivorship for the lived post-diagnosis condition and needs of cancer survivors, SurvivalInCare only when being alive and retained in care are jointly required, Mortality for deaths or death rates, and Durability for product, implant, or device survivorship. Exclude contractual or organizational survival." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy indicator:WDISPDYNTO65FEZS .

state:SurvivalInCare a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "alive and in care" ;
    skos:broader state:HealthServiceUse ;
    skos:definition "Being alive and retained in an ongoing health-care program over a defined follow-up period." ;
    skos:inScheme state: ;
    skos:prefLabel "Survival in care" ;
    skos:related state:Survival ;
    skos:scopeNote "Use only for a composite outcome requiring both survival and continued enrollment, attendance, or retention in care. Use Survival for alive status, hospital or patient survival, and other mortality/time-to-event outcomes without an explicit care-retention requirement; use RetentionInCareRate for care engagement or retention without an alive-status component." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

