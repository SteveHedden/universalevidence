state:PriceDiscountExposure a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:broader state:ChoiceArchitectureExposure ;
    skos:definition "The condition of being offered, shown, or made eligible for a lower effective price than a stated, prevailing, or comparison price, including temporary price cuts, fee reductions, rebates, or discount vouchers." ;
    skos:inScheme state: ;
    skos:prefLabel "Price discount exposure" ;
    skos:scopeNote "Use for the consumer-side price condition, including an actual reduced price or eligibility for one through a coupon, discount card, voucher, or rebate, whether or not behavior changes. Use PricingBehavior or PriceSettingBehavior for a seller’s decision to set, adjust, or communicate prices; use the relevant subsidy, voucher, coupon, or rebate intervention concept for the deliberate delivery mechanism; use Affordability for overall financial burden; and use ConsumerChoice or a domain-specific behavior concept for downstream purchase, take-up, service use, remitting, charging, or other selection behavior." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:PriceDiscrimination a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:PricingBehavior ;
    skos:definition "Variation in prices charged to different consumers or groups for similar goods or services." ;
    skos:inScheme state: ;
    skos:prefLabel "Price discrimination" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:PriceDispersion a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:PricingBehavior ;
    skos:definition "Variation in prices for similar goods or services across sellers, locations, or consumers." ;
    skos:inScheme state: ;
    skos:prefLabel "Price dispersion" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:PriceElasticity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "A measure of the percentage change in quantity demanded associated with a one-percent change in the good’s own price or the price of a related good." ;
    skos:inScheme state: ;
    skos:prefLabel "Price elasticity of demand" ;
    skos:scopeNote "Use for demand-side own-price and cross-price elasticities. Do not use for price elasticity of supply, generic behavioral responsiveness, or physical or material elasticity." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:ProductDemand .

state:PriceGouging a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:PricingBehavior ;
    skos:definition "Excessive or exploitative price increases, especially during scarcity, emergencies, or market disruptions." ;
    skos:inScheme state: ;
    skos:prefLabel "Price gouging" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:PricePassThrough a skos:Concept,
