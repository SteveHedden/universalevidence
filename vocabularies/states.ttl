state:SocialBarriers a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-22"^^xsd:date ;
    skos:broader state:AgencyConstraints ;
    skos:definition "Constraints arising from social norms, stigma, discrimination, social distance, or restrictive network and community relationships that limit the practical ability of people or groups to access opportunities or services, participate in social, economic, or civic life, or act on their goals." ;
    skos:inScheme state: ;
    skos:prefLabel "Social barriers" ;
    skos:related state:SocialExclusion ;
    skos:scopeNote "Use for causal obstacles rooted in social relations, norms, or identity, whether or not exclusion occurs. Use SocialExclusion for realized exclusion from participation or relationships, SocialInequality for unequal distributions across groups, InstitutionalBarriers for rule- or organization-based constraints, and a domain-specific barrier concept for administrative, geographic, program-application, migration, or other specific obstacles." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

