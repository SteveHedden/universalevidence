state:EpilepticSyndromes a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:altLabel "Epilepsy syndromes",
        "Syndromic epilepsies" ;
    skos:broader state:Epilepsy ;
    skos:definition "A family of epilepsy disorders characterized by seizures with a shared type and age of onset plus common clinical-course, electroencephalographic, genetic, or neuropathologic features." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000073376> ;
    skos:inScheme state: ;
    skos:prefLabel "Epileptic syndromes" ;
    skos:scopeNote "Use when an epileptic or epilepsy syndrome, or a named member of that family, is explicit. Use Epilepsy for generic or unspecified epilepsy; this concept is not equivalent to the generic Syndrome concept." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

