state:ProductDiscovery a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:ConsumerAwareness ;
    skos:definition "The extent to which consumers or professional users encounter and learn about previously unknown products and their attributes through search, recommendations, rankings, advertising, reviews, or other information channels." ;
    skos:inScheme state: ;
    skos:prefLabel "Product discovery" ;
    skos:scopeNote "Use when encountering or becoming aware of products is the represented construct. Use ConsumerSearchBehavior for active effort to gather and compare product information, MarketLearning for updating beliefs about broader market conditions, and ProductAdoption for product trial or use." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

