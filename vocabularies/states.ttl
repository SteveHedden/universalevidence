    skos:scopeNote "Use for entry or linkage into care. Excludes recruitment or enrollment into a research study, health-insurance enrollment or coverage, and actual attendance, treatment, or service use after enrollment."  ;
    skos:inScheme state: ;
    skos:prefLabel "Care enrollment" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

