state:DriverBehavior a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:altLabel "driver behaviour",
        "driver conduct",
        "driver performance",
        "driving behavior",
        "driving behaviour",
        "driving performance" ;
    skos:broader state:IndividualBehavior ;
    skos:definition "Patterns of action and operational choices by people while driving motor vehicles, including speed choice, acceleration, braking, cornering, route and departure timing, rest breaks, attention, rule compliance, and fuel-efficient technique." ;
    skos:inScheme state: ;
    skos:prefLabel "Driver behavior" ;
    skos:related state:RiskTakingBehavior ;
    skos:scopeNote "Use for conduct or operational performance while a person drives. Use commuting behavior when the construct is primarily mode, route, or departure-time choice for travel to a regular destination; use traffic speeding behavior or drunk driving behavior for those specific risky acts; and use road traffic injuries for crashes, injuries, or fatalities." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

