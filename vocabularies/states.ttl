    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/WDISABERTERGOAL5> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/WDISABERTERGOAL6LVL1> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/WDISEENRTERTFMZS> ;
