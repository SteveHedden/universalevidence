        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D013611> ;
    skos:altLabel "Tachycardia, Atrioventricular Nodal Reentry" ;
    skos:broader state:CardiacArrhythmias ;
    skos:definition "Abnormally rapid heartbeats caused by reentry of atrial impulse into the dual (fast and slow) pathways of ATRIOVENTRICULAR NODE. The common type involves a blocked atrial impulse in the slow pathway which reenters the fast pathway in a retrograde direction and simultaneously conducts to the atria and the ventricles leading to rapid HEART RATE of 150-250 beats per minute." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D013611> ;
    skos:inScheme state: ;
    skos:prefLabel "Atrioventricular nodal reentry tachycardia" ;
