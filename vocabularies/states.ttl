state:BarthSyndrome a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D056889> ;
    skos:broader state:Cardiomyopathies ;
    skos:definition "Rare congenital X-linked disorder of lipid metabolism. Barth syndrome is transmitted in an X-linked recessive pattern. The syndrome is characterized by muscular weakness, growth retardation, DILATED CARDIOMYOPATHY, variable NEUTROPENIA, 3-methylglutaconic aciduria (type II) and decreases in mitochondrial CARDIOLIPIN level. Other biochemical and morphological mitochondrial abnormalities also exist." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D056889> ;
    skos:hiddenLabel "D056889" ;
    skos:inScheme state: ;
    skos:prefLabel "Barth syndrome" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

