<https://universalevidence.com/vocab/states/WarExposure>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "conflict exposure" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "wartime exposure" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CrimeViolenceConflict> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The persistent condition of populations being exposed to the direct and indirect effects of armed conflict — including violence, displacement, loss of livelihoods, and destruction of infrastructure — which constrains wellbeing and development." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D000067453> ;
    <http://www.w3.org/2004/02/skos/core#example> "Population living in active conflict zones experiencing persistent displacement and insecurity." ;
    <http://www.w3.org/2004/02/skos/core#example> "Survey-measured prevalence of direct war exposure among refugees, linked to mental health outcomes." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "armed conflict exposure" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "war trauma" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "wartime victimization" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "War and armed conflict exposure" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/MentalHealth> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/Migration> ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:WorkFamilyBalance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "family-work balance" ;
    skos:broader state:WorkLifeBalance ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000072358> ;
    skos:definition "The degree to which occupational responsibilities and family or caregiving responsibilities can be jointly fulfilled with compatible demands on time, energy, and attention." ;
    skos:inScheme state: ;
    skos:prefLabel "Work-family balance" ;
    skos:related state:FamilyStructure,
        state:JobQuality ;
    skos:scopeNote "Use for the family- or caregiving-specific component of work-life balance. Use WorkLifeBalance for the broader relationship between work and all domains of private life, and WorkLifeImbalanceCondition for persistent conflict or incompatibility between roles. Do not use for physical or postural balance." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WorkLifeImbalanceCondition a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "work-family conflict",
        "work-life conflict" ;
    skos:broader state:Wellbeing ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000072358> ;
    skos:definition "The persistent difficulty individuals face in managing competing demands between occupational responsibilities and personal, family, and leisure activities, leading to stress, burnout, and reduced wellbeing." ;
    skos:example "Surveys measuring perceived work-life imbalance among health workers in high-burden settings." ;
    skos:inScheme state: ;
    skos:prefLabel "Work-life imbalance" ;
    skos:related state:MentalHealth,
        state:WorkLifeBalance ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/AccidentIncidence>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Indicator> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Injury incidence" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Unintentional injury rate" ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D000060> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D000061> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Measured incidence, prevalence, or rate of unintentional accidents and resulting injuries across any setting." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D000059> ;
    <http://www.w3.org/2004/02/skos/core#example> "Annual rate of unintentional injury hospitalizations per 100,000 population." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "accident rate" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "injury burden" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Accident incidence" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/CrimeAndViolence> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/DisasterLoss> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/RadiationExposure> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers unintentional accidents broadly; more specific outcomes such as road traffic accidents or occupational accidents are narrower instances." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> ;
    <https://universalevidence.com/ontology/measures> <https://universalevidence.com/vocab/states/InjuryIncidenceRiskAndSeverity> .

<https://universalevidence.com/vocab/states/AcuteKidneyInjury>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D058186> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/RenalDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Abrupt reduction in kidney function. Acute kidney injury encompasses the entire spectrum of the syndrome including acute kidney failure; ACUTE KIDNEY TUBULAR NECROSIS; and other less severe conditions." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D058186> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D058186" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Acute kidney injury" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:AcuteMalnutrition a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "Acute childhood malnutrition",
        "GAM",
        "Nutritional oedema" ;
    skos:broader state:ChildMalnutrition ;
    skos:definition "A recent or severe form of undernutrition characterized by wasting (weight-for-height more than two standard deviations below the WHO Child Growth Standards median, WHZ < -2 SD), low mid-upper arm circumference, or nutritional oedema, especially in children. Also known as Global Acute Malnutrition (GAM), the umbrella category comprising moderate and severe acute malnutrition." ;
    skos:inScheme state: ;
    skos:prefLabel "Acute malnutrition" ;
    skos:related state:Wasting ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

