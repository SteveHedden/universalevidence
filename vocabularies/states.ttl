state:PituitaryNeoplasms a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D010911> ;
    skos:broader state:EndocrineGlandNeoplasms ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D049912> ;
    skos:definition "Neoplasms which arise from or metastasize to the PITUITARY GLAND. The majority of pituitary neoplasms are adenomas, which are divided into non-secreting and secreting forms. Hormone producing forms are further classified by the type of hormone they secrete. Pituitary adenomas may also be characterized by their staining properties (see ADENOMA, BASOPHIL; ADENOMA, ACIDOPHIL; and ADENOMA, CHROMOPHOBE). Pituitary tumors may compress adjacent structures, including the HYPOTHALAMUS, several CRANIAL NERVES, and the OPTIC CHIASM. Chiasmal compression may result in bitemporal HEMIANOPSIA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D010911> ;
    skos:inScheme state: ;
    skos:prefLabel "Pituitary neoplasms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

