<https://universalevidence.com/vocab/states/SertoliCellOnlySyndrome>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D054331> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/GenitourinaryDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A type of male infertility in which no germ cells are visible in any of the biopsied SEMINIFEROUS TUBULES (type I) or in which germ cells are present in a minority of tubules (type II). Clinical features include AZOOSPERMIA, normal VIRILIZATION, and normal chromosomal complement." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D054331> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Sertoli cell-only syndrome" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:SertoliCellTumor a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:GermCellAndTrophoblasticNeoplasms ;
    skos:definition "A sex cord-stromal tumor arising from Sertoli cells, usually in the testis but occasionally in the ovary, with variable hormonal activity and malignant potential." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D012707> ;
    skos:inScheme state: ;
    skos:prefLabel "Sertoli cell tumor" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/SertoliLeydigCellTumor>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018310> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/OvarianCancer> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A sex cord-gonadal stromal tumor consists of LEYDIG CELLS; SERTOLI CELLS; and FIBROBLASTS in varying proportions and degree of differentiation. Most such tumors produce ANDROGENS in the Leydig cells, formerly known as androblastoma or arrhenoblastoma. Androblastomas occur in the TESTIS or the OVARY causing precocious masculinization in the males, and defeminization, or virilization (VIRILISM) in the females. In some cases, the Sertoli cells produce ESTROGENS." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018310> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Sertoli-Leydig cell tumor" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

