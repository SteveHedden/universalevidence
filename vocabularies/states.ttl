    skos:inScheme state: ;
    skos:prefLabel "Memory constraints" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:MemoryInterference a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-22"^^xsd:date ;
    skos:broader state:CognitiveProcessesAndAbilities ;
    skos:definition "A cognitive condition in which existing memories, new information, or competing cues disrupt the encoding, storage, or retrieval of other information. Memory interference can affect learning, recall, and decision making." ;
    skos:inScheme state: ;
    skos:prefLabel "Memory interference" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/MeniereDisease>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D008575> ;
