state:ContractEnforcement a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:EnforcementCapacity ;
    skos:definition "The institutional capacity and realized effectiveness of implementing, monitoring, and enforcing contractual obligations, rights, and remedies." ;
    skos:inScheme state: ;
    skos:prefLabel "Contract enforcement" ;
    skos:related state:ContractNonPerformance ;
    skos:scopeNote "Use only when evidence concerns whether or how contractual obligations or remedies are enforced. Exclude the existence, design, framing, terms, adoption, or take-up of contracts without enforcement evidence. Use EnforcementCapacity for policing, taxation, regulatory, environmental, or otherwise generic rule enforcement." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:ContractNonPerformance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:altLabel "contractual non-performance" ;
    skos:broader state:EconomicBehavior ;
    skos:definition "Failure, breach, or deviation by one or more parties from contractual obligations, service commitments, payment terms, or delivery requirements." ;
    skos:inScheme state: ;
    skos:prefLabel "Contract non-performance" ;
    skos:related state:ContractEnforcement ;
    skos:scopeNote "Use for a party's failure or deviation from an agreement, including efficient breach. Beliefs or information about contract performance are close evidence unless actual non-performance is measured. Use ContractEnforcement for institutions, practices, remedies, or capacity used to implement and enforce obligations." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

