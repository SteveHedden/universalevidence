<https://universalevidence.com/vocab/states/HIVWastingSyndrome>
    <http://purl.org/dc/terms/bibliographicCitation> "From Harrison's Principles of Internal Medicine, 13th ed, p1611" ;
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D019247> ;
