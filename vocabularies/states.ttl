state:CareEnrollment a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "enrollment into care",
        "linkage to care" ;
    skos:broader state:HealthServiceAndQualityOutcome ;
