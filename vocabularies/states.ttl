<https://universalevidence.com/vocab/states/HouseholdResourceAllocation>
    <http://purl.org/dc/terms/created> "2026-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Allocation within households" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Intra-household allocation" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/ResourceDistribution> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The realized distribution of money, goods, time, labor, care, or other allocable resources among members of a household." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "Allocation within housholds" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Household resource allocation" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/WomensDecisionMaking> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for realized intra-household resource distributions. Use HouseholdDecisionMaking for influence or authority over family choices, ConsumptionExpenditure for spending or consumption totals, and TimeUse when only allocation of time across activities is represented." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

