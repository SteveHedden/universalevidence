    <http://www.w3.org/2004/02/skos/core#definition> "Congenital absence of or defects in structures of the teeth." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D014071> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Tooth abnormalities" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:ToothAbrasion a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:DentalHardTissueAndDepositDisorders ;
    skos:definition "Mechanical loss of tooth structure from non-carious wear, often related to brushing, habits, dental appliances, or abrasive exposures." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014072> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth abrasion" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothAnkylosis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:ToothDevelopmentAndStructureDisorders ;
    skos:definition "Fusion of tooth root cementum or dentin to alveolar bone, leading to impaired tooth eruption or immobility." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020254> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth ankylosis" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothAttrition a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:ToothWear ;
    skos:definition "The presence or burden of tooth attrition as a health condition in an individual or population." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D019217> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth attrition" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothAvulsion a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:ToothDevelopmentAndStructureDisorders ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D016388> ;
    skos:definition "Complete displacement of a tooth from its socket, usually due to traumatic dental injury." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014084> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth avulsion" ;
    skos:scopeNote "Represents traumatic complete tooth displacement; placed under tooth development and structure disorders pending a dedicated dental trauma parent." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothDemineralization a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:DentalHardTissueAndDepositDisorders ;
    skos:definition "Loss of mineral content from tooth enamel or dentin, often preceding dental caries." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D017001> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth demineralization" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothDiseases a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:StomatognathicDiseases ;
