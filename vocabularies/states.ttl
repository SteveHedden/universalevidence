    skos:inScheme state: ;
    skos:prefLabel "Intestinal polyposis" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalPolyps a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:ColorectalAndIntestinalDiseases ;
    skos:definition "Polypoid growths projecting from the intestinal mucosa, with benign, premalignant, or malignant potential." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007417> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal polyps" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalPseudoObstruction a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:ColorectalAndIntestinalDiseases ;
