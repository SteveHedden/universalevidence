    skos:inScheme state: ;
    skos:prefLabel "Adolescent mental health" ;
    skos:related state:AdolescentHealth ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:AgriculturalInputAccess a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:broader state:AgriculturalSystemConditions ;

    skos:definition "Access to seeds, fertilizer, lime, equipment, or other inputs used in agricultural production." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural input access" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

state:AgriculturalInvestment a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:broader state:AgriculturalSystemConditions ;
    skos:definition "Investment in agricultural production, assets, technologies, or enterprises." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural investment" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> ;
    ue:measuredBy state:SDG2A1AgricultureOrientationIndex .

state:AgriculturalLearning a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:broader state:Learning ;
    skos:definition "Knowledge or skill acquisition, experimentation, belief updating, or learning by farmers and agricultural producers about production, technology, environmental conditions, and farm management." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural learning" ;
    skos:scopeNote "Use for demonstrated or explicitly measured agricultural knowledge, skills, experimentation, or belief updating. Training attendance, intention to attend, or access to agricultural information alone is only related evidence and does not establish learning." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

state:AgriculturalMarketAccess a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:broader state:AgriculturalSystemConditions ;

    skos:definition "Access to and participation in input, output, and value-chain markets by farmers, traders, firms, and other agricultural producers, including the ability to buy inputs and sell agricultural goods on usable terms." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural market access" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

state:AgriculturalTechnologyAdoption a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:broader state:TechnologyAdoption ;
    skos:definition "The uptake or use of agricultural technologies by farmers, firms, or agricultural systems." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural technology adoption" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

state:AgriculturalValueChainPerformance a skos:Concept,
