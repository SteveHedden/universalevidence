    skos:exactMatch <http://id.nlm.nih.gov/mesh/D018208> ;
    skos:inScheme state: ;
    skos:prefLabel "Myxoid liposarcoma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Myxoma a skos:Concept,
        ue:State ;
