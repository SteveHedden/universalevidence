    skos:definition "A non-neoplastic cyst of the MEIBOMIAN GLANDS of the eyelid." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D017043> ;
    skos:hiddenLabel "D017043" ;
    skos:inScheme state: ;
    skos:prefLabel "Chalazion" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Chancre a skos:Concept,
