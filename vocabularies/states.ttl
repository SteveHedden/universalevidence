<https://universalevidence.com/vocab/states/HolocarboxylaseSynthetaseDeficiency>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D028922> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/MultipleCarboxylaseDeficiency> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The neonatal form of MULTIPLE CARBOXYLASE DEFICIENCY that is caused by a defect or deficiency in holocarboxylase synthetase. HLCS is the enzyme that covalently links biotin to the biotin dependent carboxylases (propionyl-CoA-carboxylase, pyruvate carboxylase, and beta-methylcrotonyl-CoA carboxylase)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D028922> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Holocarboxylase synthetase deficiency" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Holoprosencephaly>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D016142> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CraniofacialDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Anterior midline brain, cranial, and facial malformations resulting from the failure of the embryonic prosencephalon to undergo segmentation and cleavage. Alobar prosencephaly is the most severe form and features anophthalmia; cyclopia; severe INTELLECTUAL DISABILITY; CLEFT LIP; CLEFT PALATE; SEIZURES; and microcephaly. Semilobar holoprosencepaly is characterized by hypotelorism, microphthalmia, coloboma, nasal malformations, and variable degrees of INTELLECTUAL DISABILITY. Lobar holoprosencephaly is associated with mild (or absent) facial malformations and intellectual abilities that range from mild INTELLECTUAL DISABILITY to normal. Holoprosencephaly is associated with CHROMOSOME ABNORMALITIES." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D016142> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Holoprosencephaly" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:HomeandCommunityEngagement a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:IndividualBehavior ;
    skos:definition "The extent to which individuals take part in purposeful, domestic, learning, social, leisure, communicative, or other everyday activities in home and community settings." ;
    skos:inScheme state: ;
    skos:altLabel "Home and community engagement",
        "Home and community participation" ;
    skos:prefLabel "Home and community activity engagement" ;
    skos:related state:CommunityCohesion ;
    skos:scopeNote "Use for observed or reported participation or activity level in home and community life, including clinically measured participation and restrictions in social, leisure, communicative, domestic, and community activities. Engagement here means actual involvement, not interest, motivation, attachment, or mere presence. Do not use for community-wide trust, solidarity, connectedness, or collective identity (CommunityCohesion); civic or local-governance participation (CommunityParticipation); cultural participation alone (CulturalParticipation); basic self-care alone (ActivitiesOfDailyLiving); or attendance/adherence to a treatment, service, study, or workplace program." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

