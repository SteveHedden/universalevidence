state:ProductQuality a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:PrivateSectorConditions ;
    skos:definition "Observed or perceived quality, safety, reliability, or performance of goods and services." ;
    skos:inScheme state: ;
    skos:prefLabel "Product quality" ;
    skos:scopeNote "Use for the inherent or perceived quality, safety, reliability, or performance of a good or service. Use Durability for expected physical lifespan and resistance to wear, failure, or degradation. Use InterventionAcceptability when the represented construct is whether intended users find an intervention or product satisfactory or usable, including wearability." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

