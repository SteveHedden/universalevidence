    dcterms:created "2026-06-03"^^xsd:date ;
    skos:broader state:Wellbeing ;
    skos:definition "Self-reported or measured equilibrium between an individual's work demands and personal life, including satisfaction with time for family, leisure, and rest. Commonly assessed in labour and wellbeing research." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072358> ;
    skos:example "Work-life balance scores among nurses before and after flexible scheduling interventions." ;
    skos:hiddenLabel "work life balance" ;
    skos:inScheme state: ;
    skos:prefLabel "Work-life balance" ;
    skos:related state:JobQuality,
        state:MentalHealth,
        state:WorkLifeImbalanceCondition ;
    skos:scopeNote "Use for the overall equilibrium between working life and private life. Use WorkFamilyBalance for the narrower compatibility of work with family or caregiving demands, WorkLifeImbalanceCondition for conflict or incompatibility between roles, and EmployeeEngagement for emotional commitment to and involvement in work or an organization." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

