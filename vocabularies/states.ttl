<https://universalevidence.com/vocab/states/Catalepsy>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002375> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/DisordersOfConsciousness> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A condition characterized by inactivity, decreased responsiveness to stimuli, and a tendency to maintain an immobile posture. The limbs tend to remain in whatever position they are placed (waxy flexibility). Catalepsy may be associated with PSYCHOTIC DISORDERS (e.g., SCHIZOPHRENIA, CATATONIC), nervous system drug toxicity, and other conditions." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002375> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Catalepsy" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Cataplexy>
    <http://purl.org/dc/terms/bibliographicCitation> "From Adams et al., Principles of Neurology, 6th ed, p396" ;
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002385> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Narcolepsy> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A brief episode of sudden loss of muscle tone, often triggered by emotion and commonly associated with narcolepsy." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002385> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Cataplexy" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CatastrophicIllness>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002388> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/GeneralConstitutionalSymptoms> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An acute or prolonged illness usually considered to be life-threatening or with the threat of serious residual disability. Treatment may be radical and is frequently costly." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002388> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Catastrophic illness" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Catatonia>
    <http://purl.org/dc/terms/bibliographicCitation> "From DSM-IV, 4th ed, 1994; APA, Thesaurus of Psychological Index Terms, 1994" ;
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002389> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/DisordersOfConsciousness> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A neuropsychiatric syndrome involving marked disturbances of movement, responsiveness, and behavior, which may occur with psychiatric or medical illness." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002389> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Catatonia" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

