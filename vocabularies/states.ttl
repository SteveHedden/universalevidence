state:AbducensNerveDiseases a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020434> ;
    skos:broader state:CranialNerveDiseases ;
    skos:definition "Diseases of the sixth cranial (abducens) nerve or its nucleus in the pons. The nerve may be injured along its course in the pons, intracranially as it travels along the base of the brain, in the cavernous sinus, or at the level of superior orbital fissure or orbit. Dysfunction of the nerve causes lateral rectus muscle weakness, resulting in horizontal diplopia that is maximal when the affected eye is abducted and ESOTROPIA. Common conditions associated with nerve injury include INTRACRANIAL HYPERTENSION; CRANIOCEREBRAL TRAUMA; ISCHEMIA; and INFRATENTORIAL NEOPLASMS." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020434> ;
    skos:hiddenLabel "D020434" ;
    skos:inScheme state: ;
    skos:prefLabel "Abducens nerve diseases" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:AbducensNerveInjury a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020222> ;
    skos:broader state:CranialNerveDiseases ;
    skos:definition "Traumatic injury to the abducens, or sixth, cranial nerve. Injury to this nerve results in lateral rectus muscle weakness or paralysis. The nerve may be damaged by closed or penetrating CRANIOCEREBRAL TRAUMA or by facial trauma involving the orbit." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020222> ;
    skos:hiddenLabel "D020222" ;
    skos:inScheme state: ;
    skos:prefLabel "Abducens nerve injury" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

