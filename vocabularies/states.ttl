state:PentalogyOfCantrell a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D058502> ;
    skos:broader state:CongenitalCardiopulmonaryAndVascularAbnormalities ;
    skos:definition "Rare congenital deformity syndrome characterized by a combination of five anomalies as a result of neural tube defect. The five anomalies are a midline supraumbilical abdominal wall defect (e.g., OMPHALOCELE), a lower STERNUM defect, a congenital intracardiac defect, an anterior DIAPHRAGM defect, and a diaphragmatic PERICARDIUM defect (e.g., PERICARDIAL EFFUSION). Variants with incomplete and variable combinations of the defects are known. ECTOPIA CORDIS; CLEFT LIP; and CLEFT PALATE are often associated with the syndrome." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D058502> ;
    skos:inScheme state: ;
    skos:prefLabel "Pentalogy of Cantrell" ;
