    skos:exactMatch <http://id.nlm.nih.gov/mesh/D012128> ;
    skos:inScheme state: ;
    skos:prefLabel "ARDS" ;
    skos:scopeNote "Use for acute respiratory distress syndrome, including adult and pediatric forms. Do not use for neonatal respiratory distress syndrome or severe acute respiratory syndrome (SARS)." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

