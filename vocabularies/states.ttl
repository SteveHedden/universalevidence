<https://universalevidence.com/vocab/states/Myocarditis>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D009205> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Cardiomyopathies> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Inflammatory processes of the muscular walls of the heart (MYOCARDIUM) which result in injury to the cardiac muscle cells (MYOCYTES, CARDIAC). Manifestations range from subclinical to sudden death (DEATH, SUDDEN). Myocarditis in association with cardiac dysfunction is classified as inflammatory CARDIOMYOPATHY usually caused by INFECTION, autoimmune diseases, or responses to toxic substances. Myocarditis is also a common cause of DILATED CARDIOMYOPATHY and other cardiomyopathies." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D009205> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Myocarditis" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/MyoclonicCerebellarDyssynergia>
    <http://purl.org/dc/terms/bibliographicCitation> "From Joynt, Clinical Neurology, 1991, Ch37, pp60-1" ;
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002527> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/MovementDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A neurological condition combining progressive cerebellar incoordination with involuntary brief muscle jerks." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002527> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Myoclonic cerebellar dyssynergia" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:MyoclonicEpilepsies a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:altLabel "Epilepsies, Myoclonic" ;
    skos:broader state:EpilepticSyndromes ;
    skos:definition "A clinically diverse group of epilepsy syndromes characterized by myoclonic seizures or by myoclonus occurring with other seizure types." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D004831> ;
    skos:inScheme state: ;
    skos:prefLabel "Myoclonic epilepsies" ;
    skos:scopeNote "Use for the broad family of myoclonic epilepsy syndromes, including progressive and juvenile subfamilies. Exclude isolated myoclonus without an epilepsy syndrome." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:MyoclonicEpilepsiesProgressive a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "Myoclonic Epilepsies, Progressive",
        "progressive myoclonic epilepsy",
        "progressive myoclonus epilepsies" ;
    skos:broader state:MyoclonicEpilepsies ;
    skos:definition "A heterogeneous group of primarily familial myoclonic epilepsy disorders characterized by myoclonic and tonic-clonic seizures together with progressive neurologic deterioration, which may include ataxia, intellectual decline, and neuronal degeneration." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020191> ;
    skos:inScheme state: ;
    skos:prefLabel "Progressive myoclonic epilepsies" ;
    skos:scopeNote "Use only for progressive myoclonic epilepsy disorders such as Lafora disease, MERRF syndrome, neuronal ceroid-lipofuscinosis, sialidosis, and Unverricht-Lundborg syndrome. Exclude nonprogressive myoclonic epilepsy syndromes and isolated myoclonus." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Myoclonus a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:broader state:Dyskinesias ;
    skos:definition "Sudden brief involuntary muscle jerks caused by abnormal nervous system activity." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D009207> ;
    skos:inScheme state: ;
    skos:prefLabel "Myoclonus" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Myoepithelioma>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D009208> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/GlandularAndEpithelialNeoplasms> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A usually benign tumor made up predominantly of myoepithelial cells." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D009208> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Myoepithelioma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/MyofascialPainSyndromes>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D009209> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/MusculoskeletalDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Muscular pain in numerous body regions that can be reproduced by pressure on TRIGGER POINTS, localized hardenings in skeletal muscle tissue. Pain is referred to a location distant from the trigger points. A prime example is the TEMPOROMANDIBULAR JOINT DYSFUNCTION SYNDROME." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D009209> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Myofascial pain syndromes" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:Myofibroma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:Fibroma ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D018224> ;
    skos:definition "A benign tumor composed of myofibroblastic cells, usually presenting as a solitary nodule in skin, soft tissue, bone, or visceral sites, most often in infants and young children." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D047708> ;
    skos:inScheme state: ;
    skos:prefLabel "Myofibroma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Myofibromatosis a skos:Concept,
        ue:State ;
