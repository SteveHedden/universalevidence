state:ProfitSharing a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:FinancialContractTerms ;
    skos:definition "The contractual entitlement of workers or other participants to receive a specified share of realized profits, net proceeds, or surplus." ;
    skos:inScheme state: ;
    skos:prefLabel "Profit sharing" ;
    skos:scopeNote "Use for the standing allocation rule or entitlement, whether or not profits are realized in a period. Use Wages or another earnings concept for amounts actually paid, and the intervention taxonomy for deliberate introduction or modification of a profit-sharing scheme." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Progeria>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D011371> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CongenitalMultisystemMalformationSyndromes> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An abnormal congenital condition, associated with defects in the LAMIN TYPE A gene, which is characterized by premature aging in children, where all the changes of cell senescence occur. It is manifested by premature graying; hair loss; hearing loss (DEAFNESS); cataracts (CATARACT); ARTHRITIS; OSTEOPOROSIS; DIABETES MELLITUS; atrophy of subcutaneous fat; skeletal hypoplasia; elevated urinary HYALURONIC ACID; and accelerated ATHEROSCLEROSIS. Many affected individuals develop malignant tumors, especially SARCOMA." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D011371> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Progeria" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

