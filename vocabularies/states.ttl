    <http://www.w3.org/2004/02/skos/core#definition> "Signs resembling meningeal irritation, such as neck stiffness and headache, without established inflammation of the meninges." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D008580> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Meningism" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:Meningitis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:NeuroinflammatoryDiseases ;
    skos:definition "Inflammation of the coverings of the brain or spinal cord, including the pia mater, arachnoid, and dura mater." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D008581> ;
    skos:inScheme state: ;
    skos:prefLabel "Meningitis" ;
    skos:scopeNote "Use for general or unspecified meningitis; prefer a represented infectious, anatomical, or other specific form when stated. In UE's monohierarchy, some infectious forms remain classified under their causal infection branch." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Meningocele>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D008588> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/NervousSystemMalformations> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A congenital or acquired protrusion of the meninges, unaccompanied by neural tissue, through a bony defect in the skull or vertebral column." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D008588> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Meningocele" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

