    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Greenwashing" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/PrivateSector> .

