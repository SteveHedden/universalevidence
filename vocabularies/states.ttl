state:DigitalInnovation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:TechnologyAdoption ;
    skos:definition "The condition of firms or markets with respect to developing, adopting, or spreading new digital products, services, practices, or business models." ;
    skos:scopeNote "Use when the innovation is explicitly digital and is represented as a private-sector condition. Use InnovationManagement for generic organizational innovation capacity or practices, IdeaGeneration for producing novel proposals or concepts, TechnologyAdoption for uptake of a technology, and InnovationDiffusion for spread across people, organizations, or places." ;
    skos:inScheme state: ;
    skos:prefLabel "Digital innovation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

