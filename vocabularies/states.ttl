<https://universalevidence.com/vocab/states/AlcoholicCardiomyopathy>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002310> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Cardiomyopathy, Alcoholic" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HeartDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Disease of CARDIAC MUSCLE resulting from chronic excessive alcohol consumption. Myocardial damage can be caused by: (1) a toxic effect of alcohol; (2) malnutrition in alcoholics such as THIAMINE DEFICIENCY; or (3) toxic effect of additives in alcoholic beverages such as COBALT. This disease is usually manifested by DYSPNEA and palpitations with CARDIOMEGALY and congestive heart failure (HEART FAILURE)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002310> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Alcoholic cardiomyopathy" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:AlcoholicFattyLiverDisease a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:altLabel "Fatty Liver, Alcoholic" ;
    skos:broader state:HepaticAndBiliaryDiseases ;
    skos:definition "A health state characterized by alcoholic fatty liver disease." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D005235> ;
