state:MedicationDiscontinuationDueToAdverseEvents a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "treatment discontinuation due to adverse events" ;
    skos:broader state:HealthBehavior ;
    skos:definition "Stopping an administered medication, vaccine, or preventive product because an adverse event, side effect, intolerance, or toxicity is attributed to it." ;
    skos:inScheme state: ;
    skos:prefLabel "Medication discontinuation due to adverse events" ;
    skos:scopeNote "Use only when an adverse event, side effect, intolerance, or toxicity causes product discontinuation. Excludes all-cause or unspecified discontinuation, withdrawal from a study without product cessation, adverse events merely observed after discontinuation, and discontinuation for lack of efficacy, treatment failure, or disease progression." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

