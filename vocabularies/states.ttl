state:LeadPoisoning a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:HeavyMetalPoisoning ;
    skos:definition "Systemic toxic effects resulting from lead exposure, potentially affecting neurologic, hematologic, renal, gastrointestinal, cardiovascular, reproductive, or developmental function." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007855> ;
    skos:inScheme state: ;
    skos:prefLabel "Lead poisoning" ;
