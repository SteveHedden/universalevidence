    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

<https://universalevidence.com/vocab/states/MultibacillaryLeprosy>
    <http://purl.org/dc/terms/created> "2026-06-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D056006> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Leprosy, Multibacillary" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/MycobacteriumInfections> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A form of LEPROSY classified by the World Health Organization for the purpose of treatment, based on clinical manifestations and skin smear results. Patients with multibacillary leprosy have six or more lesions with or without positive skin smear results for the causative agent MYCOBACTERIUM LEPRAE. Multibacillary leprosy encompasses borderline lepromatous, midborderline, and lepromatous leprosy." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D056006> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Multibacillary leprosy" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:MultidimensionalDeprivation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:EconomicStatus ;
    skos:definition "Deficits experienced across multiple wellbeing dimensions, considered individually or jointly without requiring classification above a poverty cutoff." ;
    skos:inScheme state: ;
    skos:prefLabel "Multidimensional deprivation" ;
    skos:scopeNote "Use when evidence combines or jointly considers deprivation across multiple wellbeing dimensions; a single deprivation domain or the unqualified word deprivation is only a close match. Use SocioeconomicDisadvantage for a lower position spanning social and economic dimensions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

