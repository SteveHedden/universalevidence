<https://universalevidence.com/vocab/states/>
    <http://purl.org/dc/terms/creator> "Steve Hedden" ;
    <http://purl.org/dc/terms/description> "States of people and systems, together with indicators used to measure those states. States can be condition topics or outcome topics in evidence records." ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
    <http://purl.org/dc/terms/modified> "2026-07-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/title> "Universal Evidence — States Thesaurus" ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2002/07/owl#versionInfo> "0.2.0" .

state:PrivateSectorConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of firms, markets, and enterprises -- private-sector or state-owned -- including performance, governance, formalization, competition, and entrepreneurial activity." ;
    skos:inScheme state: ;
    skos:prefLabel "Private sector conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:GovernanceSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions, capacities, rules, processes, and institutional arrangements through which public authority is exercised and collective decisions are made or implemented, including administration, accountability, corruption, elections, law, policy, public finance, and international relations." ;
    skos:inScheme state: ;
    skos:prefLabel "Governance system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:InfrastructureConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of physical, digital, and service infrastructure that populations depend on, including energy, transport, settlements, and connectivity." ;
    skos:inScheme state: ;
    skos:prefLabel "Infrastructure conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Infrastructure> ;
    ue:measuredBy state:BuildingEnergyRating,
        state:SubmeteringCoverage,
        state:WDIEGELCRNWXKH .

state:FinancialSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of financial institutions, markets, and public financial management, including stability, credit, and resource flows." ;
    skos:inScheme state: ;
    skos:prefLabel "Financial system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/FinancialSystem> .

state:HealthSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of health-service delivery systems, including quality, equity, diagnostics, and treatment outcomes, as distinct from the health status of the population they serve." ;
    skos:inScheme state: ;
    skos:prefLabel "Health system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

state:AgriculturalSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of agricultural and food systems, including productivity, safety, and structural transformation." ;
    skos:inScheme state: ;
    skos:prefLabel "Agricultural system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/AgriculturalSystem> .

state:LaborMarketConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of labor markets, including employment, job quality, and work arrangements." ;
    skos:inScheme state: ;
    skos:prefLabel "Labor market conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:BiodiversitySystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of ecosystems and the variety of species, genetic resources, and habitats they contain, including loss, degradation, and pollution pressures." ;
    skos:inScheme state: ;
    skos:prefLabel "Biodiversity system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Biodiversity> .

state:LandSoilConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Conditions of terrestrial land surface and soil systems, including contamination, degradation, and land use change." ;
    skos:inScheme state: ;
    skos:prefLabel "Land and soil conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LandSoil> .

state:WaterSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Physical, ecological, availability, use, stewardship, and management conditions of freshwater, groundwater, watershed, and coastal water systems, including pollution, contamination, conservation, and hydrological disruption." ;
    skos:inScheme state: ;
    skos:prefLabel "Water system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/WaterSystem> .

state:CognitiveProcessesAndAbilities a skos:Concept,
        ue:State ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:broader state:PsychologicalAndBehavioralStatus ;
    skos:definition "Cognitive capacities and processes involving attention, memory, reasoning, information processing, knowledge, and visual-spatial cognition." ;
    skos:inScheme state: ;
    skos:prefLabel "Cognitive processes and abilities" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:InformationEnvironmentConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-01"^^xsd:date ;
    skos:definition "Conditions governing how information is available, observable, distributed, signaled, and encountered by people, organizations, or systems, including information asymmetries and misleading content." ;
    skos:inScheme state: ;
    skos:prefLabel "Information environment conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:FinancialContractTerms a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-01"^^xsd:date ;
    skos:broader state:FinancialSystemConditions ;
    skos:definition "The rules, pricing, obligations, restrictions, and enforcement provisions attached to financial products or agreements." ;
    skos:inScheme state: ;
    skos:prefLabel "Financial contract terms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/FinancialSystem> .

state:Savings a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-01"^^xsd:date ;
    skos:broader state:HouseholdFinance ;
    skos:definition "The condition of people or households with respect to setting aside or holding money or other liquid financial resources for future use, including amounts, frequency, purposes, accounts, buffers, and barriers to saving." ;
    skos:inScheme state: ;
    skos:prefLabel "Savings" ;
    skos:scopeNote "Use for actual saving behavior, accumulated savings, savings goals, and savings constraints. Use EmergencySavings only when an emergency or unexpected-expense buffer is explicit, TaxTimeSavings when tax filing or tax-refund receipt is explicit, TaxFavoredSavings for tax-advantaged arrangements, InvestingBehavior for broader portfolio or investment behavior, and CostPerceptions for beliefs about costs." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:FinancialLiteracy a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-01"^^xsd:date ;
    skos:broader state:AwarenessKnowledge ;
    skos:definition "Knowledge and understanding used to evaluate and apply concepts concerning budgeting, saving, borrowing, interest, inflation, risk, insurance, investment, and financial products." ;
    skos:inScheme state: ;
    skos:prefLabel "Financial literacy" ;
    skos:scopeNote "Use for personal, household, or business financial knowledge and financial-literacy assessments. Use FinancialCapability for the broader bundle of knowledge, skills, resources, access, and confidence; EconomicLiteracy for macroeconomic, market, and policy knowledge; and financial-behavior concepts for observed saving, borrowing, investing, or budgeting actions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Survival dcterms:created "2026-08-01"^^xsd:date ;
    a skos:Concept,
        ue:State ;
    skos:altLabel "Disease-free survival",
        "Event-free survival",
        "Overall survival",
        "Progression-free survival",
        "Survival rate" ;
    skos:broader state:PopulationHealthStatus ;
    skos:definition "The duration, status, or probability of a person or population remaining alive over a defined period and, where specified, remaining free of disease progression, recurrence, or another qualifying clinical event." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Survival" ;
    skos:related state:SurvivalInCare ;
    skos:scopeNote "Use for overall, patient, hospital, disease-free, event-free, progression-free, recurrence-free, or other clinical time-to-event survival outcomes. Use CancerSurvivorship for the lived post-diagnosis condition and needs of cancer survivors, SurvivalInCare only when being alive and retained in care are jointly required, Mortality for deaths or death rates, and Durability for product, implant, or device survivorship. Exclude contractual or organizational survival." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:WDISPDYNTO65FEZS .

state:SevereStunting a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-06"^^xsd:date ;
    skos:altLabel "Severe linear growth retardation" ;
    skos:broader state:Stunting ;
    skos:definition "A more severe form of stunting in children, defined as height-for-age (or length-for-age) more than three standard deviations below the WHO Child Growth Standards median, reflecting profound chronic undernutrition." ;
    skos:inScheme state: ;
    skos:prefLabel "Severe stunting" ;
    skos:scopeNote "Use only when the severe category or a height-for-age or length-for-age threshold below -3 standard deviations is explicit. Use Stunting for the broader below -2 category or unqualified stunting." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:FiscalGovernanceConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:GovernanceSystemConditions ;
    skos:definition "Conditions of public revenue, taxation, budgeting, debt, and fiscal-policy design and execution within a governance system." ;
    skos:inScheme state: ;
    skos:prefLabel "Fiscal governance conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:JusticeAndLegalSystemConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:GovernanceSystemConditions ;
    skos:definition "Conditions of legal frameworks, courts, adjudication, enforcement, prosecution, detention, and other institutions through which law and justice are administered." ;
    skos:inScheme state: ;
    skos:prefLabel "Justice and legal system conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:ElectoralGovernanceConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:GovernanceSystemConditions ;
    skos:definition "Conditions of electoral rules, finance, accountability, integrity, and exchanges that shape how elections translate citizen choices into public authority." ;
    skos:inScheme state: ;
    skos:prefLabel "Electoral governance conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:CivicSpaceConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:GovernanceSystemConditions ;
    skos:definition "Conditions affecting the capacity and freedom of civil society, media, and research communities to organize, communicate, scrutinize authority, and participate in public life." ;
    skos:inScheme state: ;
    skos:prefLabel "Civic space conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

state:PreferenceFormationAndEvaluation a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:PreferencesAndValuation ;
    skos:definition "Conditions and processes through which preferences are formed, revised, contextually expressed, weighted, appraised, or accepted." ;
    skos:inScheme state: ;
    skos:prefLabel "Preference formation and evaluation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:SocialAndMoralPreferences a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:PreferencesAndValuation ;
    skos:definition "Preferences concerning fairness, distribution, morality, deservingness, prosocial or antisocial conduct, and the welfare of others." ;
    skos:inScheme state: ;
    skos:prefLabel "Social and moral preferences" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:EconomicAndPolicyPreferences a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:PreferencesAndValuation ;
    skos:definition "Preferences and valuations concerning products, costs, prices, taxes, trade, public policy, immigration, and willingness to pay." ;
    skos:inScheme state: ;
    skos:prefLabel "Economic and policy preferences" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ActorAndContextSpecificPreferences a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:PreferencesAndValuation ;
    skos:definition "Preferences distinguished by the actor or setting in which they are held, including individual, household, community, managerial, partner, user, and workplace preferences." ;
    skos:inScheme state: ;
    skos:prefLabel "Actor- and context-specific preferences" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BoneFractureConditions a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:BoneDiseases ;
    skos:definition "Fractures and conditions defined by the location, occurrence, healing, or persistence of a bone fracture." ;
    skos:inScheme state: ;
    skos:prefLabel "Bone fracture conditions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:UrinaryStoneDisease a skos:Concept,
        ue:State ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader state:RenalDiseases ;
    skos:definition "Conditions involving calculi in the kidney or ureter and their associated clinical manifestations." ;
    skos:inScheme state: ; skos:prefLabel "Urinary stone disease" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .


state:ContraceptiveUse dcterms:created "2026-09-07"^^xsd:date ;
    dcterms:source <https://www.who.int/data/gho/indicator-metadata-registry/imr-details/contraceptive-prevalence---any-modern-method-%28among-women-aged-15-49-years%29> ;
    a skos:Concept,
        ue:State ;
    skos:broader state:HealthBehavior ;
    skos:definition "The extent to which people or their partners currently use contraceptive methods to prevent pregnancy." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Contraceptive use" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:ContraceptivePrevalence,
        state:WDISPDYNCONMQ2ZS .


state:DevelopingCountryInstitutionalRepresentation dcterms:created "2026-09-07"^^xsd:date ;
    dcterms:source <https://unstats.un.org/sdgs/metadata/> ;
    a skos:Concept,
        ue:State ;
    skos:broader state:PoliticalParticipation ;
    skos:definition "The extent of developing countries' membership and decision-making representation in international organizations." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Developing-country institutional representation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
    ue:measuredBy state:DevelopingCountryVotingRightsShare,
        state:SDG1681DevelopingCountryVotingRightsShare .


state:DisasterRiskReductionStrategyImplementation dcterms:created "2026-09-07"^^xsd:date ;
    dcterms:source <https://unstats.un.org/sdgs/metadata/> ;
    a skos:Concept,
        ue:State ;
    skos:broader state:GovernanceSystemConditions ;
    skos:definition "The presence and implementation of national disaster risk reduction strategies aligned with the Sendai Framework." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Disaster risk reduction strategy implementation" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
    ue:measuredBy state:NationalDisasterRiskReductionStrategyAdoptionRate,
        state:SDG153NationalDisasterRiskStrategyAdoption .


state:MaterialResourceDemand dcterms:created "2026-09-07"^^xsd:date ;
    dcterms:source <https://www.unep.org/indicator-841> ;
    a skos:Concept,
        ue:State ;
    skos:broader state:ConsumptionPatterns ;
    skos:definition "The demand for extracted raw materials attributable to the final consumption of a population or economy, including biomass, fossil fuels, metals and non-metallic minerals." ;
    skos:inScheme <https://universalevidence.com/vocab/states/> ;
    skos:prefLabel "Material resource demand" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:MaterialFootprint,
        state:SDG841MaterialFootprint .


state:JobSatisfaction a skos:Concept, ue:State ;
    dcterms:created "2026-09-07"^^xsd:date ;
    skos:prefLabel "Job satisfaction" ;
    skos:altLabel "Work satisfaction" ;
    skos:definition "A person's appraisal of and satisfaction with their job and working situation." ;
    skos:scopeNote "Distinguish workers' experience of employment from users' experience of a service." ;
    skos:broader state:Wellbeing ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007588> ;
    skos:inScheme state: ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:InterventionFeasibility a skos:Concept, ue:State ;
    dcterms:created "2026-09-07"^^xsd:date ;
    dcterms:source <https://doi.org/10.1007/s10488-010-0319-7> ;
    skos:prefLabel "Intervention feasibility" ;
    skos:definition "The practical capability of a health-service setting to carry out a clinical intervention with its available resources and operating conditions." ;
    skos:scopeNote "A contextual capability of the delivery setting, distinct from user satisfaction, clinical effectiveness and the act of implementation. Use specific measurements as Indicators when a named scale or rate is supplied." ;
    skos:broader state:HealthSystemConditions ;
    skos:inScheme state: ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

<https://universalevidence.com/vocab/states/HospitalServiceUse>
    <http://purl.org/dc/terms/source> <https://meshb.nlm.nih.gov/record/ui?ui=D006760> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HealthServiceAndQualityOutcome> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The extent and pattern of use of inpatient hospital services within a health system, including admissions, readmissions, and time spent receiving inpatient care." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Hospital service use" ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://id.nlm.nih.gov/mesh/D006760> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "A health-system utilization state. Counts of admissions, readmission rates, and length of stay are distinct measurements of this state; this concept does not equate them or represent an educational admission." ;
