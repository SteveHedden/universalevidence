    skos:altLabel "agricultural biodiversity",
        "genetic diversity in agriculture" ;
    skos:broader state:BiodiversitySystemConditions ;
    skos:definition "The diversity of crops, livestock, seeds, genetic resources, and associated species that support agricultural production systems." ;
