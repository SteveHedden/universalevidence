    <http://purl.org/dc/terms/bibliographicCitation> "Holland et al., Cancer Medicine, 3d ed, p1245" ;
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D015266> ;
