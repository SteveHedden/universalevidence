<https://universalevidence.com/vocab/states/CentralNervousSystemVenousAngioma>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D020787> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CerebrovascularDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A vascular anomaly characterized by a radial or wedge-shaped arrangement of dilated VEINS draining into a larger vein in the brain, spinal cord, or the meninges. Veins in a venous angioma are surrounded by normal nervous tissue, unlike a CENTRAL NERVOUS SYSTEM CAVERNOUS HEMANGIOMA that lacks intervening nervous tissue. Drainage of venous angioma is fully integrated with the body's venous system, therefore, in most cases there is no clinical signs and rare bleeding." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D020787> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D020787" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Central nervous system venous angioma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CentralNervousSystemViralDiseases>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D020805> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CentralNervousSystemInfections> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Viral infections of the brain, spinal cord, meninges, or perimeningeal spaces." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D020805> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D020805" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Central nervous system viral diseases" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

