state:Durability a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    skos:broader state:ProductQuality ;
    skos:definition "The expected usable life and resistance to wear, failure, loss of function, or physical degradation of a manufactured product, device, or component under intended use." ;
    skos:inScheme state: ;
    skos:altLabel "Device durability" ;
    skos:prefLabel "Product durability" ;
    skos:scopeNote "Use for expected physical product or device lifespan and resistance to wear, failure, loss of function, or degradation. Do not use for wearability, usability, comfort, or user satisfaction; use InterventionAcceptability for whether an intervention or product is satisfactory or usable. Excludes persistence of treatment effects or clinical responses, durability of surgical or procedural effects, and the resilience or continuity of infrastructure, services, organizations, or systems." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

