    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:ServiceRobotAdoption a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "service robot adoption" ;
    skos:broader state:TechnologyAdoption ;
    skos:definition "The installation and operational deployment of service robots by firms or service providers to perform service tasks or interact with customers, patients, or other users." ;
    skos:inScheme state: ;
    skos:prefLabel "Service robot deployment" ;
    skos:related state:AIAcceptance,
        state:AIAdoption,
        state:AutomationExposure ;
    skos:scopeNote "Use for provider-side deployment as an organizational technology-adoption state. Do not use for consumer or worker willingness, trust, or intention to use a robot; direct interaction with an experimentally assigned robot when no adoption or deployment occurs; generic robot exposure; or downstream outcomes such as customer satisfaction, cooperation, labor supply, or firm performance." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

