state:Bias a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "A systematic tendency or distortion -- in perception, judgment, decision-making, or behavior, or in how samples, observations, or reports are selected, recalled, or recorded -- that departs from accurate or impartial evaluation. Covers both psychological/cognitive biases and measurement or methodological biases (e.g. selection, recall, response, or reporting bias) that produce a non-representative or skewed result." ;
    skos:inScheme state: ;
    skos:prefLabel "Bias" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    skos:broader state:PsychologicalAndBehavioralStatus .

