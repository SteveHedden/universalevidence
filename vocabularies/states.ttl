state:AlertFatigueCondition a skos:Concept,
        ue:State ;
    skos:altLabel "alarm fatigue",
        "clinical alert fatigue" ;
    skos:broader state:HealthServiceAndQualityOutcome ;
    skos:definition "The persistent desensitization of health personnel to clinical decision support alerts and alarms due to excessive frequency, leading to ignored or overridden warnings and increased risk of patient harm." ;
