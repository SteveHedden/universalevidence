state:AbsenceEpilepsy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-14"^^xsd:date ;
    skos:altLabel "Epilepsy, Absence",
        "Petit mal epilepsy" ;
    skos:broader state:EpilepticSyndromes ;
    skos:definition "A generalized epilepsy syndrome characterized by recurrent absence seizures with brief impairment of awareness and characteristic generalized spike-and-wave electroencephalographic activity." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D004832> ;
    skos:inScheme state: ;
    skos:prefLabel "Absence epilepsy" ;
    skos:related state:GeneralizedEpilepsy ;
    skos:scopeNote "Use only when absence epilepsy, petit mal epilepsy, or an absence-seizure syndrome is explicit. Generic epilepsy, seizure detection, EEG performance, and other focal or generalized epilepsy forms do not imply absence epilepsy." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

