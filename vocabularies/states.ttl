state:AlagilleSyndrome a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D016738> ;
    skos:broader state:CongenitalMultisystemMalformationSyndromes ;
    skos:definition "A multisystem disorder that is characterized by aplasia of intrahepatic bile ducts (BILE DUCTS, INTRAHEPATIC), and malformations in the cardiovascular system, the eyes, the vertebral column, and the facies. Major clinical features include JAUNDICE, and congenital heart disease with peripheral PULMONARY STENOSIS. Alagille syndrome may result from heterogeneous gene mutations, including mutations in JAG1 on CHROMOSOME 20 (Type 1) and NOTCH2 on CHROMOSOME 1 (Type 2)." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D016738> ;
    skos:hiddenLabel "D016738" ;
    skos:inScheme state: ;
    skos:prefLabel "Alagille syndrome" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:AlbinismOcular a skos:Concept,
