<https://universalevidence.com/vocab/states/LabourRightsDeficit>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Labor rights violations" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Right to Work" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Worker rights gaps" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HumanRightsViolations> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D000081202> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The condition or incidence of failures to uphold workers' legal and fundamental rights, including rights to wages and compensation owed, freedom of association and collective bargaining, non-discrimination, and protection from forced and child labour." ;
    <http://www.w3.org/2004/02/skos/core#example> "Widespread suppression of trade union activity and denial of collective bargaining in export processing zones." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "labor rights" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "labour rights" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Labour rights deficits" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/OccupationalInjury> ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#16070> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers violations of compensation protections and ILO fundamental principles and rights at work; ForcedLabor and ChildLabor are narrower forms." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/SDG882LabourRightsCompliance> .

