state:PatientReportedOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "PROMs",
        "PROs",
        "patient-reported outcome",
        "patient-reported outcomes" ;
    skos:definition "A standardized instrument or measure through which patients directly report their health status, symptoms, functioning, quality of life, or treatment impact without clinician interpretation." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071066> ;
    skos:example "PROMIS-29 or EQ-5D scores reported directly by trial participants." ;
    skos:hiddenLabel "patient reported outcome measure",
        "patient reported outcome measures",
        "patient reported outcomes",
        "self-reported health outcome measure" ;
    skos:inScheme state: ;
    skos:prefLabel "Patient-reported outcome measures" ;
    skos:scopeNote "Use for explicitly named PROM/PRO measure classes and named standardized instruments whose purpose is direct patient report. Map standalone symptoms, functioning, quality of life, satisfaction, perceived health, and other reported constructs to the state they measure. Do not use merely because an outcome concerns a patient or was obtained by questionnaire, self-report, proxy report, clinical record, or clinician assessment." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:PopulationHealthStatus .

state:ProfessionalPracticeGaps a skos:Concept,
        ue:State ;
    skos:altLabel "Missed Diagnosis",
        "clinical practice gaps",
        "practice gaps" ;
    skos:broader state:HealthServiceAndQualityOutcome ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000068616>,
        <http://id.nlm.nih.gov/mesh/D000081006>,
        <http://id.nlm.nih.gov/mesh/D000094505>,
        <http://id.nlm.nih.gov/mesh/D000096402>,
        <https://unstats.un.org/sdgs/target/4_c> ;
    skos:definition "The persistent discrepancy between current evidence-based standards of care or professional competencies and the actual practices, knowledge, or skills exhibited by health or other professionals." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071836> ;
    skos:example "Surveys showing that clinicians inadequately follow guidelines for antibiotic stewardship, constituting a practice gap." ;
    skos:hiddenLabel "competency gaps",
        "performance gaps" ;
    skos:inScheme state: ;
    skos:prefLabel "Professional practice gaps" ;
    skos:related state:Undertreatment ;
    skos:scopeNote "Refers to the condition of suboptimal professional practice at a system or workforce level; distinct from individual malpractice or adverse events." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

state:RadiationExposure a skos:Concept,
        ue:State ;
    skos:altLabel "ionizing radiation exposure",
        "radiation dose received",
        "radiation hazard",
        "radiation health effects" ;
    skos:broader state:PoisoningAndToxicExposure ;
    skos:definition "The presence, extent, or persistence of an individual's or population's exposure to ionizing or non-ionizing radiation, as a standing health hazard condition." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069079> ;
    skos:example "Measuring cumulative radiation dose among radiology workers and linking to cancer outcomes.",
        "Measuring excess cancer incidence in populations living near nuclear facilities due to chronic low-level radiation exposure." ;
    skos:hiddenLabel "radiation exposure level",
        "radiation harm",
        "radiation risk",
        "radiological dose" ;
    skos:inScheme state: ;
    skos:prefLabel "Radiation exposure" ;
    skos:related state:AccidentIncidence,
        state:DisasterRisk,
        state:OccupationalInjury ;
    skos:scopeNote "Covers radiation as a persistent health hazard condition; distinct from disaster risk where radiation is an acute emergency event." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:RadiationDoseDeliveryAccuracy .

state:ResearchCensorship a skos:Concept,
        ue:State ;
    skos:altLabel "academic censorship",
        "scientific censorship" ;
    skos:broader state:CivicSpaceConditions ;
    skos:definition "The persistent suppression, restriction, or distortion of scientific research findings and dissemination by governments, institutions, or other actors, undermining evidence-based policy and academic freedom." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068597> ;
    skos:example "Government suppression of epidemiological data during disease outbreaks limiting public health response." ;
    skos:hiddenLabel "research suppression" ;
    skos:inScheme state: ;
    skos:prefLabel "Research censorship" ;
    skos:related state:AcademicIntegrityFailure,
        state:GovernanceCorruption ;
    skos:scopeNote "Focuses on suppression of scientific knowledge rather than general press censorship covered by MediaFreedomConstraint." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/GovernanceSystem> .

