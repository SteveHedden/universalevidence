state:CredenceGoodsTrust a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:altLabel "credence-goods information asymmetry" ;
    skos:broader state:InformationAsymmetry ;
    skos:definition "An information-asymmetry problem in markets for credence goods, where consumers must rely on an expert seller because they cannot verify the quality or appropriateness of a diagnosis, treatment, good, or service, even after consumption." ;
    skos:inScheme state: ;
    skos:prefLabel "Credence-goods trust problem" ;
    skos:scopeNote "Use for the underlying unverifiability condition in credence-goods markets. Use ConsumerPerception for measured consumer beliefs or trust, ConsumerWelfare for realized affordability, quality, choice, safety, or surplus, and the relevant treatment, pricing, or discrimination concept for observed provider behavior." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/CreditConstraints>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CreditAccess> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Limitations on individuals, households, or firms obtaining desired borrowing or credit because of eligibility, collateral, information, price, or supply restrictions." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Credit constraints" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:CreditContractTerms a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:FinancialContractTerms ;
    skos:definition "The structure, pricing, collateral, repayment, or enforcement conditions attached to credit agreements." ;
    skos:scopeNote "Use for provisions of credit agreements, including rates, fees, collateral, liability, schedules, and enforcement. Use CreditAccess for whether suitable credit can be obtained, CreditSupply for lender-side availability or volume, CreditDecisionMaking for application or approval decisions, and DebtRepaymentCompliance for observed repayment performance." ;
    skos:inScheme state: ;
    skos:prefLabel "Credit contract terms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/FinancialSystem> .

state:CreditDecisionMaking a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:FinancialAndEconomicDecisionBehavior ;
    skos:definition "Borrower, lender, or household decisions about applying for, approving, using, or repaying credit." ;
    skos:inScheme state: ;
    skos:prefLabel "Credit decision-making" ;
    skos:scopeNote "Use for decisions by applicants, borrowers, households, loan officers, or lenders about credit application, approval, use, refinancing, or repayment. Use CreditDemand for willingness to borrow, Creditworthiness for assessed repayment capacity, CreditContractTerms for contract terms themselves, and ConsumerPaymentBehavior for payment methods or instruments." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:CreditSupply a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:FinancialSystemConditions ;
    skos:definition "The availability or quantity of credit offered by lenders or financial institutions to a market, sector, or borrower population." ;
    skos:scopeNote "Use for lender- or market-side credit availability and volume. Use CreditAccess for whether a borrower can obtain suitable credit, CreditDemand for willingness to borrow, CreditContractTerms for provisions attached to agreements, and CreditDecisionMaking for application or approval decisions." ;
    skos:inScheme state: ;
    skos:prefLabel "Credit supply" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/FinancialSystem> .

state:Creditworthiness a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader state:EconomicStatus ;
    skos:definition "A borrower’s perceived or assessed financial standing with respect to the ability and willingness to repay credit obligations." ;
    skos:scopeNote "Use for assessed repayment capacity and willingness. Use CreditAccess for whether suitable credit can be obtained, CreditDecisionMaking for application or approval decisions, DebtRepaymentCompliance for observed repayment performance, and CreditScore for an indicator that measures creditworthiness." ;
    skos:inScheme state: ;
    skos:prefLabel "Creditworthiness" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:CreditScore .

