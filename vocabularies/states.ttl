state:Osteoporosis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "low bone density" ;
    skos:broader state:BoneDisorders ;
    skos:definition "A skeletal disorder characterized by reduced bone mass and deterioration of bone tissue, leading to increased bone fragility and fracture risk. It is commonly assessed through bone mineral density and clinical fracture history." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D010024> ;
    skos:inScheme state: ;
    skos:prefLabel "Osteoporosis" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Osteoradionecrosis>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D010025> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
