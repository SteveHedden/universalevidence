state:Undertreatment a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "insufficient treatment",
        "under-treatment" ;
    skos:broader state:HealthServiceAndQualityOutcome ;
    skos:definition "Insufficient provision of clinically indicated remedial treatment or preventive care, whether the care is delivered too infrequently, incompletely, or not at all." ;
    skos:scopeNote "Includes underprovision associated with access barriers, provider decisions, or patient preference. Use TreatmentNonAdherence for failure to follow an already prescribed regimen, and ProfessionalPracticeGaps for broader deficits in professional knowledge, skill, or practice." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000097864> ;
    skos:inScheme state: ;
    skos:prefLabel "Undertreatment" ;
    skos:related state:ProfessionalPracticeGaps,
        state:TreatmentNonAdherence ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

