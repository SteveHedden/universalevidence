    <http://purl.org/dc/terms/bibliographicCitation> "From Adams et al., Principles of Neurology, 6th ed, p73" ;
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
