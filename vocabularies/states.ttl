state:MoralCleansing a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:MoralBehavior ;
    skos:definition "Compensatory behavior intended to restore a positive moral self-image after a perceived ethical lapse or threat to moral identity." ;
    skos:inScheme state: ;
    skos:prefLabel "Moral cleansing" ;
    skos:scopeNote "Moral cleansing may take restitutional, prosocial, self-punitive, distancing, or symbolic forms and need not be intended to benefit another person. Use ProsocialBehavior when benefiting others is the defining purpose, and MoralSelfConcept for the person's standing perception of their moral character rather than the compensatory response." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

