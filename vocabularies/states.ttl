state:Cystinosis a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D003554> ;
    skos:broader state:InbornErrorsOfMetabolism ;
    skos:definition "A metabolic disease characterized by the defective transport of CYSTINE across the lysosomal membrane due to mutation of a membrane protein cystinosin. This results in cystine accumulation and crystallization in the cells causing widespread tissue damage. In the KIDNEY, nephropathic cystinosis is a common cause of RENAL FANCONI SYNDROME." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D003554> ;
