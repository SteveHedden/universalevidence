    <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://id.nlm.nih.gov/mesh/D008659> ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/SDG211UndernourishmentPrevalence> ;
