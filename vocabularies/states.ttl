    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:IntestinalVolvulus a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "Bowel volvulus" ;
    skos:broader state:IntestinalObstruction ;
