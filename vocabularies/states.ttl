state:AdministrativeBarriers a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:broader state:AdministrativeBurden ;
    skos:definition "Procedural, documentation, staffing, or bureaucratic obstacles that limit access to services, benefits, or institutional processes." ;
    skos:inScheme state: ;
    skos:prefLabel "Administrative barriers" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:AdministrativeEfficiency a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:altLabel "Administrative process efficiency" ;
    skos:broader state:Efficiency ;
    skos:definition "The timeliness, accuracy, and resource efficiency with which administrative units, agencies, procedures, or service-delivery processes convert inputs into outputs." ;
    skos:inScheme state: ;
    skos:prefLabel "Administrative efficiency" ;
    skos:scopeNote "Use for the performance of administrative workflows and service processes, including processing time, delay, completion, accuracy, cost, and resource use. Use AdministrativeResponsiveness for whether an institution responds to requests or communications, BureaucraticQuality for the broader capability and professionalism of a bureaucracy, and Efficiency for a domain-neutral efficiency state." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HumanSystem> .

state:AdolescentMentalHealth a skos:Concept,
