    <http://www.w3.org/2004/02/skos/core#example> "Measuring the proportion of patients with low back pain receiving imaging within six weeks of symptom onset without red flags." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "medical overutilization" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "overuse of health services" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
