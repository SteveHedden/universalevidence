state:ExperienceBasedDecisionMaking a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:altLabel "Decision from experience",
        "Decisions from experience" ;
    skos:broader state:RiskAndUncertaintyInDecisionMaking ;
    skos:definition "Decision-making under risk or uncertainty in which information about options, outcome distributions, or advisor performance is learned through sampling or personally observed feedback rather than supplied only by description or advice." ;
    skos:inScheme state: ;
    skos:prefLabel "Experience-based decision-making" ;
    skos:scopeNote "Use when direct sampling or outcome feedback is the information source for a choice. Do not use merely because the decision-maker is experienced or an expert; use Expert judgment for expertise-based assessments, Personal experience for experience as an exposure without a decision process, and Uncertainty learning when belief updating rather than the resulting choice is the focus." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

