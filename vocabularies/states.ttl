<https://universalevidence.com/vocab/states/AtrioventricularNodalReentryTachycardia>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D013611> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Tachycardia, Atrioventricular Nodal Reentry" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CardiacArrhythmias> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Abnormally rapid heartbeats caused by reentry of atrial impulse into the dual (fast and slow) pathways of ATRIOVENTRICULAR NODE. The common type involves a blocked atrial impulse in the slow pathway which reenters the fast pathway in a retrograde direction and simultaneously conducts to the atria and the ventricles leading to rapid HEART RATE of 150-250 beats per minute." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D013611> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Atrioventricular nodal reentry tachycardia" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/AtrophicGastritis>
    <http://purl.org/dc/terms/created> "2026-06-14"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D005757> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Gastritis, Atrophic" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Gastritis> ;
    <http://www.w3.org/2004/02/skos/core#definition> "GASTRITIS with atrophy of the GASTRIC MUCOSA, the GASTRIC PARIETAL CELLS, and the mucosal glands leading to ACHLORHYDRIA. Atrophic gastritis usually progresses from chronic gastritis." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D005757> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Atrophic gastritis" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

