state:Choriocarcinoma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-13"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D002822> ;
    skos:broader state:GermCellAndTrophoblasticNeoplasms ;
    skos:definition "A malignant metastatic form of trophoblastic tumors. Unlike the HYDATIDIFORM MOLE, choriocarcinoma contains no CHORIONIC VILLI but rather sheets of undifferentiated cytotrophoblasts and syncytiotrophoblasts (TROPHOBLASTS). It is characterized by the large amounts of CHORIONIC GONADOTROPIN produced. Tissue origins can be determined by DNA analyses: placental (fetal) origin or non-placental origin (CHORIOCARCINOMA, NON-GESTATIONAL)." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D002822> ;
    skos:inScheme state: ;
    skos:prefLabel "Choriocarcinoma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ChoroidPlexusNeoplasms a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D016545> ;
    skos:broader state:BrainNeoplasms ;
    skos:definition "Benign or malignant tumors which arise from the choroid plexus of the ventricles of the brain. Papillomas (see PAPILLOMA, CHOROID PLEXUS) and carcinomas are the most common histologic subtypes, and tend to seed throughout the ventricular and subarachnoid spaces. Clinical features include headaches, ataxia and alterations of consciousness, primarily resulting from associated HYDROCEPHALUS. (From Devita et al., Cancer: Principles and Practice of Oncology, 5th ed, p2072; J Neurosurg 1998 Mar;88(3):521-8)" ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D016545> ;
    skos:hiddenLabel "D016545" ;
    skos:inScheme state: ;
    skos:prefLabel "Choroid plexus neoplasms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

