    dcterms:source <http://id.nlm.nih.gov/mesh/D016534> ;
    skos:broader state:HeartDiseases ;
    skos:definition "A state of elevated cardiac output due to conditions of either increased hemodynamic demand or reduced cardiac oxygen output. These conditions may include ANEMIA; ARTERIOVENOUS FISTULA; THYROTOXICOSIS; PREGNANCY; EXERCISE; FEVER; and HYPOXIA. In time, compensatory changes of the heart can lead to pathological form of high cardiac output and eventual HEART FAILURE." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D016534> ;
    skos:hiddenLabel "D016534" ;
    skos:inScheme state: ;
    skos:prefLabel "Cardiac output, high" ;
