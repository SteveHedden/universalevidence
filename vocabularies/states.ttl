state:AdrenocorticalAdenoma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D018246> ;
    skos:broader state:EndocrineGlandNeoplasms ;
    skos:definition "A benign neoplasm of the ADRENAL CORTEX. It is characterized by a well-defined nodular lesion, usually less than 2.5 cm. Most adrenocortical adenomas are nonfunctional. The functional ones are yellow and contain LIPIDS. Depending on the cell type or cortical zone involved, they may produce ALDOSTERONE; HYDROCORTISONE; DEHYDROEPIANDROSTERONE; and/or ANDROSTENEDIONE." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D018246> ;
    skos:hiddenLabel "D018246" ;
    skos:inScheme state: ;
    skos:prefLabel "Adrenocortical adenoma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:AdrenocorticalCarcinoma a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D018268> ;
    skos:broader state:Carcinoma ;
    skos:definition "A malignant neoplasm of the ADRENAL CORTEX. Adrenocortical carcinomas are unencapsulated anaplastic (ANAPLASIA) masses sometimes exceeding 20 cm or 200 g. They are more likely to be functional than nonfunctional, and produce ADRENAL CORTEX HORMONES that may result in hypercortisolism (CUSHING SYNDROME); HYPERALDOSTERONISM; and/or VIRILISM." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D018268> ;
    skos:hiddenLabel "D018268" ;
    skos:inScheme state: ;
    skos:prefLabel "Adrenocortical carcinoma" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

