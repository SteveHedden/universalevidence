    <http://www.w3.org/2004/02/skos/core#prefLabel> "Brachial plexus neuropathies" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Brachydactyly>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D059327> ;
