state:AbortionAccess a skos:Concept,
        ue:State ;
    skos:altLabel "abortion service access",
        "abortion service utilization",
        "induced abortion service outcomes" ;
    skos:broader state:ReproductiveHealth ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000025>,
        <http://id.nlm.nih.gov/mesh/D000028>,
        <http://id.nlm.nih.gov/mesh/D000029>,
        <http://id.nlm.nih.gov/mesh/D000032> ;
    skos:definition "Access to, utilization of, and service-related outcomes of induced-abortion care, including completion, safety, timeliness, and barriers to obtaining care." ;
    skos:hiddenLabel "induced abortion",
        "safe abortion",
        "unsafe abortion" ;
    skos:inScheme state: ;
    skos:prefLabel "Induced abortion access and service outcomes" ;
    skos:scopeNote "Use for access to or utilization of induced-abortion services and outcomes of that care. Exclude spontaneous pregnancy loss or miscarriage (use SpontaneousAbortion), incomplete abortion as a clinical condition (use IncompleteAbortion), general pregnancy or fertility rates, and the abortion procedure itself." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

state:AbruptioPlacentae a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:broader state:PregnancyComplications ;
    skos:definition "Premature separation of a normally implanted placenta from the uterus, potentially causing uterine bleeding, uterine hypertonia, fetal distress, or fetal death." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000037> ;
    skos:inScheme state: ;
    skos:prefLabel "Abruptio placentae" ;
