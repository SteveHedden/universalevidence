    skos:scopeNote "Use for informal finance across service types. Use InformalCreditUse for borrowing specifically from informal lenders or arrangements, and FinancialInclusion for access to or use of formal financial services." ;
    skos:inScheme state: ;
    skos:prefLabel "Informal finance" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

