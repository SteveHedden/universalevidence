state:PatientComfortOutcome a skos:Concept,
        ue:State ;
    skos:altLabel "Patient experience of comfort",
        "Procedural comfort" ;
    skos:broader state:Wellbeing ;
    skos:definition "A patient’s experienced degree of physical ease and emotional calm during or after health care, treatment, diagnostic testing, or use of a therapeutic or assistive device, whether self-reported or observer-assessed." ;
    skos:example "Comfort rated after bronchoscopy or while using a contact lens, brace, oxygen interface, or hearing device." ;
    skos:hiddenLabel "patient comfort" ;
    skos:inScheme state: ;
    skos:prefLabel "Patient comfort" ;
    skos:related state:ServiceSatisfaction ;
    skos:scopeNote "Use only when comfort or discomfort is explicitly named or measured. Do not infer it from pain, anxiety, distress, satisfaction, acceptability, convenience, tolerability, or generic patient experience; map those constructs separately. Use ThermalComfort for temperature-related comfort and Pain, AcutePain, or ProceduralPain for pain-only outcomes. This outcome state is not equivalent to comfort care as a patient-care intervention (MeSH D000070659)." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

