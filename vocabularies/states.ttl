state:KlinefelterSyndrome a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D007713> ;
    skos:broader state:Hypogonadism ;
    skos:definition "A form of male HYPOGONADISM, characterized by the presence of an extra X CHROMOSOME, small TESTES, seminiferous tubule dysgenesis, elevated levels of GONADOTROPINS, low serum TESTOSTERONE, underdeveloped secondary sex characteristics, and male infertility (INFERTILITY, MALE). Patients tend to have long legs and a slim, tall stature. GYNECOMASTIA is present in many of the patients. The classic form has the karyotype 47,XXY. Several karyotype variants include 48,XXYY; 48,XXXY; 49,XXXXY, and mosaic patterns ( 46,XY/47,XXY; 47,XXY/48,XXXY, etc.)." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007713> ;
    skos:inScheme state: ;
    skos:prefLabel "Klinefelter syndrome" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

