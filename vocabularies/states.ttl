<https://universalevidence.com/vocab/states/BrennerTumor>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D001948> ;
