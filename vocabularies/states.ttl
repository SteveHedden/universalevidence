state:ABVariantTaySachsDisease a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D049290> ;
    skos:altLabel "Tay-Sachs Disease, AB Variant" ;
    skos:broader state:Gangliosidoses ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D013661> ;
    skos:definition "A progressive neurodegenerative disorder that begins with muscle weakness, then progresses to startle reaction, retardation and seizures. It is characterized by the accumulation of G(M2) GANGLIOSIDE in neurons that is caused by a lack of G(M2) ACTIVATOR PROTEIN function. The AB variant designation refers to the increase of both HEXOSAMINIDASE A and HEXOSAMINIDASE B in tissues that lack of G(M2) activator protein." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D049290> ;
    skos:inScheme state: ;
    skos:prefLabel "AB variant Tay-Sachs disease" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

