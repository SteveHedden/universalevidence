    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D014849> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CongenitalMultisystemMalformationSyndromes> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Rare, autosomal dominant disease with variable penetrance and several known clinical types. Characteristics may include depigmentation of the hair and skin, congenital deafness, heterochromia iridis, medial eyebrow hyperplasia, hypertrophy of the nasal root, and especially dystopia canthorum. The underlying cause may be defective development of the neural crest (neurocristopathy). Waardenburg's syndrome may be closely related to piebaldism. Klein-Waardenburg Syndrome refers to a disorder that also includes upper limb abnormalities." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D014849> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Waardenburg syndrome" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:WageAmenityTradeOffs a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:WorkplacePreferences ;
    skos:definition "The relative value workers or job seekers place on wages versus non-wage job attributes, reflected in choices or willingness to trade pay for hours, flexibility, safety, benefits, security, tasks, or working conditions." ;
    skos:scopeNote "Use for worker or job-seeker valuation of compensation relative to non-wage job attributes. Use CompensatingWageDifferentials for observed wage differences associated with amenities, and JobAmenities or JobAttributes for the attributes themselves." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage–amenity trade-offs" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageCompetition a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketCompetition ;
    skos:definition "The degree to which employers compete for workers, or workers for jobs, through differences and adjustments in offered wages." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage competition" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageElasticity a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "The percentage change in job-search, application, labor-supply, or labor-demand response associated with a one-percent change in wages." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage elasticity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> ;
    ue:measures state:JobApplicationBehavior .

state:WageEquity a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:Wages ;
    skos:definition "The degree to which pay is fair across workers performing comparable work, accounting for responsibilities, qualifications, and working conditions." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage equity" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageExpectations a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:EconomicExpectations ;
    skos:definition "Beliefs held by workers or job seekers about the wages they will receive or require in current or prospective employment." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage expectations" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageFloors a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketPolicyRegulationAndInstitutions ;
    skos:definition "Minimum wage levels established by law, collective bargaining, or other binding rules below which covered pay should not fall." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage floors" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageGap a skos:Concept,
        ue:Indicator ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "wage gaps" ;
    ue:measures state:WageInequality ;
    skos:definition "An absolute or relative difference in average or median pay between defined groups of workers, occupations, sectors, or locations." ;
    skos:scopeNote "Use for a computed pay contrast between defined groups. Use wage inequality for the underlying labor-market distributional condition." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage gap" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageInequality a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:Wages ;
    skos:definition "The degree to which wages are unevenly distributed across workers or groups within a labor market." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage inequality" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageInformation a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "Pay transparency" ;
    skos:broader state:LaborMarketConditions ;
    skos:definition "The availability, visibility, accuracy, and accessibility of information about wages, salaries, pay ranges, and compensation practices to workers, employers, or job seekers." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage information" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageInsurance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:SocialProtection ;
    skos:definition "The availability and coverage of insurance benefits that replace wages lost because of illness, hospitalization, unemployment, or reemployment at lower pay." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage insurance" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageLabor a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:EmploymentFormsAndWorkArrangements ;
    skos:definition "Employment in which a worker provides labor to an employer in exchange for wages or a salary." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage labor" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WagePostings a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:WageInformation ;
    skos:definition "The prevalence and quality of employers' disclosure of wage levels or pay ranges in job advertisements and workplace notices." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage postings" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WagePremium a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:Wages ;
    skos:definition "The additional pay associated with a worker characteristic, job attribute, credential, sector, location, or risk relative to a comparison group." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage premium" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:WageSetting a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The prevailing processes and institutional arrangements through which employers, workers, bargaining parties, or public bodies determine, negotiate, or adjust wage and salary levels." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage setting" ;
    skos:scopeNote "Covers system- or organization-level pay-setting arrangements and decisions; excludes realized earnings, individual salary-negotiation behavior, and deliberate wage-setting policies represented as interventions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageSubsidy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketPolicyRegulationAndInstitutions ;
    skos:definition "The availability and level of public financial support that offsets employers' wage costs for hiring or retaining eligible workers." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage subsidy" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/LaborMarket> .

state:WageTheft a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LabourRightsDeficit ;
    skos:definition "A labor-rights violation in which wages, overtime, benefits, or other compensation legally owed to workers are not paid or are underpaid." ;
    skos:inScheme state: ;
    skos:prefLabel "Wage theft" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/WaldenstromMacroglobulinemia>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D008258> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/LymphoproliferativeDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A lymphoproliferative disorder characterized by pleomorphic B-LYMPHOCYTES including PLASMA CELLS, with increased levels of monoclonal serum IMMUNOGLOBULIN M. There is lymphoplasmacytic cells infiltration into bone marrow and often other tissues, also known as lymphoplasmacytic lymphoma. Clinical features include ANEMIA; HEMORRHAGES; and hyperviscosity." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D008258> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Waldenstrom macroglobulinemia" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/WalkerWarburgSyndrome>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D058494> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/CraniofacialDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Rare autosomal recessive lissencephaly type 2 associated with congenital MUSCULAR DYSTROPHY and eye anomalies (e.g., RETINAL DETACHMENT; CATARACT; MICROPHTHALMOS). It is often associated with additional brain malformations such as HYDROCEPHALY and cerebellar hypoplasia and is the most severe form of the group of related syndromes (alpha-dystroglycanopathies) with common congenital abnormalities in the brain, eye and muscle development." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D058494> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Walker-Warburg syndrome" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

