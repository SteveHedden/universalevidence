state:BrainEdema a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D001929> ;
    skos:broader state:BrainDiseases ;
    skos:definition "Increased intracellular or extracellular fluid in brain tissue. Cytotoxic brain edema (swelling due to increased intracellular fluid) is indicative of a disturbance in cell metabolism, and is commonly associated with hypoxic or ischemic injuries (see HYPOXIA, BRAIN). An increase in extracellular fluid may be caused by increased brain capillary permeability (vasogenic edema), an osmotic gradient, local blockages in interstitial fluid pathways, or by obstruction of CSF flow (e.g., obstructive HYDROCEPHALUS). (From Childs Nerv Syst 1992 Sep; 8(6):301-6)" ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001929> ;
    skos:inScheme state: ;
    skos:prefLabel "Brain edema" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainHypoxia a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D002534> ;
    skos:altLabel "Hypoxia, Brain" ;
    skos:broader state:Hypoxia ;
    skos:definition "A reduction in brain oxygen supply due to ANOXEMIA (a reduced amount of oxygen being carried in the blood by HEMOGLOBIN), or to a restriction of the blood supply to the brain, or both. Severe hypoxia is referred to as anoxia and is a relatively common cause of injury to the central nervous system. Prolonged brain anoxia may lead to BRAIN DEATH or a PERSISTENT VEGETATIVE STATE. Histologically, this condition is characterized by neuronal loss which is most prominent in the HIPPOCAMPUS; GLOBUS PALLIDUS; CEREBELLUM; and inferior olives." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D002534> ;
    skos:inScheme state: ;
    skos:prefLabel "Brain hypoxia" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainHypoxiaIschemia a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:CerebrovascularDisorders ;
    skos:definition "Brain injury caused by combined oxygen deprivation and reduced blood flow." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020925> ;
    skos:inScheme state: ;
    skos:prefLabel "Brain hypoxia-ischemia" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainInjuryChronic a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020208> ;
    skos:broader state:BrainInjuries ;
    skos:definition "Conditions characterized by persistent brain damage or dysfunction as sequelae of cranial trauma. This disorder may result from DIFFUSE AXONAL INJURY; INTRACRANIAL HEMORRHAGES; BRAIN EDEMA; and other conditions. Clinical features may include DEMENTIA; focal neurologic deficits; PERSISTENT VEGETATIVE STATE; AKINETIC MUTISM; or COMA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020208> ;
    skos:hiddenLabel "D020208" ;
    skos:inScheme state: ;
    skos:prefLabel "Brain injury, chronic" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainStemHemorrhageTraumatic a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020203> ;
    skos:broader state:BrainHemorrhageTraumatic ;
    skos:definition "Bleeding into structures of BRAIN STEM, including the MIDBRAIN; PONS; or MEDULLA OBLONGATA, as the result of CRANIOCEREBRAL TRAUMA. DIFFUSE AXONAL INJURY is commonly associated. Clinical manifestations may include OCULAR MOTILITY DISORDERS; ATAXIA; PARALYSIS; PERSISTENT VEGETATIVE STATE; and COMA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020203> ;
    skos:hiddenLabel "D020203" ;
    skos:inScheme state: ;
    skos:prefLabel "Brain stem hemorrhage, traumatic" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainStemInfarctions a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020526> ;
    skos:broader state:BrainInfarction ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D014854> ;
    skos:definition "Infarctions that occur in the BRAIN STEM which is comprised of the MIDBRAIN; PONS; and MEDULLA OBLONGATA. There are several named syndromes characterized by their distinctive clinical manifestations and specific sites of ischemic injury." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020526> ;
    skos:hiddenLabel "D020526" ;
    skos:inScheme state: ;
    skos:prefLabel "Brain stem infarctions" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BrainStemNeoplasms a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020295> ;
    skos:broader state:BrainNeoplasms ;
    skos:definition "Benign and malignant intra-axial tumors of the MESENCEPHALON; PONS; or MEDULLA OBLONGATA of the BRAIN STEM. Primary and metastatic neoplasms may occur in this location. Clinical features include ATAXIA, cranial neuropathies (see CRANIAL NERVE DISEASES), NAUSEA, hemiparesis (see HEMIPLEGIA), and quadriparesis. Primary brain stem neoplasms are more frequent in children. Histologic subtypes include GLIOMA; HEMANGIOBLASTOMA; GANGLIOGLIOMA; and EPENDYMOMA." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020295> ;
    skos:hiddenLabel "D020295" ;
    skos:inScheme state: ;
    skos:prefLabel "Brain stem neoplasms" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

