<https://universalevidence.com/vocab/states/NonHodgkinLymphoma>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D008228> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Lymphoma, Non-Hodgkin" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Lymphoma> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Any of a group of malignant tumors of lymphoid tissue that differ from HODGKIN DISEASE, being more heterogeneous with respect to malignant cell lineage, clinical course, prognosis, and therapy. The only common feature among these tumors is the absence of giant REED-STERNBERG CELLS, a characteristic of Hodgkin's disease." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D008228> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-Hodgkin lymphoma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/NonInfectiveEndocarditis>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D059905> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Endocarditis, Non-Infective" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HeartDiseases> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Formation of a non-infectious THROMBUS, referred to as vegetation, on previously undamaged ENDOCARDIUM. It usually occurs as a complication of connective-tissue diseases and cancers because of the associated hypercoagulable state (see THROMBOPHILIA)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D059905> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-infective endocarditis" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

