        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:AnatomicalPathologicalConditions ;
    skos:definition "Discrete abnormal tissue masses that protrude from a mucous membrane into the lumen of the digestive or respiratory tract." ;
