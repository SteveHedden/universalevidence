    skos:definition "Instructional difficulty, spacing, retrieval, or challenge that may affect learning effort and retention." ;
    skos:inScheme state: ;
    skos:prefLabel "Learning challenge difficulty" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LearningDisabilities a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "Learning disorders" ;
    skos:broader state:Neurodivergence ;
    skos:definition "Conditions characterized by substantial difficulty acquiring or using language, reading, writing, mathematics, or other cognitive and academic skills relative to expected ability." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D007859> ;
    skos:inScheme state: ;
    skos:prefLabel "Learning disabilities" ;
    skos:scopeNote "Umbrella concept for learning disabilities or learning disorders when a source does not establish a specific diagnosis. Use SpecificLearningDisorder for persistent, impairing deficits in foundational academic skills, and a named subtype such as Dyslexia when supported." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LearningEffect a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LearningOutcomesAndLoss ;
    skos:definition "A change in performance or outcomes attributable to learning, whether through instruction, practice, or experience." ;
    skos:inScheme state: ;
    skos:prefLabel "Learning effect" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LearningJournal a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:altLabel "Learning journal" ;
    skos:broader state:LearningBehavior ;
    skos:definition "The extent and frequency with which learners use a journal to record, reflect on, monitor, and plan their learning or study behavior." ;
    skos:inScheme state: ;
    skos:prefLabel "Learning journal use" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LearningLoss a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LearningOutcomesAndLoss ;
    skos:definition "A decline in knowledge or skills relative to an expected level of learning, often due to interrupted or reduced instruction." ;
    skos:inScheme state: ;
    skos:prefLabel "Learning loss" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LearningOutcomes a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LearningOutcomesAndLoss ;
    skos:definition "The knowledge, skills, or competencies a learner has gained as a result of instruction or educational experience." ;
    skos:inScheme state: ;
    skos:prefLabel "Learning outcomes" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

