    skos:broader state:PricingBehavior ;
    skos:definition "The extent to which changes in costs, taxes, exchange rates, or policies are reflected in prices paid by consumers or firms." ;
    skos:inScheme state: ;
    skos:prefLabel "Price pass-through" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:PriceUncertainty a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:CostPerceptions ;
