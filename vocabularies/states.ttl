        "gender disparities in education" ;
    skos:broader state:EducationalStatus ;
    skos:definition "Unequal access, participation, treatment, guidance, attainment, or learning outcomes in education across gender, disability, wealth, ethnicity, migration background, location, or other social groups." ;
