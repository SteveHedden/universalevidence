state:SubstanceUsePrevalence a skos:Concept,
        ue:State ;
    skos:altLabel "Substance use",
        "Substance use behavior",
        "Substance use prevalence",
        "alcohol use rate",
        "drug use prevalence" ;
    skos:broader state:HealthBehavior ;
    skos:definition "Patterns and extent of alcohol, illicit-drug, or other psychoactive-substance use among individuals or populations, including whether, how often, and how much substances are used." ;
    skos:example "Population prevalence, frequency, or quantity of alcohol or illicit-drug use changing over time." ;
    skos:hiddenLabel "alcohol abuse prevalence",
        "drug abuse rate" ;
    skos:inScheme state: ;
    skos:prefLabel "Substance use patterns" ;
    skos:related state:AdolescentHealth,
        state:SubstanceUseDisorder ;
    skos:scopeNote "Use for observed consumption, frequency, quantity, or prevalence without inferring a clinical disorder. Use SubstanceUseDisorder when diagnosis, dependence, impaired control, clinically significant harm or impairment, or explicit abuse, misuse, or disorder terminology is present. Exclude attitudes, intentions, motivation, psychological flexibility, communication, treatment or care uptake, medication utilization, screening, drug resistance, and substance-policy measures." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy indicator:SDG352AlcoholPerCapitaConsumption .

