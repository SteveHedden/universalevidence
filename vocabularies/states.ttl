state:WernickeEncephalopathy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:altLabel "Gayet-Wernicke encephalopathy",
        "Wernicke disease",
        "Wernicke syndrome",
        "Wernicke's encephalopathy" ;
    skos:broader state:MetabolicBrainDiseases ;
    skos:definition "An acute acquired metabolic encephalopathy caused by thiamine deficiency, classically producing confusion, eye-movement abnormalities, and impaired coordination." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014899> ;
    skos:inScheme state: ;
    skos:prefLabel "Wernicke encephalopathy" ;
    skos:scopeNote "Use for the acute encephalopathic syndrome. Use Thiamine deficiency when deficiency is present without this syndrome, and use Korsakoff syndrome for the chronic amnestic condition; Wernicke encephalopathy is acquired rather than an inborn metabolic brain disease." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

