    <http://www.w3.org/2004/02/skos/core#definition> "A POSTPARTUM condition consists of persistent lactation (GALACTORRHEA) and AMENORRHEA in patients not BREAST FEEDING." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D002640> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Chiari-Frommel syndrome" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/Chickenpox>
    <http://purl.org/dc/terms/bibliographicCitation> "From Dorland, 27th ed" ;
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D002644> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
