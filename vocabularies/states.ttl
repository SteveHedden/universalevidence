        state:EmploymentStatus,
        state:PopulationHealthStatus,
        state:Migration,
        state:PsychologicalAndBehavioralStatus,
        state:SafetyAndSecurityStatus,
        state:SocialInclusionAndIdentityStatus,
        state:SocialProtection,
        state:Wellbeing ;
    skos:prefLabel "Population states" .

