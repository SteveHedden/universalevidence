state:HealthEquityOutcome a skos:Concept,
        ue:Indicator ;
    skos:altLabel "Health disparities reduction",
        "Health inequality gap",
        "Universal Health Care" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000069576> ;
    skos:definition "Measurable reduction in systematic differences in health status, health service access, or health outcomes across socially defined population groups, including by income, ethnicity, geography, or gender." ;
    skos:example "Tracking changes in the gap in vaccination coverage between rural and urban children following an equity-focused immunization campaign." ;
    skos:hiddenLabel "equitable health outcomes",
        "health equity measure" ;
    skos:inScheme state: ;
    skos:prefLabel "Health equity" ;
    skos:related state:IncomeInequality,
        state:WomensEconomicParticipation ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> .

state:HealthInequity a skos:Concept,
        ue:State ;
    skos:altLabel "Health disparities",
        "Health equity gaps",
        "Health inequality",
        "Race Factors",
        "Universal Health Care" ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000076782>,
        <http://id.nlm.nih.gov/mesh/D000080423>,
        <http://id.nlm.nih.gov/mesh/D000091682>,
        <http://id.nlm.nih.gov/mesh/D000093862>,
        <http://id.nlm.nih.gov/mesh/D000095026> ;
    skos:definition "The persistent and systematic difference in health status, access to care, and health outcomes across population groups defined by socioeconomic position, geography, ethnicity, or other social determinants, representing an avoidable and unjust disparity." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069576> ;
    skos:example "Measuring disparities in under-five mortality rates between the poorest and wealthiest quintiles in a country." ;
    skos:hiddenLabel "inequity in health" ;
    skos:inScheme state: ;
    skos:prefLabel "Health inequity" ;
    skos:related state:GenderEquality,
        state:HumanRightsViolations,
        state:SocialInequality ;
    skos:scopeNote "Focuses on structural and systemic drivers of differential health outcomes; distinct from individual disease burden captured in specific disease conditions." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HealthSystem> ;
    skos:broader state:PopulationHealthStatus .

