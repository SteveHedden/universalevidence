    skos:broader state:Pain ;
    skos:inScheme state: ;
    skos:prefLabel "Labor pain" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:LaborProductivity a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:LaborMarketStructureAndDynamics ;
    skos:definition "The level of output produced by workers relative to labor input, as a standing labor-market performance condition commonly operationalized via output-per-worker or output-per-hour indicators." ;
