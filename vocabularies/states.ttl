        indicator:WDIENHPTTHRDNO,
        indicator:WDIENMAMTHRDNO,
        indicator:WDIERLNDPTLDZS,
        indicator:WDIERMRNPTMRZS,
        indicator:WDIERPTDTOTLZS .

