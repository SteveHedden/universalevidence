    skos:exactMatch <http://id.nlm.nih.gov/mesh/D014091> ;
    skos:inScheme state: ;
    skos:prefLabel "Tooth resorption" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:ToothWear a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader state:OralAndDentalDisorders ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D014077>,
        <http://id.nlm.nih.gov/mesh/D019217> ;
