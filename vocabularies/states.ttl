<https://universalevidence.com/vocab/states/CysticLymphangioma>
    <http://purl.org/dc/terms/created> "2026-06-17"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018191> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Lymphangioma, Cystic" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/VascularNeoplasms> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A cystic growth originating from lymphatic tissue. It is usually found in the neck, axilla, or groin." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018191> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
