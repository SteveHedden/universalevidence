    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:Multimorbidity a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-04"^^xsd:date ;
    skos:altLabel "co-morbidity",
        "comorbidity burden",
        "multiple chronic conditions" ;
    skos:broader state:NonCommunicableDiseaseAttributesAndPathologicProcesses ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000071069> ;
    skos:definition "The co-occurrence of two or more chronic conditions in the same individual, leading to complex care needs, polypharmacy, and heightened risk of disability and premature mortality." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071069>,
        <http://id.nlm.nih.gov/mesh/D000076322> ;
    skos:inScheme state: ;
    skos:prefLabel "Multimorbidity" ;
    skos:scopeNote "Distinct from comorbidity in its focus on multiple co-equal conditions rather than a primary condition plus complications." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/MultipleAcylCoenzymeADehydrogenaseDeficiency>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D054069> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/EndocrineAndMetabolicDisorders> ;
    <http://www.w3.org/2004/02/skos/core#definition> "An autosomal recessive disorder of fatty acid oxidation, and branched chain amino acids (AMINO ACIDS, BRANCHED-CHAIN); LYSINE; and CHOLINE catabolism, that is due to defects in either subunit of ELECTRON TRANSFER FLAVOPROTEIN or its dehydrogenase, electron transfer flavoprotein-ubiquinone oxidoreductase (EC 1.5.5.1)." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D054069> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Multiple acyl coenzyme A dehydrogenase deficiency" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

