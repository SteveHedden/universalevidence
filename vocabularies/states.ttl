        <http://id.nlm.nih.gov/mesh/D020277> ;
    skos:definition "A disorder involving multiple spinal nerve roots and peripheral nerves, often causing weakness, sensory loss, or reflex changes." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D011129> ;
    skos:inScheme state: ;
    skos:prefLabel "Polyradiculoneuropathy" ;
