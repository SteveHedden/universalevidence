    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/target/17_4> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60020> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60030> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60040> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60061> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60062> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60063> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The persistent fiscal constraint imposed by excessive external or domestic public debt, limiting a government's capacity to invest in public services and development." ;
    <http://www.w3.org/2004/02/skos/core#example> "HIPC-eligible countries spending more on debt service than on health and education combined." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "debt crisis" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "debt distress" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "debt overhang" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Sovereign debt burden" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/ExcessBorrowing> ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60010> ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/GovernanceSystem> ;
    <https://universalevidence.com/ontology/measuredBy> <https://universalevidence.com/vocab/states/DebtToGDPRatio> ;
