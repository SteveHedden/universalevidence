state:Stunting a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:altLabel "child stunting",
        "linear growth retardation" ;
    skos:broader state:ChildMalnutrition ;
    skos:definition "The condition of impaired linear growth in children, defined as height-for-age more than two standard deviations below the WHO Child Growth Standards median, reflecting chronic undernutrition." ;
    skos:inScheme state: ;
    skos:prefLabel "Stunting" ;
    skos:related state:ChildGrowth ;
    skos:scopeNote "Use for the categorical chronic-undernutrition condition defined by height-for-age below -2 standard deviations, including its severe subtype below -3 standard deviations. Use SevereStunting when the below -3 threshold is explicit, and ChildGrowth for linear growth, growth velocity, or height-for-age measures that do not establish stunting. Distinct from wasting, which is an acute weight-for-height deficit." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy indicator:SDG221UnderFiveStuntingPrevalence .

