        ue:State ;
    dcterms:created "2026-06-24"^^xsd:date ;
    skos:definition "Diseases affecting the adrenal cortex, including disorders of corticosteroid production, inflammation, hyperplasia, or neoplasia." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000303> ;
    skos:inScheme state: ;
    skos:prefLabel "Adrenal cortex diseases" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    skos:broader state:EndocrineAndMetabolicDisorders .

<https://universalevidence.com/vocab/states/AdrenocorticalAdenoma>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018246> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/EndocrineGlandNeoplasms> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A benign neoplasm of the ADRENAL CORTEX. It is characterized by a well-defined nodular lesion, usually less than 2.5 cm. Most adrenocortical adenomas are nonfunctional. The functional ones are yellow and contain LIPIDS. Depending on the cell type or cortical zone involved, they may produce ALDOSTERONE; HYDROCORTISONE; DEHYDROEPIANDROSTERONE; and/or ANDROSTENEDIONE." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018246> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018246" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Adrenocortical adenoma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/AdrenocorticalCarcinoma>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D018268> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/Carcinoma> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A malignant neoplasm of the ADRENAL CORTEX. Adrenocortical carcinomas are unencapsulated anaplastic (ANAPLASIA) masses sometimes exceeding 20 cm or 200 g. They are more likely to be functional than nonfunctional, and produce ADRENAL CORTEX HORMONES that may result in hypercortisolism (CUSHING SYNDROME); HYPERALDOSTERONISM; and/or VIRILISM." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D018268> ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "D018268" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Adrenocortical carcinoma" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

