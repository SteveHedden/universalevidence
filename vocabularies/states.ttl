state:BartterSyndrome a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-12"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D001477> ;
    skos:broader state:InbornErrorsOfMetabolism ;
    skos:definition "A group of disorders caused by defective salt reabsorption in the ascending LOOP OF HENLE. It is characterized by severe salt-wasting, HYPOKALEMIA; HYPERCALCIURIA; metabolic ALKALOSIS, and hyper-reninemic HYPERALDOSTERONISM without HYPERTENSION. There are several subtypes including ones due to mutations in the renal specific SODIUM-POTASSIUM-CHLORIDE SYMPORTERS." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D001477> ;
    skos:inScheme state: ;
    skos:prefLabel "Bartter syndrome" ;
