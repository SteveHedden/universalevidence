<https://universalevidence.com/vocab/states/GroupFormation>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/GroupBehavior> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The creation, joining, or persistence of social, economic, or organizational groups." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Group formation" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:GroupIdentity a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "Group identification",
        "Social identification",
        "Social identity" ;
    skos:broader state:Identity ;
    skos:definition "The part of a person’s self-concept derived from identification with, attachment to, or perceived membership in a social, organizational, ethnic, political, or other group." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D012933> ;
    skos:inScheme state: ;
    skos:prefLabel "Group identity" ;
    skos:scopeNote "Use for an individual’s self-definition or identification through group membership. Use SharedIdentity for a sense of common identity collectively held among people or communities, InGroupMembership for the status of belonging to the same group as a reference person, and SocialCohesion for community-wide trust, solidarity, inclusion, or connectedness." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/GroupNormSensitivity>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/SocialNorms> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Responsiveness of beliefs, choices, or behavior to perceived norms within a reference group." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Group norm sensitivity" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

state:GroupPerformance a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:broader state:TaskPerformance ;
    skos:definition "The degree to which a group or team completes shared tasks or work, reflected in output, effectiveness, or quality." ;
    skos:inScheme state: ;
    skos:prefLabel "Group performance" ;
    skos:scopeNote "Use for collective results on shared tasks. Use GroupEffort for collective exertion, GroupCollaboration for coordination processes, and TaskPerformance for individual results." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/HumanSystem> .

