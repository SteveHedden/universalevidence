state:VaccinationCoverage a skos:Concept,
        ue:State ;
    skos:altLabel "immunisation uptake",
        "immunization uptake",
        "vaccine uptake" ;
    skos:broader state:VaccinationBehavior ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000073887> ;
    skos:definition "Receipt and timely completion of recommended vaccine doses by eligible members of a population." ;
    skos:hiddenLabel "vaccine schedule completion" ;
    skos:inScheme state: ;
    skos:prefLabel "Vaccination uptake" ;
    skos:scopeNote "Use for actual vaccine receipt or schedule completion. Use vaccination behavior for intentions, acceptance, delay, or refusal; vaccination hesitancy for hesitancy; immunization for population protection; and vaccine immunogenicity for measured immune response." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measuredBy state:SDG3B1VaccineCoverageRate,
        state:WDISHVACTTNSQ2ZS .

state:VaccineImmunogenicity a skos:Concept,
        ue:Indicator ;
    skos:altLabel "seroconversion rate",
        "vaccine immune response" ;
    skos:definition "Measurable immune response elicited by a vaccine, including antibody titres, seroconversion rates, and cellular immune markers, used to assess the biological efficacy of immunization." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071497> ;
    skos:example "Geometric mean antibody titres measured 28 days after COVID-19 booster vaccination in a clinical trial." ;
    skos:hiddenLabel "immunogenicity of vaccine",
        "vaccine antibody titre" ;
    skos:inScheme state: ;
    skos:prefLabel "Vaccine immunogenicity" ;
    skos:related state:InfectionIncidence ;
    skos:scopeNote "Distinct from vaccination coverage (uptake) and clinical protection; focuses on the biological immune response as an intermediate outcome." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> ;
    ue:measures state:AntibodyResponse .

