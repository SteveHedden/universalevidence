state:JunkFees a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:PricingBehavior ;
    skos:definition "Seller-imposed charges that are unnecessary, effectively unavoidable, hidden or delayed until after an initial price is shown, materially misrepresented, or of little or no added value." ;
    skos:inScheme state: ;
    skos:prefLabel "Junk fees" ;
    skos:scopeNote "Use for a seller’s fee-setting or fee-disclosure practice. Do not use for ordinary clearly disclosed optional charges, government taxes, court fines, or generic fees. Use PriceGouging for exploitative price increases during scarcity or disruption, DeceptiveAdvertisingExposure for consumer exposure to misleading price advertising, and ConsumerWelfare or ConsumptionExpenditure for downstream welfare or spending outcomes." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

