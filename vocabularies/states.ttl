<https://universalevidence.com/vocab/states/Immunization>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "immunisation" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "immunisations" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "immunizations" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/PopulationHealthStatus> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D007114> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The extent to which a population has received active or passive immunization and acquired corresponding protection against infectious disease." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Immunization" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/states/COVID19> ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://metadata.un.org/thesaurus/1003061> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for population immunization status or protection. Use vaccination uptake for receipt and completion of vaccine doses, vaccination behavior for acceptance or refusal, and vaccine immunogenicity for measured immune response to a vaccine." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

