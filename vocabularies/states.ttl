state:AutoimmuneLymphoproliferativeSyndrome a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-15"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D056735> ;
    skos:broader state:AutoimmuneDiseases ;
    skos:definition "Rare congenital lymphoid disorder due to mutations in certain Fas-Fas ligand pathway genes. Known causes include mutations in FAS, TNFSF6, NRAS, CASP8, and CASP10 proteins. Clinical features include LYMPHADENOPATHY; SPLENOMEGALY; and AUTOIMMUNITY." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D056735> ;
