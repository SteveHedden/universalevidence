<https://universalevidence.com/vocab/states/HereditaryNonpolyposisColorectalNeoplasms>
    <http://purl.org/dc/terms/created> "2026-06-13"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://purl.org/dc/terms/source> <http://id.nlm.nih.gov/mesh/D003123> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Colorectal Neoplasms, Hereditary Nonpolyposis" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/states/HereditaryNeoplasmicSyndromes> ;
    <http://www.w3.org/2004/02/skos/core#definition> "A group of autosomal-dominant inherited diseases in which COLON CANCER arises in discrete adenomas. Unlike FAMILIAL POLYPOSIS COLI with hundreds of polyps, hereditary nonpolyposis colorectal neoplasms occur much later, in the fourth and fifth decades. HNPCC has been associated with germline mutations in mismatch repair (MMR) genes. It has been subdivided into Lynch syndrome I or site-specific colonic cancer, and LYNCH SYNDROME II which includes extracolonic cancer." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D003123> ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Hereditary nonpolyposis colorectal neoplasms" ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Population> .

<https://universalevidence.com/vocab/states/HeritageSiteDegradation>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/State> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Cultural heritage degradation" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Site deterioration" ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/indicator/11_4_1> ;
    <http://www.w3.org/2004/02/skos/core#definition> "The persistent deterioration, destruction, or neglect of culturally, historically, or ecologically significant sites due to human activity, climate change, or lack of protection." ;
    <http://www.w3.org/2004/02/skos/core#example> "Erosion and looting of archaeological sites in conflict-affected regions." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "monument decay" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "world heritage site destruction" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/states/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Heritage and natural site degradation" ;
    <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#41040> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Encompasses both natural site degradation and cultural heritage loss; overlaps with CulturalMarginalisation for cultural heritage dimensions." ;
    <https://universalevidence.com/ontology/bearer> <https://universalevidence.com/vocab/subjects/Climate> .

