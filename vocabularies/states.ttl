state:EpiduralAbscess a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-16"^^xsd:date ;
    dcterms:source <http://id.nlm.nih.gov/mesh/D020802> ;
    skos:broader state:CentralNervousSystemInfections ;
    skos:definition "Circumscribed collections of suppurative material occurring in the spinal or intracranial EPIDURAL SPACE. The majority of epidural abscesses occur in the spinal canal and are associated with OSTEOMYELITIS of a vertebral body; ANALGESIA, EPIDURAL; and other conditions. Clinical manifestations include local and radicular pain, weakness, sensory loss, URINARY INCONTINENCE, and FECAL INCONTINENCE. Cranial epidural abscesses are usually associated with OSTEOMYELITIS of a cranial bone, SINUSITIS, or OTITIS MEDIA. (From Adams et al., Principles of Neurology, 6th ed, p710 and pp1240-1; J Neurol Neurosurg Psychiatry 1998 Aug;65(2):209-12)" ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D020802> ;
    skos:inScheme state: ;
    skos:prefLabel "Epidural abscess" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

