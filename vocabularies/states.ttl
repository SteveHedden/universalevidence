    skos:inScheme state: ;
    skos:prefLabel "Buschke-Lowenstein tumor" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

state:BusinessGrowthBarriers a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader state:GrowthBarriers ;
    skos:definition "Constraints specific to the growth of firms and enterprises, including limited finance, regulation, market access, managerial capacity, or productive capability." ;
    skos:inScheme state: ;
    skos:prefLabel "Business growth barriers" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:BusinessNetworks a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:PrivateSectorConditions ;
    skos:definition "Connections among firms, entrepreneurs, suppliers, buyers, mentors, or peers that affect business activity or performance." ;
    skos:inScheme state: ;
    skos:prefLabel "Business networks" ;
    skos:scopeNote "Use for business-relevant ties and network structure, including supplier, customer, peer, referral, information-sharing, and interfirm connections. Do not use merely for generic social networks, network-analysis methods, network effects, employment platforms, supply chains, or the organizational form of a multinational firm. Use BusinessPartnerships for collaborative arrangements between firms or between firms and other organizations." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:BusinessPartnerships a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:BusinessNetworks ;
    skos:definition "Collaborative arrangements among firms or between firms and other organizations that support shared business activity or performance." ;
    skos:inScheme state: ;
    skos:prefLabel "Business partnerships" ;
    skos:scopeNote "Use for interfirm collaboration, consortia, joint business relationships, and other purposive collaborative arrangements. Use BusinessNetworks for the broader structure or extent of business-relevant ties without an established collaborative arrangement." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/PrivateSector> .

state:BusinessStrategy a skos:Concept,
