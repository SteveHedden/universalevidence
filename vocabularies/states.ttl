    skos:exactMatch <http://id.nlm.nih.gov/mesh/D045822> ;
    skos:inScheme state: ;
    skos:prefLabel "Intestinal volvulus" ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

