state:PersonalAutonomy a skos:Concept,
        ue:State ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader state:Wellbeing ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000080105> ;
    skos:definition "The degree to which individuals can make meaningful choices and direct their own lives in accordance with their values and preferences, free from controlling interference." ;
    skos:inScheme state: ;
    skos:prefLabel "Personal autonomy" ;
    skos:scopeNote "Use for perceived or actual self-direction and freedom of choice as a personal capability or quality-of-life dimension. Use IndividualAgency for general capacity to set and pursue goals, AgencyConstraints for restrictions on that capacity, ActivitiesOfDailyLiving or DisabilityStatus when clinical sources use autonomy to mean functional independence, and EconomicSecurity when self-sufficiency or self-reliance means the ability to meet material needs. Excludes organizational, governance, and machine autonomy." ;
    ue:bearer <https://universalevidence.com/vocab/subjects/Population> .

