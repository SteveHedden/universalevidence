    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "suicide prevention hotline" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Crisis hotline / mental health helpline" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DistanceCounselingIntervention> ;
