<https://universalevidence.com/vocab/interventions/EmploymentCreationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "job creation program" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "labor market activation" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/EmploymentPolicyIntervention> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/goal/8> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#16020> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate programs and policies designed to generate new jobs and productive employment opportunities, including public works, enterprise support, and labor market activation schemes." ;
    <http://www.w3.org/2004/02/skos/core#example> "A government youth employment program providing wage subsidies to firms hiring first-time workers." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "employment generation" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "job creation" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Employment creation intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/BusinessDevelopmentServices> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PublicWorksWorkfare> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/TradeRelatedAdjustmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/VocationalSkillsTraining> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from vocational training (VocationalSkillsTraining) which focuses on skills supply; this concept covers demand-side and structural job creation." .

