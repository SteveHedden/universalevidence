        ue:Intervention ;
    skos:altLabel "classroom rehabilitation",
        "school construction" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Construction, rehabilitation, or equipping of school buildings, classrooms, and educational infrastructure to improve access to and quality of education." ;
    skos:exactMatch dac:11120 ;
    skos:example "Construction of new primary school classrooms to reduce overcrowding and increase enrollment in rural areas." ;
    skos:hiddenLabel "education infrastructure",
        "school infrastructure" ;
    skos:inScheme uei: ;
    skos:prefLabel "Education facilities construction and rehabilitation" ;
