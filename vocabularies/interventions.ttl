<https://universalevidence.com/vocab/interventions/WASHEducationTraining>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "WASH capacity building" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "hygiene education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "water and sanitation training" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/HygienePromotionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D001494> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Education, training, and capacity-building programs to improve knowledge, skills, and behavior related to water supply, sanitation, and hygiene at individual, community, and institutional levels." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#14081> ;
    <http://www.w3.org/2004/02/skos/core#example> "A community hygiene promotion program combined with technician training for water system maintenance, evaluated for handwashing behavior and system functionality." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "sanitation education" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "water education" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "WASH education and training" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EnvironmentalEducationTrainingIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/HealthEducationBehaviourChange> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/VocationalSkillsTraining> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from HealthEducationBehaviourChange in that it targets WASH-specific technical capacity and professional training as well as community hygiene promotion." .

uei:WaterTransportIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Inland waterways",
        "Maritime transport",
        "Port development" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Development, rehabilitation, and management of ports, waterways, and maritime or inland water transport infrastructure." ;
    skos:exactMatch dac:21040 ;
    skos:example "Construction of a river port to facilitate trade along an inland waterway corridor." ;
    skos:hiddenLabel "port construction",
        "water transport infrastructure" ;
    skos:inScheme uei: ;
    skos:prefLabel "Water transport intervention" ;
    skos:related uei:RiverBasinDevelopment,
        uei:TransportPolicyAdministration ;
    skos:scopeNote "Covers maritime and inland water transport infrastructure; distinct from water supply or WASH interventions."  .

<https://universalevidence.com/vocab/interventions/ActiveLearningIntervention>
    <http://purl.org/dc/terms/created> "2026-06-07"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
