uei:EmergencyFoodAssistanceIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Crisis food assistance",
        "Humanitarian food aid" ;
    skos:broader uei:FoodTransfer ;
    skos:definition "Time-limited provision of food commodities, vouchers, or cash-for-food to populations facing acute food insecurity resulting from humanitarian crises, conflict, or natural disasters." ;
    skos:exactMatch dac:72040 ;
    skos:example "WFP distributes food rations to conflict-displaced households in a refugee camp for three months." ;
    skos:hiddenLabel "acute food relief",
        "emergency food aid" ;
    skos:inScheme uei: ;
    skos:prefLabel "Emergency food assistance" ;
    skos:related uei:FoodSecurityPolicyIntervention,
        uei:HouseholdFoodSecurityIntervention,
        uei:MaterialReliefAssistanceIntervention,
        uei:ReliefCoordinationIntervention ;
    skos:scopeNote "Distinct from developmental food security programs; this covers acute humanitarian food response rather than structural food insecurity interventions." .

<https://universalevidence.com/vocab/interventions/EnvironmentalEducationTrainingIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
