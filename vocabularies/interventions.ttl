    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "migration governance" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "safe migration programs" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/indicator/10_7_2> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15190> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Policies, agreements, administrative systems, and institutional capacity-building intended to facilitate safe, orderly, regular, and responsible migration and mobility." ;
    <http://www.w3.org/2004/02/skos/core#example> "A bilateral labor-migration agreement that establishes regulated recruitment, legal pathways, and migrant-protection procedures." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "migration facilitation" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "orderly migration" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "regular migration facilitation" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Migration management and facilitation" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/RemittanceFacilitationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for governance of migration flows and pathways; classify stand-alone migrant services, refugee reception or integration services, pre-departure training, information sessions, and remittance services under their action-specific concepts." .

uei:MonetaryInstitutionsDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Central bank development",
        "Monetary authority strengthening" ;
    skos:broader uei:MacroeconomicPolicyReform ;
    skos:definition "Deliberate programs to strengthen central banks, monetary authorities, and related financial regulatory institutions, including capacity building for monetary policy, financial stability, and central banking operations." ;
    skos:exactMatch dac:24020 ;
    skos:example "Technical assistance to a central bank to strengthen monetary policy frameworks and financial sector supervision." ;
    skos:hiddenLabel "central banking reform",
        "monetary institution support" ;
    skos:inScheme uei: ;
    skos:prefLabel "Monetary institutions development" ;
    skos:related uei:DebtReschedulingIntervention,
        uei:DomesticRevenueMobilisationIntervention,
        uei:PublicFinanceManagementReform ;
    skos:scopeNote "Focuses on monetary institutions specifically; broader public finance management reform is classified separately." .

uei:MultiHazardPreparednessIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Disaster preparedness",
        "Emergency preparedness",
        "Multi-hazard preparedness" ;
    skos:broader uei:DisasterRiskReductionIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000096763>,
        <http://id.nlm.nih.gov/mesh/D004189>,
        <http://id.nlm.nih.gov/mesh/D055872>,
        <https://id.nlm.nih.gov/mesh/D000096763>,
        <https://id.nlm.nih.gov/mesh/D004189> ;
    skos:definition "Programs that strengthen the capacity of governments, communities, and institutions to anticipate, prepare for, and respond to multiple types of natural or human-made hazards, including early warning systems, contingency planning, and emergency response training." ;
    skos:exactMatch dac:74020 ;
    skos:example "National government invests in early warning systems and community emergency response teams trained to respond to both floods and earthquakes." ;
    skos:hiddenLabel "DRR preparedness",
        "hazard response preparedness",
        "multi hazard preparedness" ;
    skos:inScheme uei: ;
    skos:prefLabel "Multi-hazard response preparedness" ;
    skos:related uei:EmergencyMedicalDispatchIntervention,
        uei:PostEmergencyReconstructionIntervention,
        uei:ReliefCoordinationIntervention ;
    skos:scopeNote "Focuses on preparedness and response capacity-building across multiple hazard types, as distinct from single-hazard mitigation or post-disaster reconstruction." .

<https://universalevidence.com/vocab/interventions/MultisectorEducationTrainingIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Cross-sector training" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Integrated education program" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/TrainingAndCapacityBuilding> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Education and training programs that span multiple sectors simultaneously — such as health, environment, and governance — rather than being confined to a single sectoral domain." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#43081> ;
    <http://www.w3.org/2004/02/skos/core#example> "Integrated health and environment education programs delivered through community development projects." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "cross-sectoral training" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "multisectoral education" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Multisector education and training" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/VocationalSkillsTraining> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinguished from single-sector training programs by its deliberate cross-sectoral scope." .

uei:NarcoticsControlIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Counter-narcotics",
        "Drug control",
        "Illicit drug control" ;
    skos:broader uei:SubstanceUseControlIntervention ;
    skos:definition "Law enforcement, policy, and demand-reduction programs designed to prevent the production, trafficking, and use of illicit narcotics." ;
    skos:exactMatch dac:16063 ;
    skos:example "A program combining police training for drug interdiction with community-based drug prevention education." ;
    skos:hiddenLabel "drug enforcement",
        "narcotics program" ;
    skos:inScheme uei: ;
    skos:prefLabel "Narcotics control intervention" ;
    skos:related uei:AgriculturalAlternativeDevelopmentIntervention,
        uei:NonAgriculturalAlternativeDevelopmentIntervention,
        uei:SecuritySectorReformIntervention ;
    skos:scopeNote "Covers supply-side law enforcement and interdiction as well as demand-reduction; broader than clinical substance use treatment by including security and policy dimensions." .

uei:NonAgriculturalAlternativeDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Illicit economy transition",
        "Non-farm alternative development" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs that support communities dependent on illicit economies — such as drug trafficking or illegal mining — to transition to legal non-agricultural livelihoods through enterprise development, skills training, and economic diversification." ;
    skos:exactMatch dac:43050 ;
    skos:example "Enterprise development programs supporting ex-combatants and drug traders in Colombia to transition into formal non-farm livelihoods." ;
    skos:hiddenLabel "alternative livelihood non-agricultural",
        "drug crop substitution non-farm" ;
    skos:inScheme uei: ;
    skos:prefLabel "Non-agricultural alternative development" ;
    skos:related uei:AgriculturalAlternativeDevelopmentIntervention,
        uei:NarcoticsControlIntervention,
        uei:VocationalSkillsTraining ;
    skos:scopeNote "Distinguished from AgriculturalAlternativeDevelopmentIntervention by its focus on non-farming pathways out of illicit economies." .

uei:NudgeIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:PersuasionFramingNudgeIntervention ;
    skos:definition "A behavioral intervention that changes choice architecture, defaults, salience, reminders, or framing to influence decisions without restricting options." ;
    skos:inScheme uei: ;
    skos:prefLabel "Nudge intervention" .

uei:ObstetricDeliveryIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader uei:ReproductiveHealthCareIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D004841>,
        <http://id.nlm.nih.gov/mesh/D009772>,
        <https://id.nlm.nih.gov/mesh/D000088103>,
        <https://id.nlm.nih.gov/mesh/D004841>,
        <https://id.nlm.nih.gov/mesh/D009772> ;
    skos:definition "Clinical care and procedures supporting childbirth, including vaginal or assisted delivery." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D036861>,
        <https://id.nlm.nih.gov/mesh/D036861> ;
    skos:inScheme uei: ;
    skos:prefLabel "Obstetric delivery" .

uei:OtherDebtSwapIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Debt-for-equity swap",
        "Non-development debt swap" ;
    skos:broader uei:DebtActionIntervention ;
    skos:definition "Debt conversion mechanisms not classified as debt-for-development swaps, including debt-for-equity swaps and other non-development-conditioned debt conversions." ;
    skos:exactMatch dac:60062 ;
    skos:example "Debt-for-equity swap converting a country's bilateral debt into equity stakes in state-owned enterprises." ;
    skos:hiddenLabel "commercial debt swap",
        "debt conversion" ;
    skos:inScheme uei: ;
    skos:prefLabel "Other debt swap" ;
    skos:related uei:DebtBuyBackIntervention,
        uei:DebtForDevelopmentSwapIntervention,
        uei:DebtReschedulingIntervention ;
    skos:scopeNote "Residual category for debt swap modalities that do not carry a specific development conditionality; see DebtForDevelopmentSwapIntervention for development-linked swaps." .

uei:PharmaceuticalProductionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Drug manufacturing",
        "Local pharmaceutical manufacturing",
        "Medicine production" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments to develop domestic pharmaceutical manufacturing capacity, including generic medicines, vaccines, and medical supplies production in low- and middle-income countries." ;
    skos:exactMatch dac:32168 ;
    skos:example "An investment supporting a domestic generic medicines factory to reduce a country's dependence on imported essential medicines." ;
    skos:hiddenLabel "generic drug production",
        "pharma industry" ;
    skos:inScheme uei: ;
    skos:prefLabel "Pharmaceutical production development" ;
    skos:related uei:HealthPolicyAdministration,
        uei:IndustrialDevelopmentIntervention ;
    skos:scopeNote "Covers industrial pharmaceutical manufacturing; distinct from health procurement and supply chain interventions which focus on distribution and access."  .

uei:PolicyCommunicationIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:AdvisoryInformationIntervention ;
    skos:definition "Communication intended to inform people, organizations, or officials about policies, rules, rights, or public programs." ;
    skos:inScheme uei: ;
    skos:prefLabel "Policy communication" ;
    skos:related uei:EvidenceBasedPolicyIntervention,
        uei:ExpectationsManagementIntervention .

uei:PreoperativeAssessmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "pre-surgical assessment",
        "preoperative evaluation",
        "surgical fitness evaluation" ;
    skos:broader uei:PreoperativeCare ;
    skos:definition "Structured clinical evaluation of a patient's fitness for surgery — including medical history review, investigations, and risk stratification — conducted prior to an elective or emergency procedure." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068436>,
        <https://id.nlm.nih.gov/mesh/D000068436> ;
    skos:example "Implementation of a standardised preoperative assessment protocol for all elective surgeries to reduce cancellations and adverse events." ;
    skos:hiddenLabel "pre-op assessment",
        "surgical clearance" ;
    skos:inScheme uei: ;
    skos:prefLabel "Preoperative assessment and surgical clearance" ;
    skos:related uei:HealthcareFailureModeEffectAnalysisIntervention,
        uei:IndependentMedicalEvaluationIntervention,
        uei:SurgicalTimeOutIntervention ;
    skos:scopeNote "A perioperative quality and safety process; related to SurgicalTimeOutIntervention which is an intraoperative safety check." .

<https://universalevidence.com/vocab/interventions/PrimaryEducationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "basic education program" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "elementary education intervention" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/EducationPolicyAdministration> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#11220> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs and investments designed to improve enrollment, attendance, quality, and learning outcomes at the primary school level." ;
    <http://www.w3.org/2004/02/skos/core#example> "A government program providing free textbooks and school supplies to all primary school pupils." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "primary schooling program" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Primary education intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/RemediationTutoring> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ScholarshipBursary> .

uei:RailTransportIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Rail infrastructure",
        "Railway construction" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Construction, rehabilitation, and management of railways and rail infrastructure to improve freight and passenger connectivity." ;
    skos:exactMatch dac:21030 ;
    skos:example "Investment in rehabilitating a national freight railway to reduce transport costs for agricultural exporters." ;
    skos:hiddenLabel "rail building",
        "railway rehabilitation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Rail transport intervention" ;
    skos:related uei:RoadTransportIntervention,
        uei:TransportPolicyAdministration ;
    skos:scopeNote "Specific to rail mode; distinct from road, water, and air transport interventions."  .

uei:RenalReplacementTherapyIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-16"^^xsd:date ;
    skos:altLabel "dialysis" ;
    skos:broader uei:TransfusionApheresisAndExtracorporealSupport ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D006437>,
        <http://id.nlm.nih.gov/mesh/D007688>,
        <http://id.nlm.nih.gov/mesh/D010530>,
        <http://id.nlm.nih.gov/mesh/D010531>,
        <https://id.nlm.nih.gov/mesh/D000079763>,
        <https://id.nlm.nih.gov/mesh/D010530> ;
    skos:definition "Therapies that replace kidney filtration function, including dialysis, hemofiltration, and related extracorporeal treatments." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D003956>,
        <http://id.nlm.nih.gov/mesh/D017582>,
        <https://id.nlm.nih.gov/mesh/D003956>,
        <https://id.nlm.nih.gov/mesh/D017582> ;
    skos:inScheme uei: ;
    skos:prefLabel "Renal replacement therapy" .

<https://universalevidence.com/vocab/interventions/ResponsibleBusinessConductIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "CSR promotion" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Corporate social responsibility interventions" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "ESG standards" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "corporate social responsibility" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/BusinessPolicyAdministrationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs, regulatory actions, and capacity-building to promote corporate social responsibility, environmental and social standards, anti-corruption compliance, and ethical business practices in the private sector." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D040861> ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://id.nlm.nih.gov/mesh/D040861> ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#25040> ;
    <http://www.w3.org/2004/02/skos/core#example> "A program supports the adoption of international responsible business conduct guidelines by garment manufacturers to improve labour and environmental standards." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "business ethics" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "corporate accountability" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Responsible business conduct promotion" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AntiCorruptionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EthicalReminderIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/LabourRightsIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers voluntary and mandatory frameworks for ethical business behaviour; distinct from anti-corruption interventions in the public sector." .

uei:RiverBasinDevelopment a skos:Concept,
        ue:Intervention ;
    skos:altLabel "river basin management",
        "watershed development" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Planned investment and management of river basin resources for water supply, irrigation, flood control, and hydropower, typically involving infrastructure and multi-stakeholder coordination." ;
    skos:exactMatch dac:14040 ;
    skos:example "A river basin development project evaluated for agricultural water availability and household water access outcomes." ;
    skos:hiddenLabel "catchment development" ;
    skos:inScheme uei: ;
    skos:prefLabel "River basin development" ;
    skos:related uei:AgriculturalWaterResourcesIntervention,
        uei:WaterResourcesConservation,
        uei:WaterTransportIntervention ;
    skos:scopeNote "Overlaps with AgriculturalIntervention (irrigation) and ClimateAndEnvironment; classify here when the primary focus is water resource development." .

uei:SPECTCTImagingIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "SPECT/CT",
        "Single photon emission CT" ;
    skos:broader uei:BiomedicalLaboratoryAndTissueOperations ;
    skos:definition "A combined nuclear medicine and radiological imaging procedure that integrates single photon emission computed tomography with conventional CT scanning to provide simultaneous functional and anatomical imaging for diagnostic purposes." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072098>,
        <https://id.nlm.nih.gov/mesh/D000072098> ;
    skos:example "Use of SPECT-CT to assess myocardial perfusion and bone lesion localisation in oncology patients." ;
    skos:hiddenLabel "SPECTCT",
        "spect ct scan" ;
    skos:inScheme uei: ;
    skos:prefLabel "SPECT-CT imaging" ;
    skos:related uei:PETCTImagingIntervention,
        uei:SinglePhotonEmissionComputedTomography .

uei:STDControlIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "STI control",
        "sexually transmitted infection control" ;
    skos:broader uei:InfectiousDiseaseControlIntervention ;
    skos:definition "Programs to prevent, diagnose, and treat sexually transmitted infections and diseases, including HIV/AIDS, syphilis, gonorrhea, and other STIs, through testing, treatment, and behavior change communication." ;
    skos:exactMatch dac:13040 ;
    skos:example "A syndromic STI management program in clinics evaluated for gonorrhea and syphilis treatment rates." ;
    skos:hiddenLabel "STD program",
        "venereal disease control" ;
    skos:inScheme uei: ;
    skos:prefLabel "STI/STD control intervention" ;
    skos:related uei:AntiretroviralTherapy,
        uei:FamilyPlanningServices,
        uei:HIVAidsTreatmentIntervention ;
    skos:scopeNote "HIV/AIDS-specific interventions are covered under HIVAidsTreatmentIntervention; this concept covers the broader STI control field." .

uei:ScholarshipBursary a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Educational grant",
        "Stipend" ;
    skos:broader uei:Transfer ;
    skos:definition "Financial support — scholarships, bursaries, or stipends — to enable students to access or remain in education." ;
    skos:inScheme uei: ;
    skos:prefLabel "Scholarship / bursary" ;
    skos:related uei:HigherEducationIntervention,
        uei:PrimaryEducationIntervention,
        uei:SecondaryEducationIntervention .

uei:StatisticalCapacityBuilding a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Data systems capacity building",
        "National statistics strengthening" ;
    skos:broader uei:PublicAdministrationReform ;
    skos:closeMatch <https://id.nlm.nih.gov/mesh/D014798> ;
    skos:definition "Programs that strengthen the capacity of national statistical offices and government agencies to collect, analyze, and disseminate high-quality data for evidence-based policy." ;
    skos:exactMatch dac:16062 ;
    skos:example "Technical assistance to a national statistics bureau to improve household survey methodology and data publication." ;
    skos:hiddenLabel "NSO strengthening",
        "statistics capacity building" ;
    skos:inScheme uei: ;
    skos:prefLabel "Statistical capacity building" ;
    skos:related uei:DomesticRevenueMobilisationIntervention,
        uei:PublicFinanceManagementReform,
        uei:ResearchInstitutionStrengtheningIntervention ;
    skos:scopeNote "Focuses specifically on statistical systems and data production; distinct from general public administration reform by its technical statistical focus." .

uei:TechnologicalResearchDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "R&D",
        "industrial research and development",
        "technology R&D" ;
    skos:broader uei:IndustrialDevelopmentIntervention ;
    skos:closeMatch <https://id.nlm.nih.gov/mesh/D013675> ;
    skos:definition "Organized research, development, and innovation activities aimed at advancing industrial technologies and applied science to support economic development." ;
    skos:exactMatch dac:32182 ;
    skos:example "Funding of a national technology innovation centre to develop manufacturing process improvements." ;
    skos:hiddenLabel "tech R and D",
        "technological R&D" ;
    skos:inScheme uei: ;
    skos:prefLabel "Technological research and development" ;
    skos:related uei:AgriculturalResearchIntervention,
        uei:EnergyResearch,
        uei:TheranosticNanomedicineIntervention ;
    skos:scopeNote "Covers industrial and cross-sector technology R&D; sector-specific research (energy, agriculture, fishery) is covered by dedicated research concepts." .

uei:TelerehabilitationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "digital rehabilitation",
        "online rehabilitation",
        "remote rehabilitation" ;
    skos:broader uei:RehabilitationAndPhysicalTherapyIntervention ;
    skos:definition "Delivery of rehabilitation services — including physical, occupational, speech, or mental health therapy — through digital communication technologies such as video conferencing or mobile applications." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069350>,
        <https://id.nlm.nih.gov/mesh/D000069350> ;
    skos:example "Video-based physiotherapy for stroke survivors in rural settings assessed for motor function recovery." ;
    skos:hiddenLabel "tele-rehab",
        "virtual rehabilitation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Telerehabilitation" ;
    skos:related uei:NeurologicalRehabilitationIntervention,
        uei:PsychiatricRehabilitationIntervention,
        uei:StrokeRehabilitationIntervention ;
    skos:scopeNote "Covers remote delivery of rehabilitation; distinct from distance counseling which focuses on psychological support." .

uei:TextilesLeatherIndustryIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Garment industry",
        "Leather goods industry",
        "Textile manufacturing" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments to develop textile, garment, leather goods, and related manufacturing industries in low- and middle-income countries." ;
    skos:exactMatch dac:32163 ;
    skos:example "A trade-related investment program supporting a country's garment export sector through factory upgrading and compliance with labor standards." ;
    skos:hiddenLabel "apparel industry",
        "textile sector" ;
    skos:inScheme uei: ;
    skos:prefLabel "Textiles, leather, and substitutes industry development" ;
    skos:related uei:CottageIndustriesHandicraftIntervention,
        uei:IndustrialDevelopmentIntervention  .

uei:TransportStorageEducationTraining a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Logistics training",
        "Transport workforce training" ;
    skos:broader uei:VocationalSkillsTraining ;
    skos:definition "Vocational and technical training programs that build workforce skills in transport operations, logistics, and storage management." ;
    skos:exactMatch dac:21081 ;
    skos:example "Training program for truck drivers and warehouse managers to improve road safety and reduce commodity losses." ;
    skos:hiddenLabel "storage training",
        "transport training" ;
