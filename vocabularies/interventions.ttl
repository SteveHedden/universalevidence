uei:HealthPolicyAdministration a skos:Concept,
        ue:Intervention ;
    skos:altLabel "health sector reform",
        "health system management",
        "health system strengthening" ;
    skos:broader uei:HealthSystemsAndServiceDeliveryIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000078482>,
        <http://id.nlm.nih.gov/mesh/D000098485>,
        <http://id.nlm.nih.gov/mesh/D002028>,
        <http://id.nlm.nih.gov/mesh/D002204>,
        <http://id.nlm.nih.gov/mesh/D002567>,
        <http://id.nlm.nih.gov/mesh/D006286>,
        <http://id.nlm.nih.gov/mesh/D006287>,
        <http://id.nlm.nih.gov/mesh/D006298>,
        <http://id.nlm.nih.gov/mesh/D006759>,
        <http://id.nlm.nih.gov/mesh/D014341>,
        <http://id.nlm.nih.gov/mesh/D019981>,
        <http://id.nlm.nih.gov/mesh/D020793>,
        <http://id.nlm.nih.gov/mesh/D021661>,
        <http://id.nlm.nih.gov/mesh/D032024>,
        <http://id.nlm.nih.gov/mesh/D057193>,
        <https://id.nlm.nih.gov/mesh/D002204>,
        <https://id.nlm.nih.gov/mesh/D006286>,
        <https://id.nlm.nih.gov/mesh/D006298>,
        <https://id.nlm.nih.gov/mesh/D006759>,
        <https://id.nlm.nih.gov/mesh/D014341>,
        <https://id.nlm.nih.gov/mesh/D019981>,
        <https://id.nlm.nih.gov/mesh/D020793> ;
    skos:definition "Deliberate reforms, capacity-building, and administrative actions to improve the governance, management, financing, and delivery of health systems. Includes policy development, institutional strengthening, and sector planning." ;
    skos:exactMatch dac:12110 ;
    skos:example "A program to strengthen a ministry of health's pharmaceutical supply chain management and health information systems." ;
    skos:hiddenLabel "health administration",
        "health governance reform" ;
    skos:inScheme uei: ;
    skos:prefLabel "Health policy and administration" ;
    skos:related uei:ConciergeMedicineIntervention,
        uei:EvidenceBasedFacilityDesignIntervention,
        uei:NCDControlIntervention,
        uei:PharmaceuticalProductionIntervention,
        uei:PublicAdministrationReform,
        uei:TobaccoControlIntervention,
        uei:WaterSectorPolicyAdministration ;
    skos:scopeNote "Focuses on system-level governance and management; distinct from direct clinical service delivery." .

<https://universalevidence.com/vocab/interventions/>
    <http://purl.org/dc/terms/creator> "Steve Hedden" ;
    <http://purl.org/dc/terms/description> "Development and health interventions. Used as the ue:InterventionAxis vocabulary." ;
