    dcterms:source <https://clinicaltrials.gov/study/NCT02481466> .

uei:ExperimentalSleepRestrictionIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:ScreeningTestingAndClinicalEvaluation ;
    skos:definition "Protocol-directed reduction of sleep opportunity or time in bed to evaluate physiological, metabolic, cognitive, or behavioral responses." ;
    skos:inScheme uei: ;
    skos:prefLabel "Experimental sleep restriction" ;
    skos:scopeNote "Includes partial sleep restriction imposed in a clinical research protocol, such as reducing nightly time in bed. Excludes naturally occurring sleep loss, assessment of habitual sleep without restriction, and sleep restriction prescribed as treatment for insomnia." .

uei:MusicListeningIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Music listening"@en ;
    skos:definition "Protocol-directed listening to recorded or live music as a clinical or behavioral intervention or comparison condition."@en ;
    skos:scopeNote "Includes passive background-music listening. Does not imply therapist-led music therapy, active music-making, or demonstrated therapeutic benefit."@en ;
    skos:broader uei:BehavioralMentalAndPsychosocialCareIntervention ;
    skos:inScheme uei: ;
    <http://purl.org/dc/terms/source> <https://clinicaltrials.gov/study/NCT02999360> .

