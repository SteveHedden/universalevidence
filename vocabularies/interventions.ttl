    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D000070456> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Telephone or digital crisis intervention services providing immediate support to individuals experiencing mental health emergencies or suicidal ideation, such as the 988 Suicide and Crisis Lifeline." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D015277> ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://id.nlm.nih.gov/mesh/D000070456> ;
