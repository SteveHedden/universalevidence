    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://id.nlm.nih.gov/mesh/D032541> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#12250> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Public-health, health-service, and clinical measures to prevent, detect, interrupt transmission of, contain, or treat infectious and communicable diseases, ranging from facility infection-control practices and disease-specific services to population-level surveillance, vaccination, vector control, and multi-disease programs." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D003140> ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://id.nlm.nih.gov/mesh/D003140> ;
    <http://www.w3.org/2004/02/skos/core#example> "A national disease surveillance and rapid response program to detect and contain emerging infectious disease outbreaks." ;
