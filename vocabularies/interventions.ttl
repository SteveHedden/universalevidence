uei:CaseManagementIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "care management" ;
    skos:broader uei:CareCoordinationIntervention ;
    skos:definition "A coordinated service delivery approach in which a designated case manager assesses, plans, and coordinates health or social services for individuals with complex needs, aiming to improve outcomes and reduce fragmented care." ;
    skos:exactMatch <https://id.nlm.nih.gov/mesh/D019090> ;
    skos:example "Nurse-led case management for patients with chronic heart failure to reduce hospital readmissions." ;
    skos:hiddenLabel "case manager intervention",
        "patient case management" ;
    skos:inScheme uei: ;
    skos:prefLabel "Case management" ;
    skos:related uei:CollaborativeCareIntervention,
        uei:CommunityHealthWorker,
        uei:PsychiatricRehabilitationIntervention ;
    skos:scopeNote "May span health and social service contexts; distinct from pure clinical care delivery." .

<https://universalevidence.com/vocab/interventions/CrisisHotlineService>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
