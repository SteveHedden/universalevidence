uei:CybersecurityIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:altLabel "Cyber interventions" ;
    skos:broader uei:SecuritySectorReformIntervention ;
    skos:definition "Programs that strengthen the secure adoption and operation of digital systems through technical safeguards, risk-management processes, security services, policy controls, or user capability-building." ;
    skos:scopeNote "Use when protection of digital systems, data, or users is the intervention’s unifying purpose; classify stand-alone cybersecurity advice or skills training under DigitalLiteracyTraining and product security labels under ProductLabelingIntervention." ;
    skos:inScheme uei: ;
    skos:prefLabel "Cybersecurity interventions" .

uei:CystectomyIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-12"^^xsd:date ;
    skos:broader uei:ReproductiveUrologicSurgeryIntervention ;
    skos:definition "Surgical removal of all or part of the urinary bladder or a cyst, depending on clinical context." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D015653>,
        <https://id.nlm.nih.gov/mesh/D015653> ;
    skos:inScheme uei: ;
    skos:prefLabel "Cystectomy" .

uei:CystographyIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Cystourethrography",
        "VCUG",
        "Voiding cystourethrography" ;
    skos:broader uei:AngiographicAndContrastImaging ;
    skos:definition "A diagnostic imaging procedure in which contrast medium is introduced into the urinary bladder — via catheter or intravenously — and radiographic images are taken to evaluate bladder anatomy, function, or pathology." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070621>,
        <https://id.nlm.nih.gov/mesh/D000070621> ;
    skos:example "Use of voiding cystourethrography to diagnose vesicoureteral reflux in children with recurrent urinary tract infections." ;
    skos:hiddenLabel "bladder X-ray",
        "cystogram" ;
    skos:inScheme uei: ;
    skos:prefLabel "Cystography" .

uei:CystoscopyIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-11"^^xsd:date ;
    skos:broader uei:EndoscopicDiagnosticProcedureIntervention ;
    skos:definition "Endoscopic examination of the bladder and urethra for diagnosis or treatment." ;
    skos:scopeNote "Map when cystoscopy itself, a cystoscopic modality, its assigned timing or frequency, or cystoscopy-guided treatment is an assigned intervention, comparator, or central evaluated procedure. Routine or common screening, follow-up, reference-standard or outcome-only cystoscopy, preparation or drugs merely given around cystoscopy, and incidental cystoscope use are outside scope." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D003558>,
        <https://id.nlm.nih.gov/mesh/D003558> ;
    skos:altLabel "cystoscopic examination",
        "cystourethroscopy",
        "urethrocystoscopy" ;
    skos:inScheme uei: ;
    skos:prefLabel "Cystoscopy" .

