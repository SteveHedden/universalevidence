<https://universalevidence.com/vocab/interventions/PublicFinanceManagementReform>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Financial policy and administrative management" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "PFM reform" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "fiscal management reform" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#24010> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate reforms to government budgeting, treasury, audit, and public expenditure systems to improve fiscal discipline, transparency, and accountability in the use of public funds." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15111> ;
    <http://www.w3.org/2004/02/skos/core#example> "An MTEF and IFMIS rollout across line ministries to improve budget execution and reduce leakage." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "PFM" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "public financial management" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Public finance management reform" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AntiCorruptionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DecentralisationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DomesticRevenueMobilisationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MacroeconomicPolicyReform> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MonetaryInstitutionsDevelopmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PrivatisationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PublicProcurementReform> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/StatisticalCapacityBuilding> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Focuses on the institutional and procedural architecture of public expenditure; distinct from domestic revenue mobilisation which addresses the revenue side." .

