    <http://www.w3.org/2004/02/skos/core#definition> "Legal, financial, mediation, or service interventions intended to prevent eviction or resolve landlord-tenant disputes before displacement." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Eviction diversion intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DisputeResolutionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/LegalAidIntervention> .

<https://universalevidence.com/vocab/interventions/EvidenceBasedPolicyIntervention>
    <http://purl.org/dc/terms/created> "2026-06-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
