<https://universalevidence.com/vocab/interventions/CultureAndDiversityIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Cultural heritage program" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Intercultural dialogue initiative" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/InformationAndCommunication> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#16061> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs that promote, preserve, or strengthen cultural heritage, cultural diversity, and intercultural dialogue in development contexts." ;
    <http://www.w3.org/2004/02/skos/core#example> "A program funding indigenous language revitalization and community cultural centers." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "cultural diversity aid" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "culture program" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Culture and cultural diversity intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DemocraticParticipationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/HumanRightsIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/SitePreservationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers investments in cultural institutions, heritage preservation, and intercultural exchange; excludes culturally adapted or culturally competent healthcare and behavioral interventions, which are delivery adaptations rather than cultural heritage programs." .

<https://universalevidence.com/vocab/interventions/DdrSalwIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
