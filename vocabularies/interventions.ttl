<https://universalevidence.com/vocab/interventions/EnergyEfficiencyIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Demand-side energy management" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Energy efficiency program" ;
