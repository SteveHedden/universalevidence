uei:WaterResourcesConservation a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Conservation of Water Resources",
        "freshwater management",
        "water conservation" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Actions to protect, manage, and monitor freshwater resources — including rivers, aquifers, and watersheds — to ensure sustainable availability for human and ecological use." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000074067>,
        <https://id.nlm.nih.gov/mesh/D000074067>,
        dac:14015 ;
    skos:example "A watershed monitoring and protection program evaluated for groundwater recharge and water availability outcomes." ;
    skos:hiddenLabel "hydrological data collection",
        "water resource management" ;
    skos:inScheme uei: ;
    skos:prefLabel "Water resources conservation" ;
    skos:related uei:AgriculturalWaterResourcesIntervention,
        uei:BiosphereProtectionIntervention,
        uei:RiverBasinDevelopment,
        uei:WaterSectorPolicyAdministration ;
    skos:scopeNote "Focuses on resource sustainability rather than direct service delivery; overlaps with ClimateAndEnvironment domain." .

uei:WaterSupplyIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:WaterAndSanitationIntervention ;
    skos:definition "Interventions that improve the provision, treatment, or delivery of safe water to populations."@en ;
    skos:inScheme uei: ;
    skos:prefLabel "Water supply intervention"@en .

uei:AccidentPreventionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Injury prevention",
        "Unintentional injury prevention" ;
    skos:broader uei:EnvironmentalPolicyAdministrationIntervention ;
    skos:definition "Deliberate programs, regulations, and measures designed to reduce the incidence and severity of unintentional injuries and accidents across home, workplace, road, and other settings." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000056>,
        <https://id.nlm.nih.gov/mesh/D000056> ;
    skos:example "A national road safety campaign combining speed enforcement and public awareness to reduce traffic accidents." ;
    skos:hiddenLabel "accident reduction",
        "safety intervention" ;
    skos:inScheme uei: ;
    skos:prefLabel "Accident prevention intervention" ;
    skos:related uei:DisasterRiskReductionIntervention ;
    skos:scopeNote "Covers prevention of unintentional accidents and injuries; distinct from disaster risk reduction and violence prevention." .

