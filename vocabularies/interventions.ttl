    <http://www.w3.org/2004/02/skos/core#altLabel> "defence reform" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15210> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate programs to reform and professionalize security institutions — military, police, and intelligence services — to improve civilian oversight, effectiveness, and respect for human rights." ;
    <http://www.w3.org/2004/02/skos/core#example> "Vetting and retraining of national police to improve community relations and reduce use of excessive force." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "security management reform" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "security system reform" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Security sector reform" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DdrSalwIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/NarcoticsControlIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PeacebuildingIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PeacekeepingSecurityIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/SecuritySectorReform> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers institutional reform of security forces; peacekeeping deployments are captured under PeacekeepingSecurityIntervention." .

uei:StorageInfrastructureIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Cold chain infrastructure",
        "Grain storage",
        "Warehouse development" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Construction and improvement of warehouses, silos, and cold-chain storage facilities to reduce post-harvest losses and support supply chains." ;
    skos:exactMatch dac:21061 ;
    skos:example "Construction of community grain silos to reduce post-harvest losses for smallholder farmers." ;
    skos:hiddenLabel "post-harvest storage",
        "storage facilities" ;
    skos:inScheme uei: ;
    skos:prefLabel "Storage infrastructure intervention" ;
    skos:related uei:AgroIndustriesIntervention,
        uei:PlantProtectionPestControlIntervention,
        uei:RoadTransportIntervention,
        uei:TransportStorageEducationTraining ;
    skos:scopeNote "Covers physical storage infrastructure for commodities; distinct from transport infrastructure interventions, though often complementary."  .

uei:TransitionalCareIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "care transitions",
        "discharge care coordination",
        "post-discharge care" ;
    skos:broader uei:HealthPolicyAdministration ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000088745>,
        <https://id.nlm.nih.gov/mesh/D000088745> ;
    skos:definition "Structured programs and processes that coordinate and ensure continuity of health care as patients move between different levels or settings of care, such as from hospital to home or from paediatric to adult services." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069341>,
        <https://id.nlm.nih.gov/mesh/D000069341> ;
    skos:example "Hospital-to-home transitional care programs for elderly patients reducing 30-day readmission rates." ;
    skos:hiddenLabel "transition of care",
        "transitional care program" ;
    skos:inScheme uei: ;
    skos:prefLabel "Transitional care" ;
    skos:related uei:AdultDayCareIntervention,
        uei:CommunityHealthWorker,
        uei:PatientPortalIntervention ;
    skos:scopeNote "Distinct from community health worker programs — focuses specifically on the handover between care settings rather than community-based delivery." .

uei:VectorControlIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:InfectiousDiseaseControlIntervention ;
    skos:definition "Environmental, biological, chemical, genetic, or personal-protection measures that reduce vector populations or interrupt transmission of vector-borne disease." ;
    skos:inScheme uei: ;
    skos:prefLabel "Vector control interventions" .

