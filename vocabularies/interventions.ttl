<https://universalevidence.com/vocab/interventions/ConstructionPolicyAdministration>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "building sector policy" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "construction sector governance" ;
