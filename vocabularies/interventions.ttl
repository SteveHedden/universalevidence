        "personal health record portal" ;
    skos:broader uei:HealthInformationSystemsAndDecisionSupport ;
    skos:definition "Deployment and use of secure online platforms that allow patients to access their health records, communicate with providers, request prescriptions, and manage appointments, aimed at improving patient engagement and care continuity." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072638> ;
