    skos:example "A development finance investment in a domestic agrochemical blending facility to reduce import dependence." ;
    skos:hiddenLabel "industrial chemicals",
        "petrochemicals" ;
    skos:inScheme uei: ;
    skos:prefLabel "Chemicals industry development" ;
    skos:related uei:FertilizerPlantIntervention,
