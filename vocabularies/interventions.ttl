uei:GeneEditingIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "CRISPR therapy",
        "gene modification",
        "genome editing" ;
    skos:broader uei:NCDControlIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000098986>,
        <http://id.nlm.nih.gov/mesh/D052416>,
        <http://id.nlm.nih.gov/mesh/D055879>,
        <https://id.nlm.nih.gov/mesh/D000098986>,
        <https://id.nlm.nih.gov/mesh/D052416>,
        <https://id.nlm.nih.gov/mesh/D055879> ;
    skos:definition "A therapeutic or preventive approach in which specific sequences of an organism's DNA are deliberately altered, inserted, or deleted using molecular tools such as CRISPR-Cas9, TALENs, or zinc finger nucleases, to treat or prevent genetic diseases." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072669>,
        <https://id.nlm.nih.gov/mesh/D000072669> ;
    skos:example "CRISPR-based gene editing of haematopoietic stem cells to cure sickle cell disease in clinical trials." ;
    skos:hiddenLabel "CRISPR-Cas9",
        "gene scissor",
        "genome engineering" ;
    skos:inScheme uei: ;
    skos:prefLabel "Gene editing intervention" ;
    skos:related uei:RNAiTherapeuticsIntervention,
        uei:SelectiveBreedingIntervention ;
    skos:scopeNote "Covers clinical and near-clinical therapeutic gene editing; distinct from agricultural selective breeding." .

uei:HealthSmartCardIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "electronic health card",
        "health ID card",
        "patient smart card" ;
    skos:broader uei:HealthInformationSystemsAndDecisionSupport ;
    skos:definition "Deployment of electronic smart cards that store patient health records and facilitate access to health services, enabling continuity of care and reducing administrative barriers." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069098> ;
    skos:example "Rwanda's Ubudehe health smart card program improving health service access tracking among low-income households." ;
    skos:hiddenLabel "health smartcard",
        "medical smart card" ;
    skos:inScheme uei: ;
    skos:prefLabel "Health smart card intervention" ;
    skos:related uei:ICTInfrastructureIntervention,
        uei:PatientPortalIntervention ;
    skos:scopeNote "Covers smart card systems as a health system tool; related to ICT infrastructure but specifically applied in health service delivery." .

uei:HeatPlantIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Heating plants",
        "Thermal energy plants" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Construction, rehabilitation, or expansion of dedicated heat generation plants that supply thermal energy for residential, commercial, or industrial use, distinct from combined heat and power systems." ;
    skos:exactMatch dac:23610 ;
    skos:example "Rehabilitation of a central heat plant supplying hot water to a residential district in Central Asia." ;
    skos:hiddenLabel "boiler plant",
        "heat generation plant" ;
    skos:inScheme uei: ;
    skos:prefLabel "Heat plant development" ;
    skos:related uei:DistrictHeatingCoolingIntervention,
        uei:EnergyEfficiencyIntervention ;
    skos:scopeNote "Covers standalone heat plants; district heating distribution networks are classified separately." .

uei:HybridEnergySystemIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Combined energy generation",
        "Hybrid power systems" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Development of power generation systems that combine two or more energy sources — such as solar and diesel, or wind and storage — to improve reliability and efficiency of electricity supply." ;
    skos:exactMatch dac:23410 ;
    skos:example "Installation of a solar-diesel hybrid mini-grid system in a remote rural community." ;
    skos:hiddenLabel "hybrid power plant",
        "mixed energy system" ;
    skos:inScheme uei: ;
    skos:prefLabel "Hybrid energy power plant development" ;
    skos:related uei:MiniGridDistributionIntervention,
        uei:RenewableEnergyGenerationIntervention .

uei:ImportSupportCapitalGoodsIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Capital goods import financing",
        "Equipment import support" ;
    skos:broader uei:TradePolicyAdministrationIntervention ;
    skos:definition "Financial assistance provided to enable developing countries to import capital goods — machinery, equipment, and technology — required for productive investment and development." ;
    skos:exactMatch dac:53030 ;
    skos:example "Donor-financed foreign exchange facility enabling a country to import manufacturing equipment." ;
    skos:hiddenLabel "import credit capital",
        "machinery import aid" ;
    skos:inScheme uei: ;
    skos:prefLabel "Import support (capital goods)" ;
    skos:related uei:ImportSupportCommoditiesIntervention,
        uei:MacroeconomicPolicyReform ;
    skos:scopeNote "Distinct from commodity import support; focused on productive investment goods rather than consumables." .

uei:ImportSupportCommoditiesIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Commodity aid",
        "Commodity import financing" ;
    skos:broader uei:TradePolicyAdministrationIntervention ;
    skos:definition "Financial assistance provided to enable developing countries to import essential commodities — including food, fuel, and raw materials — to stabilize supply and support balance of payments." ;
    skos:exactMatch dac:53040 ;
    skos:example "World Bank balance-of-payments support enabling a country to import food and fuel during a crisis." ;
    skos:hiddenLabel "import commodity support",
        "programme commodity aid" ;
    skos:inScheme uei: ;
    skos:prefLabel "Import support (commodities)" ;
    skos:related uei:FoodTransfer,
        uei:ImportSupportCapitalGoodsIntervention ;
    skos:scopeNote "Distinct from capital goods import support; covers consumable and raw material imports." .

uei:InVivoDosimetryIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:broader uei:NCDControlIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000072232>,
        <http://id.nlm.nih.gov/mesh/D011829> ;
    skos:definition "Real-time measurement of radiation doses received by a patient during radiotherapy treatment using detectors placed on or inside the patient's body, used to verify treatment accuracy and minimise radiation exposure errors." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072231>,
        <https://id.nlm.nih.gov/mesh/D000072231> ;
    skos:example "In vivo dosimetry using MOSFETs to verify delivered dose during breast radiotherapy." ;
    skos:hiddenLabel "in-vivo dosimetry",
        "patient dosimetry" ;
    skos:inScheme uei: ;
    skos:prefLabel "In vivo dosimetry" ;
    skos:related uei:RadiationDoseHypofractionationIntervention,
        uei:ReIrradiationIntervention ;
    skos:scopeNote "A quality assurance procedure in radiation oncology; relates to RadiationDoseHypofractionationIntervention and ReIrradiationIntervention as related radiotherapy concepts." .

uei:IndustrialExportCropIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "cash crop support",
        "export crop development" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs to improve the production of industrial or export-oriented crops — including cash crops, oilseeds, fibre crops, and plantation commodities — through improved varieties, practices, and value chain development." ;
    skos:exactMatch dac:31162 ;
    skos:example "A value chain program supports cocoa farmers in Ghana with improved planting material and market linkages to increase export earnings." ;
    skos:hiddenLabel "cash crops",
        "oilseeds production",
        "plantation crops" ;
    skos:inScheme uei: ;
    skos:prefLabel "Industrial and export crop production support" ;
    skos:related uei:AgriculturalExtension,
        uei:AgriculturalInputSupport ;
    skos:scopeNote "Focuses on crops grown primarily for commercial sale or export; distinct from food crop production programs." .

uei:IndustrialMineralsMiningIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "industrial mineral extraction",
        "non-metallic minerals" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments in the extraction, processing, and development of non-metallic industrial minerals such as limestone, silica, kaolin, and phosphate used in manufacturing and construction." ;
    skos:exactMatch dac:32266 ;
    skos:example "Investment in limestone quarrying and processing to support a domestic cement industry." ;
    skos:inScheme uei: ;
    skos:prefLabel "Industrial minerals mining and development" ;
    skos:related uei:CementLimePlasterIndustryIntervention,
        uei:MineralProspectionExplorationIntervention .

uei:LegislativeStrengtheningIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "legislative development",
        "parliamentary strengthening" ;
    skos:broader uei:InstitutionalReform ;
    skos:definition "Deliberate programs to build the capacity of legislatures, parliamentary staff, and political parties to perform their democratic representation, oversight, and law-making functions." ;
    skos:exactMatch dac:15152 ;
    skos:example "Training program for members of parliament on budget scrutiny and oversight of the executive." ;
    skos:hiddenLabel "parliament support",
        "political party development" ;
    skos:inScheme uei: ;
    skos:prefLabel "Legislative and political party strengthening" ;
    skos:related uei:DemocraticParticipationIntervention,
        uei:ElectoralSupportIntervention .

<https://universalevidence.com/vocab/interventions/MentoringIntervention>
    <http://purl.org/dc/terms/created> "2026-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
