    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000086742>,
        <http://id.nlm.nih.gov/mesh/D000087123>,
        <http://id.nlm.nih.gov/mesh/D000087124>,
        <http://id.nlm.nih.gov/mesh/D000090044>,
