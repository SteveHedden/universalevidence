uei:DebtForgivenessIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Sovereign debt cancellation",
        "Sovereign debt write-off" ;
    skos:broader uei:DebtActionIntervention ;
    skos:definition "The deliberate cancellation of outstanding bilateral or multilateral sovereign debt obligations owed by a developing country, permanently reducing its debt stock and debt-service burden." ;
    skos:exactMatch dac:60020 ;
    skos:example "Paris Club bilateral debt cancellation for HIPC-eligible countries following completion point." ;
    skos:hiddenLabel "sovereign debt jubilee",
        "sovereign debt relief cancellation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Sovereign debt forgiveness" ;
    skos:related uei:DebtBuyBackIntervention,
        uei:DebtForDevelopmentSwapIntervention,
        uei:DebtReschedulingIntervention,
        uei:ReliefOfMultilateralDebtIntervention .

<https://universalevidence.com/vocab/interventions/DebtReschedulingIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Debt refinancing" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Debt restructuring" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/DebtActionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate restructuring of a country's debt repayment schedule — through extension of maturities, grace periods, or refinancing — to provide short- or medium-term liquidity relief without cancelling the principal." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#60040> ;
    <http://www.w3.org/2004/02/skos/core#example> "Paris Club rescheduling of bilateral debt for a low-income country in balance-of-payments crisis." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "debt maturity extension" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "debt rollover" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Debt rescheduling and refinancing" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DebtBuyBackIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DebtForgivenessIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MonetaryInstitutionsDevelopmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/OtherDebtSwapIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinguished from debt forgiveness in that principal is not cancelled but repayment terms are modified." .

