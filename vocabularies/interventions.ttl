    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2002/07/owl#versionInfo> "0.4.0" .

uei:CashAndInKindTransfers a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Giving money, goods, food, or vouchers directly to a recipient, whether conditional or unconditional on behavior or eligibility." ;
    skos:inScheme uei: ;
    skos:prefLabel "Cash and in-kind transfers" ;
    skos:topConceptOf uei: .


uei:SubsidiesAndPriceInterventions a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Altering the price or cost of a good, input, or service that the recipient still chooses whether to buy or use, including input subsidies, price supports, and tax incentives." ;
    skos:inScheme uei: ;
    skos:prefLabel "Subsidies and price interventions" ;
    skos:topConceptOf uei: .


uei:TrainingAndCapacityBuilding a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Building skills, knowledge, or organizational capability in individuals, firms, or institutions, including technical assistance and vocational or managerial training." ;
    skos:inScheme uei: ;
    skos:prefLabel "Training and capacity building" ;
    skos:topConceptOf uei: ;
    skos:altLabel "Capacity building"@en,
        "Human capital development"@en,
        "Skills development"@en,
        "Training"@en ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D057191>,
        <https://id.nlm.nih.gov/mesh/D057191> ;
    skos:closeMatch <https://id.nlm.nih.gov/mesh/D016730>,
        <https://id.nlm.nih.gov/mesh/D055812> .


uei:InformationAndBehaviorChangeCommunication a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Providing information, awareness campaigns, nudges, counseling, or education intended to change knowledge, beliefs, or behavior." ;
    skos:inScheme uei: ;
    skos:prefLabel "Information and behavior-change communication" ;
    skos:topConceptOf uei: .


uei:InfrastructureAndPhysicalAssetProvision a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Constructing, rehabilitating, or equipping physical assets such as facilities, housing, or technology." ;
    skos:inScheme uei: ;
    skos:prefLabel "Infrastructure and physical-asset provision" ;
    skos:topConceptOf uei: .


uei:DirectServiceDelivery a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Ongoing direct provision of a service to recipients, such as health, extension, or legal services, distinct from building the facility or training the provider." ;
    skos:inScheme uei: ;
    skos:prefLabel "Direct service delivery" ;
    skos:topConceptOf uei: .


uei:PolicyRegulationAndEnforcement a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Laws, regulations, standards, and their enforcement, including aid, innovation, and sector policy." ;
    skos:inScheme uei: ;
    skos:prefLabel "Policy, regulation, and enforcement" ;
    skos:topConceptOf uei: .


uei:InstitutionalAndGovernanceReform a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Reforming or strengthening institutions and governance systems, including changes to organizational structure, capacity, accountability, performance, civil service, decentralization, and participatory mechanisms." ;
    skos:inScheme uei: ;
    skos:prefLabel "Institutional and governance reform" ;
    skos:topConceptOf uei: .


uei:AccessToFinance a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Financial products or instruments as the intervention itself, including microfinance, credit, savings, and insurance." ;
    skos:inScheme uei: ;
    skos:prefLabel "Access to finance" ;
    skos:topConceptOf uei: .


uei:MarketAndPrivateSectorDevelopment a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-07-14"^^xsd:date ;
    skos:definition "Business support, productive-sector investment, value-chain development, market linkages, entrepreneurship support, and public enabling activity intended to strengthen market systems, enterprises, or economic production." ;
    skos:inScheme uei: ;
    skos:prefLabel "Market and private-sector development" ;
    skos:topConceptOf uei: .

uei:DrugAdministrationRoutes a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Routes by which medicines are introduced into or applied to the body, including oral, mucosal, topical, inhaled, and parenteral administration." ;
    skos:inScheme uei: ;
    skos:prefLabel "Drug administration routes" .

uei:AntiInfectiveDrugTherapy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Drug therapies and prophylactic regimens used to prevent or treat bacterial, fungal, parasitic, or viral infections." ;
    skos:inScheme uei: ;
    skos:prefLabel "Anti-infective drug therapy" .

uei:InfusionTherapyAndSystems a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Therapies, services, and delivery systems that administer fluids or medicines through controlled infusion." ;
    skos:inScheme uei: ;
    skos:prefLabel "Infusion therapy and systems" .

uei:MedicationRegimenAndUseManagement a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Design or management of medication schedules, combinations, preparations, substitutions, and patterns of medicine use." ;
    skos:inScheme uei: ;
    skos:prefLabel "Medication regimen and use management" .

uei:SchoolGovernanceAndAdministration a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:EducationPolicyAdministration ;
    skos:definition "Policies and administrative practices governing school organization, admissions, assessment, accountability, management, staffing, and institutional provision." ;
    skos:inScheme uei: ;
    skos:prefLabel "School governance and administration" .

uei:TeachingAndLearningApproaches a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:EducationPolicyAdministration ;
    skos:definition "Instructional designs, pedagogical approaches, learning formats, feedback methods, and curriculum resources used to support teaching and learning." ;
    skos:inScheme uei: ;
    skos:prefLabel "Teaching and learning approaches" .

uei:LearnerSupportPrograms a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:EducationPolicyAdministration ;
    skos:definition "Academic, financial, mentoring, counseling, tutoring, and extended-learning supports provided to help learners participate and succeed." ;
    skos:inScheme uei: ;
    skos:prefLabel "Learner support programs" .

uei:RespiratoryPhysiologicAssessment a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:definition "Monitoring and functional assessment of ventilation, respiratory flow, lung volume, gas transfer, and breathing rate." ;
    skos:inScheme uei: ; skos:prefLabel "Respiratory physiologic assessment" .

uei:CardiovascularPhysiologicMonitoring a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:definition "Monitoring and functional assessment of blood pressure, cardiac rhythm and sounds, circulation, and cardiovascular responses." ;
    skos:inScheme uei: ; skos:prefLabel "Cardiovascular physiologic monitoring" .

uei:NeuromuscularAndNeurophysiologicAssessment a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:definition "Assessment of neural, muscular, movement, balance, sensory-motor, and psychomotor function using examination or physiologic measurement." ;
    skos:inScheme uei: ; skos:prefLabel "Neuromuscular and neurophysiologic assessment" .

uei:GeneralPhysiologicMonitoring a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-08"^^xsd:date ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:definition "General, ambulatory, bedside, or self-monitoring of physiologic signs and responses not limited to one organ system." ;
    skos:inScheme uei: ; skos:prefLabel "General physiologic monitoring" .

uei:AntiObesityPharmacotherapy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:altLabel "Anti-obesity medication",
        "Weight-loss medication" ;
    skos:broader uei:ObesityManagementIntervention ;
    skos:definition "Pharmacologic interventions administered with the primary intent of reducing excess body weight or treating obesity, including approved or investigational medications used alone or in a medication regimen." ;
    skos:inScheme uei: ;
    skos:prefLabel "Anti-obesity pharmacotherapy" ;
    skos:scopeNote "Includes medications used specifically for weight reduction or obesity treatment; excludes drugs studied in overweight or obese participants when the source record establishes a different primary treatment or research objective." .

uei:ProbioticPrebioticAndSynbioticSupplementation a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:broader uei:NutritionalSupport ;
    skos:definition "Provision or prescription of probiotic microorganisms, prebiotic substrates, or combined synbiotic products to modify a host-associated microbiome or produce related health effects." ;
    skos:inScheme uei: ;
    skos:prefLabel "Probiotic, prebiotic, and synbiotic supplementation" .

uei:ChildGrowthMonitoringAndPromotion a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:broader uei:CommunityHealthServicesIntervention ;
    skos:definition "Regular assessment of a child's growth or nutritional status, combined with counseling, referral, or other follow-up actions intended to support healthy growth or address growth faltering." ;
    skos:inScheme uei: ;
    skos:prefLabel "Child growth monitoring and promotion" .

uei:HomeAndKitchenGardeningSupport a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:broader uei:FoodCropProductionIntervention ;
    skos:definition "Support for households to establish or use small home, backyard, or kitchen gardens to produce vegetables, fruits, or other foods for household consumption and dietary improvement." ;
    skos:inScheme uei: ;
    skos:prefLabel "Home and kitchen gardening support" .

uei:IntermittentFastingAndTimeRestrictedEating a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:broader uei:NutritionTherapy ;
    skos:definition "Dietary intervention that alternates periods of eating with periods of fasting or restricts food intake to specified daily time windows, with or without an intended reduction in total energy intake." ;
    skos:inScheme uei: ;
    skos:prefLabel "Intermittent fasting and time-restricted eating" .

uei:BioelectricalImpedanceAnalysis a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-09-02"^^xsd:date ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:definition "Assessment of body composition, body fluid status, or related tissue compartments by measuring the body's opposition to a small applied electrical current, including single- and multi-frequency bioimpedance methods." ;
    skos:inScheme uei: ;
    skos:prefLabel "Bioelectrical impedance analysis" .

uei:PlaceboAdministrationIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Placebo administration"@en ;
    skos:definition "Administration of a preparation formulated without the active ingredient or component being tested, used as a comparator or placebo intervention in a clinical study."@en ;
    skos:scopeNote "Use for an explicitly administered placebo preparation. This does not imply absence of administration, nutritional supplementation, or efficacy. Excludes no-intervention arms, unspecified usual care, and sham procedures that do not administer a placebo preparation."@en ;
    skos:broader uei:ClinicalSupportProceduresIntervention ;
    skos:inScheme uei: ;
    <http://purl.org/dc/terms/source> <https://clinicaltrials.gov/study/NCT01344135>, <https://doi.org/10.1002/jcsm.12219> .

uei:DietarySupplementAdministrationIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Dietary supplement administration"@en ;
    skos:definition "Administration of a product explicitly supplied as a dietary supplement for a health or physiological effect, including preparations containing nutrients, botanical ingredients, or other bioactive substances."@en ;
    skos:scopeNote "Use when the source establishes dietary supplement administration but does not support a more specific ingredient or nutritional modality. This category does not imply micronutrient deficiency correction, probiotic content, efficacy, or safety. Prefer a specific nutritional, probiotic, homeopathic, or placebo concept when established. Excludes questionnaires about supplements and no-supplementation arms."@en ;
    skos:broader uei:HealthServices ;
    skos:inScheme uei: ;
    <http://purl.org/dc/terms/source> <https://clinicaltrials.gov/study/NCT07148271>, <https://clinicaltrials.gov/study/NCT06371651> .

uei:ClinicalFastingIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:HealthServices ;
    skos:definition "Prescribed temporary withholding of food or enteral feeds as part of clinical care or preparation for a clinical procedure or physiological challenge." ;
    skos:inScheme uei: ;
    skos:prefLabel "Clinical fasting" ;
    skos:scopeNote "Includes withholding enteral feeds during treatment and fasting before a clinical challenge. Distinct from intermittent-fasting or time-restricted-eating dietary regimens; does not imply that all fluids or parenteral nutrition are withheld." .

uei:DietaryChallengeIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Dietary challenge"@en ;
    skos:definition "Protocol-directed consumption of specified foods, meals, or diets to evaluate physiological responses in a clinical feeding or metabolic study."@en ;
    skos:scopeNote "Includes controlled single-meal and repeated dietary exposures used for physiological assessment. Prefer nutrition therapy, food support, or nutrition education when the delivered intervention is treatment, assistance, or counselling. Does not imply a therapeutic nutritional benefit."@en ;
    skos:broader uei:ScreeningTestingAndClinicalEvaluation ;
    skos:inScheme uei: ;
    <http://purl.org/dc/terms/source> <https://clinicaltrials.gov/study/NCT01434407>, <https://clinicaltrials.gov/study/NCT01773304>, <https://clinicaltrials.gov/study/NCT01317251> .

uei:PhysicalExertionChallengeIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Physical exertion challenge"@en ;
    skos:definition "Performance of a specified bout or period of physical exertion to evaluate physiological, metabolic, or functional responses in a research or clinical assessment."@en ;
    skos:scopeNote "Includes sustained field exertion used to study energy balance and physiological adaptation. Use exercise therapy for activity prescribed to improve fitness or health, and cardiopulmonary exercise testing for graded diagnostic testing. Does not by itself assert therapeutic benefit."@en ;
    skos:broader uei:PhysiologicMonitoringAssessmentIntervention ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT05773469> .

uei:StatinTherapyIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Administration of a statin medication as a clinical treatment or preventive intervention." ;
    skos:inScheme uei: ;
    skos:prefLabel "Statin therapy" ;
    skos:scopeNote "Includes administration of pravastatin and other statin medicines, including trials evaluating their metabolic effects. Excludes statin-prescribing education without administration and placebo tablets that imitate a statin." .

uei:MenopausalHormoneReplacementTherapy a skos:Concept, ue:Intervention ;
    skos:prefLabel "Menopausal hormone replacement therapy"@en ;
    skos:definition "Administration of estrogen, alone or with a progestogen, as hormone replacement in postmenopausal people."@en ;
    skos:broader uei:SpecializedClinicalTherapiesIntervention ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT00000555> .

uei:WholeBodyVibrationTraining a skos:Concept, ue:Intervention ;
    skos:prefLabel "Whole-body vibration training"@en ;
    skos:definition "Prescribed training using a vibrating platform to transmit mechanical oscillations through the body to improve muscular or functional performance."@en ;
    skos:broader uei:ExerciseTherapyIntervention ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT04855981> .

uei:NonCaloricSweetenerAdministrationIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Non-caloric sweetener administration"@en ;
    skos:definition "Prescribed oral administration of non-caloric sweeteners to deliberately modify dietary exposure or assess resulting physiological responses."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT03708939> .

uei:PrescribedMealScheduleIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Prescribed meal schedule"@en ;
    skos:definition "Implementation of a specified daily meal frequency or timing schedule as a dietary intervention."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT06630637> .

uei:ProteinRestrictedDietIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:NutritionTherapy ;
    skos:definition "A dietary regimen that deliberately limits protein intake for clinical management or evaluation of a health condition." ;
    skos:inScheme uei: ;
    skos:prefLabel "Protein-restricted diet" ;
    skos:scopeNote "Includes prescribed reduced-protein diets and explicitly low-protein regimens used as active clinical comparators. Excludes high-protein diets, protein-sparing modified fasts, and isolated test meals used only to measure an acute physiological response." .

uei:AnabolicSteroidTherapyIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:MedicationInfusionServicesIntervention ;
    skos:definition "Administration of an anabolic steroid medicine as a clinical intervention to promote tissue anabolism, muscle recovery, or related therapeutic effects." ;
    skos:inScheme uei: ;
    skos:prefLabel "Anabolic steroid therapy" ;
    skos:scopeNote "Includes clinical administration of nandrolone decanoate. Excludes glucocorticoid anti-inflammatory treatment, growth hormone, nutritional protein supplements, and placebo injections that imitate anabolic steroid treatment." .

uei:DietarySodiumModificationIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Dietary sodium modification"@en ;
    skos:definition "Deliberate prescription or provision of diets with a specified altered sodium intake, including sodium restriction or controlled higher-versus-lower sodium exposure, to manage health or assess physiological responses."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT04286555> .

uei:PortfolioDietIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Portfolio cholesterol-lowering diet"@en ;
