    skos:hiddenLabel "AID",
        "artificial insemination by donor",
        "donor-conceived" ;
    skos:inScheme uei: ;
    skos:prefLabel "Donor conception" ;
    skos:related uei:FamilyPlanningServices,
        uei:MitochondrialReplacementTherapyIntervention .

