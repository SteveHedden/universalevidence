uei:InformalFinancialIntermediaryIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "MFI support",
        "ROSCA support",
        "SACCO support",
        "village savings group support" ;
    skos:broader uei:MarketAndPrivateSectorDevelopment ;
    skos:definition "Programs that establish, strengthen, finance, or improve informal and semi-formal financial intermediaries — including savings and credit cooperatives, savings groups, rotating savings associations, and microfinance institutions — to expand financial access for low-income populations." ;
    skos:exactMatch dac:24040 ;
    skos:example "An NGO strengthens village savings and loan associations in rural Tanzania to improve financial inclusion among women." ;
    skos:hiddenLabel "informal finance",
        "savings cooperatives",
        "semi-formal finance" ;
    skos:inScheme uei: ;
    skos:prefLabel "Informal and semi-formal financial intermediary support" ;
    skos:related uei:CottageIndustriesHandicraftIntervention,
        uei:FormalFinancialIntermediaryIntervention,
        uei:MicrofinanceCreditServices ;
    skos:scopeNote "Focuses on non-bank and partially regulated institutions; contrast with formal sector financial intermediaries." .

<https://universalevidence.com/vocab/interventions/LabourRightsIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Labor rights program" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Worker rights intervention" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#16070> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs, policy reforms, and capacity-building activities to promote and protect workers' fundamental rights, including freedom of association, collective bargaining, and elimination of forced and child labour." ;
    <http://www.w3.org/2004/02/skos/core#example> "Technical assistance to a ministry of labour to strengthen labour inspection and enforce freedom of association laws." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "ILO core standards program" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "labour standards intervention" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Labour rights intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ResponsibleBusinessConductIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/SocialDialogueIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Broader than child labour or forced labour interventions by addressing the full spectrum of ILO core labour standards." .

