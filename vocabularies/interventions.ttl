uei:ForestryResearch a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Forest research",
        "Forest science research" ;
    skos:broader uei:TrainingAndCapacityBuilding ;
    skos:definition "Organized research activities aimed at improving knowledge of forest ecosystems, timber and non-timber forest products, sustainable management practices, and forest policy." ;
    skos:exactMatch dac:31282 ;
    skos:example "A multi-country research consortium studying the impact of selective logging practices on forest regeneration and biodiversity." ;
