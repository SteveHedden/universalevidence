        <http://id.nlm.nih.gov/mesh/D006275>,
        <https://id.nlm.nih.gov/mesh/D005160> ;
    skos:definition "Application of research evidence to the planning, design, and construction of healthcare or public facilities to improve patient outcomes, safety, and operational efficiency." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067013>,
        <https://id.nlm.nih.gov/mesh/D000067013> ;
    skos:example "Redesign of hospital ward layouts based on infection control evidence to reduce healthcare-associated infections." ;
    skos:hiddenLabel "EBD healthcare",
        "evidence based design" ;
    skos:inScheme uei: ;
    skos:prefLabel "Evidence-based facility design" ;
    skos:related uei:HealthPolicyAdministration ;
    skos:scopeNote "Pertains to the design process of health or care facilities informed by evidence; broader than simple construction." .

