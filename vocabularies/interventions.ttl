    skos:broader uei:EconomicDevelopment ;
    skos:definition "Investment in the construction, rehabilitation, or expansion of cement, lime, and plaster manufacturing facilities to support domestic construction materials supply." ;
    skos:exactMatch dac:32166 ;
    skos:example "A development finance investment in a new cement plant to reduce construction costs and support infrastructure programs in a landlocked country." ;
    skos:hiddenLabel "cement factory",
        "cement plant",
        "lime plant" ;
