uei:PerioperativeCare a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader uei:PatientCareIntervention ;
    skos:definition "Coordinated care provided before, during, and after surgery to prepare patients, manage intraoperative needs, and support recovery." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D019990>,
        <https://id.nlm.nih.gov/mesh/D019990> ;
    skos:inScheme uei: ;
    skos:prefLabel "Perioperative care" .

uei:PersonnelManagementIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader uei:EmploymentPolicyIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D032024> ;
    skos:definition "Administrative or organizational practices for recruiting, selecting, supervising, scheduling, evaluating, retaining, or restructuring personnel across employment settings." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D010559> ;
    skos:inScheme uei: ;
    skos:prefLabel "Personnel management intervention" .

uei:PharmacogenomicTestingIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "PGx testing",
        "pharmacogenetics testing" ;
    skos:broader uei:MolecularGeneticAndNucleicAcidTesting ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D000088744>,
        <https://id.nlm.nih.gov/mesh/D000088744> ;
    skos:definition "Genetic testing to identify variations in genes that affect an individual's response to drugs, used to guide medication selection and dosing to improve efficacy and reduce adverse effects." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071185>,
        <https://id.nlm.nih.gov/mesh/D000071185> ;
    skos:example "CYP2C19 genotyping to guide clopidogrel prescribing in post-MI patients." ;
    skos:hiddenLabel "genetic drug testing",
        "pharmacogenomics" ;
    skos:inScheme uei: ;
    skos:prefLabel "Pharmacogenomic testing" ;
    skos:related uei:NCDControlIntervention,
        uei:PotentiallyInappropriateMedicationIntervention ;
    skos:scopeNote "Distinct from broader genetic screening; focuses specifically on genotype-informed drug prescribing." .

uei:PopulationPolicyAdministration a skos:Concept,
        ue:Intervention ;
    skos:altLabel "demographic policy" ;
    skos:broader uei:SectorPolicyAndAdministrativeManagement ;
    skos:definition "Government policies, strategies, and administrative actions to manage population dynamics, including demographic planning, civil registration, and coordination of reproductive health services." ;
    skos:exactMatch dac:13010 ;
    skos:example "A government establishing a national population policy framework with demographic targets and institutional coordination mechanisms." ;
    skos:inScheme uei: ;
    skos:prefLabel "Population policy and administration" ;
    skos:related uei:FamilyPlanningServices ;
    skos:scopeNote "Broader than FamilyPlanningServices; covers governmental population-policy and administrative frameworks rather than direct reproductive-health service delivery. Participant demographics, demographic data collection or covariate profiling, study-population description or coverage, use of civil-registration datasets, population surveillance, and clinical population health management do not imply this intervention." .

uei:PreciousMetalsMaterialsMiningIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "gold and silver mining",
        "precious metals mining" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments in the extraction, processing, and development of precious metals and materials such as gold, silver, platinum, and gemstones." ;
    skos:exactMatch dac:32265 ;
    skos:example "Investment in artisanal and small-scale gold mining formalization and safety in West Africa." ;
    skos:inScheme uei: ;
    skos:prefLabel "Precious metals and materials mining and development" ;
    skos:related uei:MineralProspectionExplorationIntervention,
        uei:MiningMineralsPolicyAdministration .

uei:PrivatisationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "privatization",
        "state enterprise divestiture" ;
    skos:broader uei:InstitutionalAndGovernanceReform ;
    skos:definition "The deliberate transfer of state-owned enterprises or assets to private ownership, including technical assistance for privatisation processes, regulatory reform, and management of state asset divestiture." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D011332>,
        <https://id.nlm.nih.gov/mesh/D011332>,
        dac:25020 ;
    skos:example "Technical assistance to a government to design and implement the privatisation of a state telecommunications company." ;
    skos:hiddenLabel "SOE reform",
        "state-owned enterprise privatisation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Privatisation" ;
    skos:related uei:BusinessPolicyAdministrationIntervention,
        uei:PublicFinanceManagementReform .

uei:ProfessionalDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader uei:TrainingAndCapacityBuilding ;
    skos:definition "Training, coaching, mentoring, or continuing education intended to improve professional knowledge, skills, or practice." ;
    skos:inScheme uei: ;
    skos:prefLabel "Professional development intervention" .

uei:PsychiatricRehabilitationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "mental health rehabilitation",
        "psychosocial rehabilitation" ;
    skos:broader uei:MentalHealthServicesIntervention ;
    skos:definition "Structured programs to restore functioning, promote recovery, and support community integration for people living with serious mental health conditions such as schizophrenia or bipolar disorder." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067250>,
        <https://id.nlm.nih.gov/mesh/D000067250> ;
    skos:example "Supported employment and skills training programs for adults with schizophrenia." ;
    skos:hiddenLabel "community psychiatric rehabilitation",
        "psychiatric rehab" ;
    skos:inScheme uei: ;
    skos:prefLabel "Psychiatric rehabilitation" ;
    skos:related uei:CaseManagementIntervention,
        uei:TelerehabilitationIntervention .

<https://universalevidence.com/vocab/interventions/PublicProcurementReform>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "government procurement reform" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "public contracting reform" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/indicator/12_7_1> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate reforms, capacity-building, and regulatory changes to improve the transparency, efficiency, and integrity of government purchasing of goods, works, and services." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15125> ;
    <http://www.w3.org/2004/02/skos/core#example> "Introduction of an e-procurement portal to increase competition and reduce collusion in government contracts." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "e-procurement" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "procurement transparency" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Public procurement reform" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AntiCorruptionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PublicFinanceManagementReform> .

uei:RNAiTherapeuticsIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "RNAi therapy",
        "gene silencing therapy",
        "siRNA therapy" ;
    skos:broader uei:MolecularTargetedTherapy ;
    skos:definition "Clinical use of RNA interference mechanisms — including siRNA and shRNA — to silence specific disease-causing genes as a treatment for infectious or non-communicable diseases." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067492> ;
    skos:example "Use of siRNA-based drugs to reduce LDL cholesterol in patients with hypercholesterolaemia." ;
    skos:hiddenLabel "RNA interference treatment",
        "small interfering RNA therapeutics" ;
    skos:inScheme uei: ;
    skos:prefLabel "RNA interference therapeutics" ;
    skos:related uei:GeneEditingIntervention,
        uei:TheranosticNanomedicineIntervention .

uei:RadiationDoseHypofractionationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "SBRT",
        "hypofractionated radiotherapy",
        "hypofractionation",
        "stereotactic body radiotherapy" ;
    skos:broader uei:RadiationDoseFractionation ;
    skos:definition "A radiotherapy treatment strategy that delivers higher doses of radiation per session over fewer sessions compared to conventional fractionation, used to treat cancers such as breast cancer and prostate cancer." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069473>,
        <https://id.nlm.nih.gov/mesh/D000069473> ;
    skos:example "Hypofractionated whole-breast irradiation over three weeks compared to conventional five-week schedule in early breast cancer." ;
    skos:hiddenLabel "accelerated radiotherapy",
        "short-course radiotherapy" ;
    skos:inScheme uei: ;
    skos:prefLabel "Radiation dose hypofractionation" ;
    skos:related uei:InVivoDosimetryIntervention,
        uei:ReIrradiationIntervention .

uei:ReIrradiationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "reirradiation",
        "repeat radiotherapy",
        "second course radiotherapy" ;
    skos:broader uei:NCDControlIntervention ;
    skos:definition "A radiotherapy intervention in which a patient who has previously received radiation treatment to a site receives a second course of radiation to the same anatomical region, typically for recurrent or new tumors." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069475>,
        <https://id.nlm.nih.gov/mesh/D000069475> ;
    skos:example "Re-irradiation of locally recurrent head and neck squamous cell carcinoma after prior definitive radiation therapy." ;
    skos:hiddenLabel "re-radiation",
        "salvage radiotherapy" ;
    skos:inScheme uei: ;
    skos:prefLabel "Re-irradiation" ;
    skos:related uei:InVivoDosimetryIntervention,
        uei:RadiationDoseHypofractionationIntervention .

uei:RuralDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Integrated rural development",
        "Rural livelihoods program" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Integrated programs and investments to improve livelihoods, infrastructure, services, and economic opportunities in rural areas, encompassing agriculture, local governance, and community development." ;
    skos:exactMatch dac:43040 ;
    skos:example "Integrated rural development projects combining road construction, agricultural extension, and community health services in Bangladesh." ;
    skos:hiddenLabel "rural area development",
        "village development" ;
    skos:inScheme uei: ;
    skos:prefLabel "Rural development intervention" ;
    skos:related uei:PostEmergencyReconstructionIntervention,
        uei:UrbanDevelopmentIntervention ;
    skos:scopeNote "Broader than AgriculturalIntervention — encompasses non-farm rural economy, infrastructure, and services; distinguished from UrbanDevelopmentIntervention by geographic focus." .

uei:SanitationDeliveryIntervention a skos:Concept,
        ue:Intervention ;
    skos:broader uei:WaterAndSanitationIntervention ;
    skos:definition "Interventions that improve sanitation infrastructure and services for communities."@en ;
    skos:inScheme uei: ;
    skos:prefLabel "Sanitation delivery intervention"@en .

uei:SeedBankIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "gene bank",
        "plant genetic resource conservation",
        "seed gene bank" ;
    skos:broader uei:BiodiversityConservationIntervention ;
    skos:definition "Programs to establish, maintain, and operate ex-situ repositories that conserve genetic diversity of plant species through long-term seed storage." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068098>,
        <https://id.nlm.nih.gov/mesh/D000068098> ;
    skos:example "Establishment of a national seed bank storing 10,000 accessions of indigenous crop varieties to safeguard agrobiodiversity." ;
    skos:hiddenLabel "seed repository",
        "seed vault" ;
    skos:inScheme uei: ;
    skos:prefLabel "Seed bank establishment and management" ;
    skos:related uei:AgriculturalResearchIntervention,
        uei:BiosphereProtectionIntervention ;
    skos:scopeNote "Primarily a biodiversity conservation intervention; may also support agricultural resilience through preserving crop genetic diversity." .

<https://universalevidence.com/vocab/interventions/SitePreservationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Archaeological site protection" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Heritage site conservation" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/EnvironmentalPolicyAdministrationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://unstats.un.org/sdgs/indicator/11_4_1> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#41040> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate programs to protect, conserve, and restore culturally, historically, or ecologically significant sites, including archaeological sites, natural landmarks, and world heritage locations." ;
    <http://www.w3.org/2004/02/skos/core#example> "UNESCO-funded restoration of historic urban districts damaged by conflict." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "monument preservation" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "world heritage conservation" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Site preservation intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/BiosphereProtectionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/CultureAndDiversityIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers both natural and cultural site preservation; for broader cultural diversity programs see CultureAndDiversityIntervention." .

uei:SocialDialogueIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Labour-management dialogue",
        "Tripartite dialogue" ;
    skos:broader uei:InstitutionalAndGovernanceReform ;
    skos:definition "Programs that facilitate negotiation, consultation, and information sharing between governments, employers, and workers to improve labour relations and social cohesion." ;
    skos:exactMatch dac:16080 ;
    skos:example "ILO-supported tripartite forum bringing together government, employers, and trade unions to negotiate minimum wage standards." ;
    skos:hiddenLabel "social dialogue program",
        "tripartite negotiation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Social dialogue intervention" ;
    skos:related uei:DemocraticParticipationIntervention,
        uei:LabourRightsIntervention ;
    skos:scopeNote "Focuses on institutionalized processes between social partners; distinguished from general civil society support by the specific labour relations and tripartite context." .

uei:SocialMediaHealthCampaign a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "social media intervention" ;
    skos:broader uei:DigitalMessagingIntervention ;
    skos:closeMatch <https://id.nlm.nih.gov/mesh/D011641> ;
    skos:definition "Use of social media platforms or online social networks to disseminate health information, mobilize communities, or encourage preventive health behavior." ;
    skos:example "Social media campaign promoting PrEP awareness and uptake." ;
    skos:inScheme uei: ;
    skos:prefLabel "Social media health campaign" ;
    skos:related uei:CommunityMobilizationIntervention,
        uei:HealthEducationBehaviourChange .

uei:SolarEnergyGridIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Grid-scale solar",
        "Utility-scale solar PV" ;
    skos:broader uei:RenewableEnergyGenerationIntervention ;
    skos:definition "Deployment of utility-scale solar photovoltaic or concentrating solar power installations that feed electricity into centralised national or regional power grids." ;
    skos:exactMatch dac:23230 ;
    skos:example "Investment in a 50 MW solar PV farm connected to the national grid in sub-Saharan Africa." ;
    skos:hiddenLabel "solar grid",
        "solar power plant" ;
    skos:inScheme uei: ;
    skos:prefLabel "Solar energy for centralised grids" ;
    skos:related uei:EnergyPolicyAdministration ;
    skos:scopeNote "Covers grid-connected solar generation only; off-grid and standalone solar systems are classified separately." .

<https://universalevidence.com/vocab/interventions/SolarEnergyOffGridIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Off-grid solar" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Solar home systems" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Solar mini-grid" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/RenewableEnergyGenerationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deployment of solar photovoltaic systems for off-grid mini-grids or standalone household and community installations to provide electricity access in areas not connected to centralised grids." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#23231> ;
    <http://www.w3.org/2004/02/skos/core#example> "Distribution of solar home systems to rural households without grid electricity access in Bangladesh." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "isolated grid solar" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "solar lantern program" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "standalone solar" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Solar energy for isolated grids and standalone systems" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ICTInfrastructureIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MiniGridDistributionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers off-grid and isolated-grid solar only; utility-scale grid-connected solar is classified separately." .

uei:StandingOrdersIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "pre-authorized protocols",
        "protocol-based orders" ;
    skos:broader uei:HealthPolicyAdministration ;
    skos:definition "Pre-authorized clinical protocols that allow health personnel to initiate specific treatments, vaccinations, or tests without requiring an individual physician order for each patient, used to improve care timeliness and consistency." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071065>,
        <https://id.nlm.nih.gov/mesh/D000071065> ;
    skos:example "Implementation of standing orders for influenza vaccination in long-term care facilities to increase coverage rates." ;
    skos:hiddenLabel "nurse standing orders",
        "standing medical orders" ;
    skos:inScheme uei: ;
    skos:prefLabel "Standing orders" ;
    skos:related uei:CommunityHealthWorker,
        uei:ImmunizationProgram ;
    skos:scopeNote "Refers to the administrative and protocol intervention of adopting standing orders, not the clinical procedure itself." .

uei:StrokeRehabilitationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "stroke recovery program" ;
    skos:broader uei:NeurologicalRehabilitationIntervention ;
    skos:definition "Structured multidisciplinary programs to restore function and quality of life after stroke, including physical therapy, occupational therapy, speech-language therapy, and psychological support." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071939>,
        <https://id.nlm.nih.gov/mesh/D000071939> ;
    skos:example "Inpatient multidisciplinary stroke rehabilitation unit reducing disability at 90 days post-stroke." ;
    skos:hiddenLabel "cerebrovascular rehabilitation",
        "post-stroke rehabilitation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Stroke rehabilitation" ;
    skos:related uei:ExoskeletonDeviceIntervention,
        uei:TelerehabilitationIntervention .

uei:StudentRunClinicIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Student free clinics",
        "Student-led health clinics" ;
    skos:broader uei:CommunityAmbulatoryCareIntervention ;
    skos:definition "Health care delivery programs in which medical or health professional students provide supervised primary care services to underserved populations, simultaneously gaining clinical training experience." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070319>,
        <https://id.nlm.nih.gov/mesh/D000070319> ;
    skos:example "Study assessing whether student-run free clinics improve access to preventive care for uninsured urban populations compared to usual community health center care." ;
    skos:hiddenLabel "student operated clinic",
        "student run clinic" ;
    skos:inScheme uei: ;
    skos:prefLabel "Student-run clinics" ;
    skos:related uei:HealthWorkerTraining,
        uei:HigherEducationIntervention .

uei:TheranosticNanomedicineIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "nanomedicine diagnostics and therapy",
        "nanotheranostics" ;
    skos:broader uei:SpecializedClinicalTherapiesIntervention ;
    skos:definition "The application of engineered nanoparticles and nanotechnology-based platforms that simultaneously enable disease diagnosis and targeted therapeutic delivery in a single integrated system." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068936>,
        <https://id.nlm.nih.gov/mesh/D000068936> ;
    skos:example "Phase II trial of nanoparticle-encapsulated chemotherapy enabling real-time tumour imaging and drug delivery in cancer patients." ;
    skos:hiddenLabel "theranostic nanoparticles",
        "theranostics" ;
    skos:inScheme uei: ;
    skos:prefLabel "Theranostic nanomedicine" ;
    skos:related uei:RNAiTherapeuticsIntervention,
        uei:TechnologicalResearchDevelopmentIntervention ;
    skos:scopeNote "An emerging biomedical technology used primarily in oncology and other NCD contexts; too specialized for general application in LMIC development settings but classifiable under NCDControlIntervention where evidence exists." .

uei:TourismPolicyAdministrationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "tourism development policy",
        "tourism sector governance" ;
    skos:broader uei:SectorPolicyAndAdministrativeManagement ;
    skos:definition "Deliberate reforms, regulatory actions, and capacity-building to improve the governance, development, and administration of the tourism sector." ;
    skos:exactMatch dac:33210 ;
    skos:example "Technical assistance to develop a national tourism strategy and strengthen the tourism regulatory framework." ;
    skos:inScheme uei: ;
    skos:prefLabel "Tourism policy and administration" ;
    skos:related uei:BusinessPolicyAdministrationIntervention  .

uei:TradeRelatedAdjustmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "trade adjustment assistance",
        "trade liberalization adjustment" ;
    skos:broader uei:TradePolicyAdministrationIntervention ;
    skos:definition "Deliberate programs and financial support to help countries and communities adjust to trade liberalization by addressing costs to affected industries, workers, and public revenues." ;
    skos:exactMatch dac:33150 ;
    skos:example "Safety net programs for workers displaced by import competition following trade liberalization." ;
    skos:inScheme uei: ;
    skos:prefLabel "Trade-related adjustment" ;
    skos:related uei:EmploymentCreationIntervention,
        uei:MacroeconomicPolicyReform .

uei:TransanalEndoscopicMicrosurgeryIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "TEM" ;
    skos:broader uei:DigestiveSystemSurgeryIntervention ;
    skos:definition "A specialized minimally invasive technique using a rigid operating rectoscope with magnified vision to perform precise excision of rectal polyps or tumors through the anus." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067369>,
        <https://id.nlm.nih.gov/mesh/D000067369> ;
    skos:example "TEM used for full-thickness local excision of T1 rectal carcinoma." ;
    skos:hiddenLabel "endoscopic microsurgery rectum",
        "transanal microsurgery" ;
    skos:inScheme uei: ;
    skos:prefLabel "Transanal endoscopic microsurgery" ;
    skos:related uei:EndoscopicMucosalResectionIntervention,
        uei:TransanalEndoscopicSurgeryIntervention ;
    skos:scopeNote "Closely related to transanal endoscopic surgery (TES/TAMIS) but refers specifically to the TEM platform." .

uei:TransanalEndoscopicSurgeryIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "TES",
        "transanal surgery" ;
    skos:broader uei:DigestiveSystemSurgeryIntervention ;
    skos:definition "A minimally invasive surgical technique in which endoscopic instruments are introduced through the anus to remove rectal lesions or perform colorectal procedures." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000067368>,
        <https://id.nlm.nih.gov/mesh/D000067368> ;
    skos:example "Use of transanal endoscopic surgery for local excision of early rectal cancer." ;
    skos:hiddenLabel "TAMIS",
        "transanal minimally invasive surgery" ;
    skos:inScheme uei: ;
    skos:prefLabel "Transanal endoscopic surgery" ;
    skos:related uei:EndoscopicMucosalResectionIntervention,
        uei:TransanalEndoscopicMicrosurgeryIntervention .

uei:TransportFareSubsidy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "fare subsidy",
        "reduced fares",
        "transit subsidy",
        "transport fare subsidy",
        "travel subsidy" ;
    skos:broader uei:SubsidyIntervention ;
    skos:definition "Cash, vouchers, passes, credits, reimbursements, or price reductions intended to lower users' transport or travel costs and improve access to passenger transport." ;
    skos:inScheme uei: ;
    skos:prefLabel "Transport cost subsidy" ;
    skos:related uei:TransportPolicyAdministration ;
    skos:scopeNote "Excludes subsidies paid to transport operators that do not lower users' travel costs." .

uei:VeterinaryServicesIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Animal health services",
        "Veterinary services" ;
    skos:broader uei:LivestockIntervention ;
    skos:closeMatch <https://id.nlm.nih.gov/mesh/D037901> ;
    skos:definition "Provision of veterinary care, animal health services, and technical support to livestock keepers to improve animal health, productivity, and welfare." ;
    skos:exactMatch dac:31195 ;
    skos:example "A program deploying community animal health workers to provide vaccinations and treatment to smallholder cattle farmers." ;
    skos:hiddenLabel "livestock veterinary",
        "vet services" ;
    skos:inScheme uei: ;
    skos:prefLabel "Veterinary and livestock services" ;
    skos:related uei:AgriculturalExtension,
        uei:AgriculturalServicesIntervention .

uei:WageSettingPolicy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:EquityLaborAndMigrationPolicy ;
    skos:definition "Wage-setting policies as a deliberate intervention, program, policy, or service." ;
    skos:inScheme uei: ;
    skos:prefLabel "Wage-setting policies" .

<https://universalevidence.com/vocab/interventions/WomensRightsOrganisationSupport>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "gender equality institution support" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "women's movement support" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15170> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs that fund, strengthen, and build the capacity of women's rights organizations, feminist movements, and government gender equality institutions to advance women's rights and gender equity." ;
    <http://www.w3.org/2004/02/skos/core#example> "Providing core funding to national women's rights coalitions to advocate for gender-responsive budgeting." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "feminist organizations" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "women's organizations" ;
