uei:DirectlyObservedTherapyIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "DOT",
        "directly observed treatment" ;
    skos:broader uei:TreatmentAdherenceIntervention ;
    skos:definition "Treatment support in which a health worker, community worker, or trained supporter directly observes medication taking to improve adherence and completion." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D023801>,
        <https://id.nlm.nih.gov/mesh/D023801> ;
    skos:example "Community-based directly observed therapy for tuberculosis treatment." ;
    skos:inScheme uei: ;
    skos:prefLabel "Directly observed therapy" ;
    skos:related uei:CommunityHealthWorker,
        uei:TuberculosisTreatmentIntervention .

uei:DistanceCounselingIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "online counseling",
        "remote counseling",
        "telecounseling",
        "teletherapy" ;
    skos:broader uei:CounselingIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D003376> ;
    skos:definition "Delivery of psychological counseling, mental health support, or advisory services through remote channels — including telephone, video, or messaging platforms — without in-person contact." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068237>,
        <https://id.nlm.nih.gov/mesh/D000068237> ;
    skos:example "Randomised trial of text-message-based cognitive behavioural therapy delivered to adolescents with depression in rural settings." ;
    skos:hiddenLabel "distance counselling",
        "e-counseling",
        "virtual counseling" ;
    skos:inScheme uei: ;
    skos:prefLabel "Distance counseling" ;
    skos:related uei:CrisisHotlineService,
        uei:HealthEducationBehaviourChange ;
    skos:scopeNote "Covers remote delivery modality across counseling types; distinct from CrisisHotlineService, which focuses on acute crisis intervention." .

uei:DonorConceptionIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-03"^^xsd:date ;
    skos:altLabel "donor insemination",
        "egg donation",
