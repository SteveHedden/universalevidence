uei:SelectiveBreedingIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "animal breeding",
        "crop improvement breeding",
        "genetic improvement programs",
        "plant breeding" ;
    skos:broader uei:AgriculturalResearchIntervention ;
    skos:definition "Deliberate programs that use controlled mating and selection of plants or animals to improve genetic traits — including yield, disease resistance, and adaptability — for agricultural or conservation purposes." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068618>,
        <https://id.nlm.nih.gov/mesh/D000068618> ;
    skos:example "CGIAR wheat breeding program developing drought-tolerant varieties through multi-generation selective crossing." ;
    skos:hiddenLabel "artificial selection",
        "selective cross-breeding" ;
    skos:inScheme uei: ;
    skos:prefLabel "Selective breeding programs" ;
    skos:related uei:BiodiversityConservationIntervention,
        uei:FoodCropProductionIntervention,
        uei:GeneEditingIntervention,
        uei:LivestockIntervention ;
    skos:scopeNote "Covers conventional selective breeding only; excludes genetic modification and transgenic approaches which are distinct." .

uei:TelecommunicationsIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Mobile network expansion",
        "Telecoms infrastructure" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Investment in and deployment of telecommunications infrastructure — including mobile networks, fixed lines, and broadband — to expand connectivity in underserved areas." ;
    skos:exactMatch dac:22020 ;
    skos:example "Expansion of mobile network coverage to rural areas to support mobile money and agricultural information services." ;
    skos:hiddenLabel "telecom investment",
        "telecommunications infrastructure" ;
    skos:inScheme uei: ;
    skos:prefLabel "Telecommunications intervention" ;
    skos:related uei:CommunicationsPolicyAdministration,
        uei:ICTInfrastructureIntervention,
        uei:InformationProvision ;
    skos:scopeNote "Focuses on physical telecoms network infrastructure; distinct from ICT policy and digital literacy interventions."  .

