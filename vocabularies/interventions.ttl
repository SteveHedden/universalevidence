    <http://www.w3.org/2004/02/skos/core#definition> "An education or training intervention that engages learners in participatory activities, practice, problem solving, or discussion rather than passive instruction." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Active learning intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EducationalAssessmentDesignIntervention> .

<https://universalevidence.com/vocab/interventions/AgriculturalEducationTraining>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "agri training" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "farming education" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/VocationalSkillsTraining> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Formal and vocational education and training programs that build skills and knowledge in agriculture, agronomy, animal husbandry, and related fields." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31181> ;
    <http://www.w3.org/2004/02/skos/core#example> "A college program trains students in modern agronomy, crop science, and farm management to build a cadre of skilled agricultural professionals." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "agricultural vocational training" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "agronomy education" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Agricultural education and training" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AgriculturalExtension> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AgriculturalResearchIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/FisheryEducationTraining> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ForestryEducationTraining> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers formal and structured training for agriculture; distinct from agricultural extension which provides informal advisory support to practising farmers." .

uei:AgriculturalLandResourcesIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "agricultural land management",
        "farmland development" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Programs to develop, protect, and sustainably manage agricultural land including land surveying, soil conservation, irrigation land development, and land tenure improvements for farming purposes." ;
    skos:exactMatch dac:31130 ;
    skos:example "An investment project rehabilitates degraded farmland through terracing and soil conservation measures to restore agricultural productivity." ;
    skos:hiddenLabel "land reclamation agriculture",
        "soil conservation" ;
    skos:inScheme uei: ;
    skos:prefLabel "Agricultural land resources development" ;
    skos:related uei:AgrarianReformIntervention,
        uei:AgriculturalPolicyAdministration,
        uei:ForestryDevelopmentIntervention ;
    skos:scopeNote "Focuses on land as a productive resource for agriculture; distinct from land rights or tenure reform programs not specific to agriculture." .

<https://universalevidence.com/vocab/interventions/AgroIndustriesIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Agri-food industry" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Agricultural processing" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Food processing industry" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/EconomicDevelopment> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs and investments to develop agricultural processing, value addition, and agri-food industrial capacity to increase the value of farm outputs and improve rural incomes." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#32161> ;
    <http://www.w3.org/2004/02/skos/core#example> "An investment in a cassava processing factory that converts smallholder output into packaged flour for domestic and export markets." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "agrifood industry development" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "agro-processing" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Agro-industries development" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/IndustrialDevelopmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ModernBiofuelsManufacturingIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/StorageInfrastructureIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers the industrial processing of agricultural products; distinct from on-farm production support classified under AgriculturalIntervention." .

