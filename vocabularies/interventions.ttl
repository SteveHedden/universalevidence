    <http://www.w3.org/2004/02/skos/core#prefLabel> "Textbook and curriculum materials development" .

<https://universalevidence.com/vocab/interventions/DDRIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "DDR" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "SALW control" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "ex-combatant reintegration" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PeacebuildingIntervention> ;
