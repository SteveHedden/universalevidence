uei:DebtBuyBackIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Debt repurchase" ;
    skos:broader uei:DebtActionIntervention ;
    skos:definition "A mechanism by which a debtor country repurchases its own outstanding debt obligations — typically at a discount on secondary markets — to reduce its external debt stock and service burden." ;
    skos:exactMatch dac:60063 ;
    skos:example "A government uses a reserve fund to repurchase sovereign bonds at a 40% discount on the secondary market, reducing total external debt stock." ;
    skos:hiddenLabel "debt buy back",
        "debt buyback" ;
    skos:inScheme uei: ;
    skos:prefLabel "Debt buy-back" ;
    skos:related uei:DebtForgivenessIntervention,
        uei:DebtReschedulingIntervention,
        uei:OtherDebtSwapIntervention ;
    skos:scopeNote "Distinct from debt forgiveness (cancellation by creditor) and debt rescheduling (extension of terms); here the debtor actively buys back its own obligations." .

