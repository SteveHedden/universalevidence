uei:PatientNavigationIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "health system navigation",
        "peer navigation",
        "service navigation" ;
    skos:broader uei:CareCoordinationNavigationIntervention ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D010343>,
        <http://id.nlm.nih.gov/mesh/D010353> ;
    skos:definition "Support that helps patients move through health services, appointments, referrals, and follow-up care, often using navigators or peer navigators." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D062526>,
