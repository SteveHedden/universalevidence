<https://universalevidence.com/vocab/interventions/HumanRightsIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "human rights protection" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "rights promotion" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15160> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate programs, advocacy, monitoring, and legal mechanisms to promote and protect fundamental human rights and hold duty-bearers accountable for rights violations." ;
    <http://www.w3.org/2004/02/skos/core#example> "Support to national human rights institutions and civil society organizations monitoring detention conditions." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "human rights programming" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "rights-based programming" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Human rights intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AntiCorruptionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ChildProtectiveServicesIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/CultureAndDiversityIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/LegalJudicialDevelopmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers broad human rights promotion; gender-specific rights programs are captured under women's rights and GBV interventions." .

