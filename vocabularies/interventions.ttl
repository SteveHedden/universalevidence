uei:AIAgencyIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:broader uei:AIDecisionSupportIntervention ;
    skos:definition "Use of artificial intelligence systems to act or decide on behalf of people or organizations." ;
    skos:inScheme uei: ;
    skos:prefLabel "AI agency intervention" .

<https://universalevidence.com/vocab/interventions/AIAssistedParenting>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/ParentingIntervention> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Parenting interventions that use artificial intelligence tools to tailor guidance, coaching, reminders, or feedback for caregivers." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "AI-assisted parenting support" .

uei:AICommunicationSupport a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:altLabel "AI translation",
        "AI-assisted communication" ;
    skos:broader uei:InformationAndCommunication ;
    skos:definition "Use of artificial intelligence tools to support communication tasks, including drafting, translation, summarization, or message tailoring." ;
    skos:inScheme uei: ;
    skos:prefLabel "AI communication support" .

uei:AIDisclosureIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-18"^^xsd:date ;
    skos:definition "Disclosure that content, advice, or decisions were generated or assisted by artificial intelligence." ;
    skos:broader uei:DisclosureIntervention ;
    skos:inScheme uei: ;
    skos:prefLabel "AI disclosure intervention" .

uei:AIRegulationIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-09"^^xsd:date ;
    skos:altLabel "AI policy",
        "artificial intelligence regulation" ;
    skos:broader uei:PolicyGovernanceEvidenceAndOversight ;
    skos:definition "Policies, standards, oversight mechanisms, or governance arrangements intended to regulate the design, deployment, transparency, or accountability of artificial intelligence systems." ;
    skos:inScheme uei: ;
    skos:prefLabel "AI regulation intervention" .

<https://universalevidence.com/vocab/interventions/AISkillsProfiling>
    <http://purl.org/dc/terms/created> "2026-06-16"^^<http://www.w3.org/2001/XMLSchema#date> ;
