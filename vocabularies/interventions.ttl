uei:MiniGridDistributionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Mini-grid infrastructure",
        "Off-grid electricity distribution" ;
    skos:broader uei:Infrastructure ;
    skos:definition "Investment in construction, rehabilitation, or expansion of local electricity distribution infrastructure for isolated mini-grids serving communities not connected to the centralised national grid." ;
    skos:exactMatch dac:23631 ;
    skos:example "Installation of a local electricity distribution network for a solar-powered mini-grid serving a remote rural community." ;
    skos:hiddenLabel "isolated grid distribution",
        "rural mini grid" ;
    skos:inScheme uei: ;
    skos:prefLabel "Electric power transmission and distribution — isolated mini-grids" ;
    skos:related uei:HybridEnergySystemIntervention,
        uei:SolarEnergyOffGridIntervention ;
    skos:scopeNote "Covers isolated mini-grid distribution only; centralised grid transmission is classified separately." .

uei:OffShoreMineralsMiningIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "deep-sea mining",
        "marine minerals",
        "seabed mining" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments in the exploration, extraction, and development of mineral resources from seabed and offshore environments." ;
    skos:exactMatch dac:32268 ;
    skos:example "Feasibility study for deep-sea mineral extraction in the exclusive economic zone of a small island developing state." ;
    skos:inScheme uei: ;
    skos:prefLabel "Offshore minerals mining and development" ;
    skos:related uei:MineralProspectionExplorationIntervention,
        uei:OilGasUpstreamIntervention .

uei:OpenFractureReductionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "ORIF",
        "Open reduction internal fixation",
        "Surgical fracture reduction" ;
    skos:broader uei:OrthopedicSurgeryIntervention ;
    skos:definition "A surgical procedure in which a bone fracture is realigned through a surgical incision, providing direct visualization of the fracture site, typically followed by internal fixation with plates, screws, or rods." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000070799>,
        <https://id.nlm.nih.gov/mesh/D000070799> ;
    skos:example "RCT comparing open reduction internal fixation versus external fixation for unstable ankle fractures in terms of functional outcomes and complication rates." ;
    skos:hiddenLabel "ORIF surgery",
        "open fracture reduction",
        "open reduction" ;
    skos:inScheme uei: ;
    skos:prefLabel "Open fracture reduction" ;
    skos:related uei:ClosedFractureReductionIntervention,
        uei:FasciotomyIntervention ;
    skos:scopeNote "Distinct from ClosedFractureReductionIntervention, which involves no surgical incision." .

