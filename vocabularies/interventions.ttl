uei:DebtForDevelopmentSwapIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Debt conversion for development",
        "Debt swap" ;
    skos:broader uei:DebtActionIntervention ;
    skos:definition "A mechanism by which a creditor country or institution cancels or reduces a debtor country's obligations in exchange for the debtor committing equivalent funds to development priorities such as health, education, or environment." ;
    skos:exactMatch dac:60061 ;
    skos:example "Debt-for-nature swap redirecting debt service payments to conservation programs in Ecuador." ;
    skos:hiddenLabel "debt for education swap",
        "debt for health swap",
        "debt for nature swap" ;
    skos:inScheme uei: ;
    skos:prefLabel "Debt-for-development swap" ;
    skos:related uei:DebtForgivenessIntervention,
        uei:OtherDebtSwapIntervention ;
    skos:scopeNote "A specific swap modality targeting development expenditure; distinguished from other debt swaps by its development conditionality." .

<https://universalevidence.com/vocab/interventions/DecentralisationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "fiscal decentralisation" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "local government reform" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicAdministrationReform> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate reforms and capacity-building programs to devolve authority, resources, and service delivery responsibilities to subnational governments and local administrations." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#15112> ;
    <http://www.w3.org/2004/02/skos/core#example> "Transferring block grants and planning authority to district councils paired with capacity-building for local officials." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "decentralization" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "devolution" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Decentralisation and subnational government support" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/PublicFinanceManagementReform> .

<https://universalevidence.com/vocab/interventions/DevelopmentAwarenessIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Development education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Global education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Public awareness for development" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/CampaignMediaContentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs in donor countries that raise public awareness of, and support for, international development issues and development cooperation, including public education campaigns, media outreach, and civil society engagement." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#99820> ;
    <http://www.w3.org/2004/02/skos/core#example> "A European donor agency funds school curricula and public exhibitions on global poverty and the Sustainable Development Goals to build domestic public support for aid budgets." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "aid awareness" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "development awareness" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "global citizenship education" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Development awareness promotion" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DemocraticParticipationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EnvironmentalEducationTrainingIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Targets audiences in donor countries rather than developing-country populations; aims at building public understanding and political support for development cooperation rather than directly addressing a development condition." .

