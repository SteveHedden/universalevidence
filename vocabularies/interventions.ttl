uei:AgriculturalResearchIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "agri R&D",
        "crop research",
        "farming systems research" ;
    skos:broader uei:TrainingAndCapacityBuilding ;
    skos:definition "Organized research activities — including applied, technological, and policy research — aimed at improving agricultural productivity, crop varieties, pest management, soil health, and farming systems." ;
    skos:exactMatch dac:31182 ;
    skos:example "A CGIAR centre develops drought-tolerant maize varieties through breeding research targeted at Sub-Saharan African farming conditions." ;
    skos:hiddenLabel "agricultural science",
        "agronomy research" ;
    skos:inScheme uei: ;
    skos:prefLabel "Agricultural research" ;
    skos:related uei:AgriculturalEducationTraining,
        uei:AgriculturalExtension,
        uei:EnvironmentalResearchIntervention,
        uei:FisheryResearch,
        uei:ForestryResearch,
        uei:ResearchInstitutionStrengtheningIntervention,
        uei:SeedBankIntervention,
        uei:TechnologicalResearchDevelopmentIntervention ;
    skos:scopeNote "Covers research investment in agriculture; distinct from extension which translates research findings into practice for farmers." .

<https://universalevidence.com/vocab/interventions/BusinessPolicyAdministrationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
