uei:PETCTImagingIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "PET/CT",
        "positron emission tomography-CT" ;
    skos:broader uei:PositronEmissionTomography ;
    skos:definition "A combined nuclear medicine and radiological imaging procedure that integrates positron emission tomography (PET) and computed tomography (CT) to provide simultaneous metabolic and anatomical information, used for cancer staging, diagnosis, and treatment monitoring." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000072078>,
        <https://id.nlm.nih.gov/mesh/D000072078> ;
    skos:example "PET-CT used for staging of non-small cell lung cancer to guide treatment decisions." ;
    skos:hiddenLabel "PET CT scan",
        "positron emission tomography computed tomography" ;
    skos:inScheme uei: ;
    skos:prefLabel "PET-CT imaging" ;
    skos:related uei:SPECTCTImagingIntervention ;
    skos:scopeNote "Refers to the combined PET-CT diagnostic imaging modality; distinct from standalone CT or PET imaging." .

uei:ParentingIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:BehaviorChangeIntervention ;
    skos:definition "Programs or services intended to improve parenting practices, caregiver-child interactions, or family support." ;
    skos:inScheme uei: ;
    skos:prefLabel "Parenting intervention" .

uei:PeacekeepingSecurityIntervention a skos:Concept,
