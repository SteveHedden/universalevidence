    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#11320> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs and investments designed to improve access, retention, and quality at the secondary school level, including lower and upper secondary." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#11260> ;
