    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D005513> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://id.nlm.nih.gov/mesh/D007881> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#43073> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Deliberate programs, regulatory actions, and standards to reduce foodborne hazards, improve food quality, and strengthen food safety governance throughout the food supply chain." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <http://id.nlm.nih.gov/mesh/D059022> ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://id.nlm.nih.gov/mesh/D059022> ;
    <http://www.w3.org/2004/02/skos/core#example> "National food safety authority capacity building and market monitoring in Ghana to reduce aflatoxin exposure." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "food inspection program" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "food safety regulation" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "sanitary standards" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Food safety and quality intervention" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/FoodSecurityPolicyIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/NutritionIntervention> .

uei:ForestryEducationTraining a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Forest sector training",
        "Silviculture training" ;
    skos:broader uei:VocationalSkillsTraining ;
    skos:definition "Formal and vocational education and training programs that build skills and knowledge in forestry management, silviculture, and related natural resource disciplines." ;
    skos:exactMatch dac:31281 ;
    skos:example "A technical college program training forest rangers and sustainable logging practitioners in tropical countries." ;
    skos:hiddenLabel "forest education",
        "forestry vocational training" ;
    skos:inScheme uei: ;
    skos:prefLabel "Forestry education and training" ;
    skos:related uei:AgriculturalEducationTraining,
        uei:ForestryDevelopmentIntervention .

uei:GenderAffirmingCareIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:altLabel "gender affirming care",
        "gender-affirming health care" ;
    skos:broader uei:ReproductiveFamilyAndGenderHealthCareIntervention ;
    skos:definition "Health care interventions that support gender affirmation, including clinical, behavioral health, hormonal, and surgical services." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000097962>,
        <https://id.nlm.nih.gov/mesh/D000097962>,
        <https://id.nlm.nih.gov/mesh/D057829> ;
    skos:inScheme uei: ;
    skos:prefLabel "Gender-affirming care" ;
