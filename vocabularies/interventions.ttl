    skos:inScheme uei: ;
    skos:prefLabel "Elder care interventions" .

uei:ElectricMobilityInfrastructureIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "EV charging infrastructure",
        "Electric vehicle infrastructure" ;
    skos:broader uei:RoadTransportIntervention ;
    skos:definition "Investment in infrastructure supporting electric vehicles and electric transport, including charging stations, battery swap networks, and related grid integration systems." ;
    skos:exactMatch dac:23642 ;
    skos:example "Public investment in a national network of electric vehicle charging stations to support the adoption of electric buses and cars." ;
    skos:hiddenLabel "EV infrastructure",
        "charging network",
        "electric mobility" ;
    skos:inScheme uei: ;
    skos:prefLabel "Electric mobility infrastructure intervention" ;
    skos:related uei:EnergyPolicyAdministration .

uei:EmergencyMedicalDispatchIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "EMD",
        "emergency dispatch" ;
    skos:broader uei:EmergencyAcuteCareIntervention ;
    skos:definition "Structured systems and protocols for receiving emergency calls, triaging medical emergencies, and dispatching appropriate emergency medical services, including provision of telephone-guided pre-arrival care instructions." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000071820>,
        <https://id.nlm.nih.gov/mesh/D000071820> ;
    skos:example "Implementation of Medical Priority Dispatch System (MPDS) protocols to standardize emergency triage and dispatcher-assisted CPR instructions." ;
    skos:hiddenLabel "911 dispatch",
        "ambulance dispatch",
        "medical dispatch" ;
    skos:inScheme uei: ;
    skos:prefLabel "Emergency medical dispatch" ;
    skos:related uei:CrisisHotlineService,
        uei:MultiHazardPreparednessIntervention ;
    skos:scopeNote "Covers the dispatch coordination intervention, not the delivery of on-scene emergency care itself." .

uei:EnduranceTrainingIntervention a skos:Concept,
