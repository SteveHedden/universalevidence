uei:ReadyToUseTherapeuticFoodIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-07"^^xsd:date ;
    skos:altLabel "RUTF",
        "RUSF",
        "Ready-to-use therapeutic food",
        "Ready-to-use supplementary food" ;
    skos:broader uei:NutritionalSupport ;
    skos:definition "Provision of shelf-stable, energy-dense, micronutrient-fortified ready-to-use products: RUTF for treatment of severe acute malnutrition and RUSF for management of moderate acute malnutrition, distinct from staple-food fortification and therapeutic milk formulas." ;
    skos:scopeNote "Use only for explicit ready-to-use therapeutic or supplementary food products; generic feeding, dietary advice, and ordinary balanced food supplements do not imply this intervention." ;
    skos:inScheme uei: ;
    skos:prefLabel "Ready-to-use therapeutic/supplementary food" .

uei:TherapeuticMilkFormulaIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-08-07"^^xsd:date ;
    skos:altLabel "F75",
        "F100",
        "F-75",
        "F-100",
        "therapeutic milk",
        "stabilisation formula",
        "stabilization formula",
        "transition formula",
        "rehabilitation formula" ;
    skos:broader uei:NutritionalSupport ;
    skos:definition "Milk-based therapeutic formulas provided under clinical supervision in facility-based treatment of severe acute malnutrition, including standard F75 and F100 feeds and modified or investigational variants such as the reduced-calorie F50 and F35 feeds." ;
    skos:inScheme uei: ;
    skos:prefLabel "Therapeutic milk formula" ;
    skos:scopeNote "Use for milk-based therapeutic formulas administered during facility-based treatment of severe acute malnutrition, including standard, modified, or investigational stabilization, transition, or rehabilitation feeds. Excludes ordinary milk, infant formula, ready-to-use therapeutic or supplementary foods (RUTF/RUSF), general food supplements, and fortification of staple foods." .

