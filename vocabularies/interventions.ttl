        dac:15230 ;
    skos:hiddenLabel "peace and security operations" ;
    skos:inScheme uei: ;
    skos:prefLabel "Peacekeeping and security intervention" ;
    skos:related uei:DdrSalwIntervention,
        uei:SecuritySectorReformIntervention ;
    skos:scopeNote "Distinct from PostConflictReconstruction which focuses on rebuilding after conflict has ended."  .

uei:PlantProtectionPestControlIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "crop protection",
        "pest management",
        "post-harvest loss reduction" ;
    skos:broader uei:AgriculturalPolicyAdministration ;
    skos:closeMatch <http://id.nlm.nih.gov/mesh/D010571>,
        <https://id.nlm.nih.gov/mesh/D010571> ;
    skos:definition "Programs to protect crops from pests, diseases, and post-harvest losses through integrated pest management, pesticide application, storage treatment, and phytosanitary measures." ;
    skos:exactMatch dac:31192 ;
    skos:example "A program trains farmers in integrated pest management to reduce crop losses from fall armyworm and minimize pesticide use." ;
    skos:hiddenLabel "IPM",
        "integrated pest management",
        "pesticide program" ;
    skos:inScheme uei: ;
    skos:prefLabel "Plant and post-harvest protection and pest control" ;
    skos:related uei:AgriculturalInputSupport,
        uei:StorageInfrastructureIntervention .

uei:PostEmergencyReconstructionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Early recovery",
        "Post-disaster rehabilitation",
        "Reconstruction after emergency" ;
    skos:broader uei:HumanitarianResponse ;
    skos:definition "Immediate reconstruction and rehabilitation activities following a disaster or conflict — including repair of infrastructure, restoration of basic services, and transitional shelter — to restore conditions to pre-crisis levels." ;
    skos:exactMatch dac:73010 ;
    skos:example "Rapid repair of schools and health clinics damaged by cyclone winds within the first six months after the disaster." ;
    skos:hiddenLabel "immediate reconstruction",
        "post emergency reconstruction" ;
    skos:inScheme uei: ;
    skos:prefLabel "Post-emergency reconstruction and rehabilitation" ;
    skos:related uei:DisasterRiskReductionIntervention,
        uei:MaterialReliefAssistanceIntervention,
        uei:MultiHazardPreparednessIntervention,
        uei:RuralDevelopmentIntervention ;
    skos:scopeNote "Covers the early recovery and rehabilitation phase immediately following a crisis, bridging acute relief and longer-term development; distinct from longer-term post-conflict reconstruction programs." .

<https://universalevidence.com/vocab/interventions/PowerGridTransmissionIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Grid transmission and distribution" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Power grid infrastructure" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/Infrastructure> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://id.nlm.nih.gov/mesh/D004559> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Investment in construction, rehabilitation, or expansion of high-voltage transmission lines, substations, and distribution networks forming part of a centralised national or regional electricity grid." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#23630> ;
    <http://www.w3.org/2004/02/skos/core#example> "Construction of high-voltage transmission lines to connect a new power plant to the national grid in sub-Saharan Africa." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "electricity transmission lines" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "power distribution network" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Electric power transmission and distribution — centralised grids" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/RenewableEnergyGenerationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers centralised grid infrastructure; isolated mini-grid distribution is classified separately." .

<https://universalevidence.com/vocab/interventions/PricingPolicyIntervention>
    <http://purl.org/dc/terms/created> "2026-06-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/MarketProcurementAndIncentivePolicy> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Rules or deliberate changes to the setting or presentation of prices intended to improve fairness, transparency, or affordability for buyers." ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Fair pricing interventions" .

<https://universalevidence.com/vocab/interventions/ReliefCoordinationIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Emergency coordination services" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Humanitarian coordination" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/HumanitarianResponse> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs and mechanisms that plan, coordinate, and support humanitarian relief operations — including cluster coordination, logistics support, needs assessment, and information management — to improve the effectiveness of multi-actor emergency responses." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#72050> ;
    <http://www.w3.org/2004/02/skos/core#example> "OCHA cluster coordination meetings enabling NGOs to harmonize camp management and non-food item distributions after an earthquake." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "humanitarian cluster coordination" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "relief co-ordination" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "relief coordination" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Relief coordination and support services" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DisasterRiskReductionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EmergencyFoodAssistanceIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MaterialReliefAssistanceIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MultiHazardPreparednessIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers coordination and support functions rather than direct delivery of relief goods or services." .

