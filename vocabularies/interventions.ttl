    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/WomensRightsOrganisationSupport> .

uei:EndoscopicMucosalResectionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "EMR" ;
    skos:broader uei:DigestiveSystemSurgeryIntervention ;
    skos:definition "A minimally invasive endoscopic procedure used to remove superficial lesions, early-stage cancers, or large polyps from the mucosal lining of the gastrointestinal tract without open surgery." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000069916>,
        <https://id.nlm.nih.gov/mesh/D000069916> ;
    skos:example "RCT comparing endoscopic mucosal resection versus endoscopic submucosal dissection for removal of large colorectal adenomas." ;
    skos:hiddenLabel "endoscopic mucosal resection",
        "mucosectomy" ;
    skos:inScheme uei: ;
    skos:prefLabel "Endoscopic mucosal resection" ;
    skos:related uei:NCDControlIntervention,
        uei:TransanalEndoscopicMicrosurgeryIntervention,
        uei:TransanalEndoscopicSurgeryIntervention ;
    skos:scopeNote "Related to but distinct from TransanalEndoscopicMicrosurgeryIntervention and TransanalEndoscopicSurgeryIntervention, which are transanal approaches rather than endoluminal resection." .

uei:EnergyEducationTraining a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Energy sector training",
        "Renewable energy training" ;
    skos:broader uei:VocationalSkillsTraining ;
    skos:definition "Vocational and technical training programs that build workforce capacity in energy engineering, renewable energy technologies, and energy management." ;
    skos:exactMatch dac:23181 ;
    skos:example "Training solar panel installation technicians to support rural electrification programs." ;
    skos:hiddenLabel "energy education",
        "energy workforce training" ;
    skos:inScheme uei: ;
    skos:prefLabel "Energy education and training" ;
    skos:related uei:EnergyPolicyAdministration,
        uei:EnergyResearch,
        uei:ICTTelecomsMediaEducationTraining ;
    skos:scopeNote "Sector-specific training for energy; distinct from energy policy reform and from energy infrastructure construction." .

uei:FinancialManagementIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-17"^^xsd:date ;
    skos:broader uei:InstitutionalReform ;
    skos:definition "Planning, budgeting, accounting, control, or oversight of financial resources for programs, organizations, or services." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D005376>,
        <https://id.nlm.nih.gov/mesh/D005376> ;
    skos:inScheme uei: ;
    skos:prefLabel "Financial management" .

uei:FisheryResearch a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Aquaculture research",
        "Fisheries research" ;
    skos:broader uei:TrainingAndCapacityBuilding ;
    skos:definition "Organized research activities aimed at improving knowledge of fish stocks, aquatic ecosystems, sustainable harvesting methods, and fisheries policy." ;
    skos:exactMatch dac:31382 ;
    skos:example "A research program assessing fish stock depletion and sustainable yield thresholds in Lake Victoria to inform national fishing quotas." ;
    skos:hiddenLabel "fish sector research",
        "marine research" ;
    skos:inScheme uei: ;
    skos:prefLabel "Fishery research" ;
    skos:related uei:AgriculturalResearchIntervention,
        uei:FisheryDevelopmentIntervention  .

uei:FoodCropProductionIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "food crop development",
        "staple crop support" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs to improve the production of staple and food crops through improved varieties, agronomic practices, mechanization, and production system development." ;
    skos:exactMatch dac:31161 ;
    skos:example "A program distributes improved maize varieties and provides agronomic training to smallholder farmers to increase food crop yields." ;
    skos:hiddenLabel "cereal production",
        "grain production support" ;
    skos:inScheme uei: ;
    skos:prefLabel "Food crop production support" ;
    skos:related uei:AgriculturalExtension,
        uei:AgriculturalInputSupport,
        uei:SelectiveBreedingIntervention ;
    skos:scopeNote "Focuses on crops grown primarily for food consumption; distinct from industrial or export crop production." .

uei:ForestIndustriesIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Pulp and paper industry",
        "Timber industry",
        "Wood processing industry" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments to develop industrial processing of timber and non-timber forest products, including sawmilling, pulp and paper, and wood products manufacturing." ;
    skos:exactMatch dac:32162 ;
    skos:example "A development finance investment in a certified sustainable timber processing mill in a tropical forest country." ;
    skos:hiddenLabel "logging industry",
        "lumber industry" ;
    skos:inScheme uei: ;
    skos:prefLabel "Forest industries development" ;
    skos:related uei:ForestryDevelopmentIntervention,
        uei:IndustrialDevelopmentIntervention  .

<https://universalevidence.com/vocab/interventions/GeneralBudgetSupportIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Direct budget support" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "GBS" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Programme aid" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/PublicFinanceManagementReform> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Direct financial transfers to a partner government's treasury, provided as general or sectoral budget support to supplement public expenditure without restriction to specific projects." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#51010> ;
    <http://www.w3.org/2004/02/skos/core#example> "IMF/World Bank general budget support to Rwanda conditional on public financial management reforms." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "budget support aid" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "general programme support" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "General budget support" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DebtActionIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/DomesticRevenueMobilisationIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MacroeconomicPolicyReform> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from project aid; funds flow through government systems and are not earmarked to specific activities." .

uei:HIVPreExposureProphylaxisIntervention a skos:Concept,
