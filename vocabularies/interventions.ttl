    <http://www.w3.org/2004/02/skos/core#prefLabel> "Family-friendly policy intervention" .

uei:FertilizerMineralsMiningIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "fertilizer mineral extraction",
        "phosphate mining",
        "potash mining" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs and investments in the extraction and development of minerals used in fertilizer production, including phosphate rock and potash." ;
    skos:exactMatch dac:32267 ;
    skos:example "Investment in phosphate rock extraction infrastructure to supply domestic fertilizer manufacturing." ;
    skos:inScheme uei: ;
    skos:prefLabel "Fertilizer minerals mining and development" ;
    skos:related uei:AgriculturalInputSupport,
        uei:FertilizerPlantIntervention .

uei:FisheryEducationTraining a skos:Concept,
        ue:Intervention ;
    skos:altLabel "Aquaculture training",
        "Fish sector training",
        "Fisheries training" ;
    skos:broader uei:VocationalSkillsTraining ;
    skos:definition "Formal and vocational education and training programs that build skills and knowledge in fisheries management, aquaculture, and related marine and freshwater resource disciplines." ;
    skos:exactMatch dac:31381 ;
    skos:example "A vocational program training coastal fisherfolk in improved net-making, fish handling, and sustainable harvesting practices." ;
    skos:hiddenLabel "fishery vocational training" ;
    skos:inScheme uei: ;
    skos:prefLabel "Fishery education and training" ;
    skos:related uei:AgriculturalEducationTraining,
        uei:FisheryDevelopmentIntervention .

<https://universalevidence.com/vocab/interventions/FoodSafetyIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Food quality control" ;
