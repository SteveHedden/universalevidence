uei:PredominantlyPlantBasedDietIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Predominantly plant-based diet"@en ;
    skos:definition "Prescribed dietary pattern emphasizing plant foods while allowing some animal-derived foods, without requiring vegetarian or vegan exclusion."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT06871722> .

uei:DentalPlaqueAccumulationChallengeIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Dental plaque accumulation challenge"@en ;
    skos:definition "Protocol-directed interruption of specified oral-hygiene practices to induce plaque accumulation and measure gingival or periodontal responses."@en ;
    skos:broader uei:ScreeningTestingAndClinicalEvaluation ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT05864768> .

uei:LowPurineDietIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Low-purine diet"@en ;
    skos:definition "Prescribed dietary restriction of purine-rich foods to manage hyperuricemia or gout."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT04801745> .

uei:FoodExclusionDietIntervention a skos:Concept, ue:Intervention ;
    skos:prefLabel "Food exclusion diet"@en ;
    skos:definition "Therapeutic dietary regimen that removes specified foods or food groups to manage symptoms or disease, with optional structured reintroduction."@en ;
    skos:broader uei:NutritionTherapy ;
    skos:inScheme uei: ;
    dcterms:source <https://clinicaltrials.gov/study/NCT02610101> .
