uei:HIVAIDSSocialMitigationIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "AIDS social mitigation",
        "HIV social support" ;
    skos:broader uei:PublicHealthAndDiseaseControlIntervention ;
    skos:definition "Programs that address the social and economic consequences of HIV/AIDS — including support for orphans, affected households, and stigma reduction — beyond clinical treatment." ;
    skos:exactMatch dac:16064 ;
    skos:example "Cash transfers and psychosocial support programs for households caring for AIDS orphans." ;
    skos:hiddenLabel "AIDS orphan support",
