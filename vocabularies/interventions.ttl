        <https://id.nlm.nih.gov/mesh/D015921> ;
    skos:inScheme uei: ;
    skos:prefLabel "Dental implants" .

<https://universalevidence.com/vocab/interventions/DigitalMessagingIntervention>
    <http://purl.org/dc/terms/created> "2026-06-12"^^<http://www.w3.org/2001/XMLSchema#date> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
