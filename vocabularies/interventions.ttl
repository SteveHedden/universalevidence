        uei:InformationProvision,
        uei:SolarEnergyOffGridIntervention,
        uei:TelecommunicationsIntervention ;
    skos:scopeNote "Covers physical and digital ICT infrastructure; distinct from digital literacy training and from telecommunications-specific interventions."  .

