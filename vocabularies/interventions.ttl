<https://universalevidence.com/vocab/interventions/FuelwoodCharcoalIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Biomass fuel" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Charcoal production" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "Wood fuel intervention" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/EconomicDevelopment> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs to sustainably produce, manage, and improve access to fuelwood and charcoal as energy sources, including improved cookstove promotion and wood fuel supply chain development." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31261> ;
    <http://www.w3.org/2004/02/skos/core#example> "A program promoting efficient charcoal kilns and improved cookstoves to reduce wood fuel consumption and deforestation in rural households." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "firewood" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "wood energy" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Fuelwood and charcoal production and management" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/BioenergyPowerIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EnergyEfficiencyIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/ForestryDevelopmentIntervention> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Focuses on the production and supply side of wood-based solid fuels; overlaps with bioenergy and forestry development but is distinct in its household energy access framing." .

