    <http://www.w3.org/2004/02/skos/core#prefLabel> "Women's rights organisations and movement support" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/EndingViolenceAgainstWomenIntervention> .

<https://universalevidence.com/vocab/interventions/YouthLifeSkillsEducation>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "out-of-school youth education" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "youth non-formal education" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/TrainingAndCapacityBuilding> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Non-formal education programs that equip young people outside the formal school system with foundational literacy, numeracy, and practical life and social skills." ;
    <http://www.w3.org/2004/02/skos/core#exactMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#11231> ;
    <http://www.w3.org/2004/02/skos/core#example> "A program providing literacy and life skills training to out-of-school adolescent girls in rural communities." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "life skills training youth" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Youth life skills education" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AdultLiteracyEducation> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/VocationalSkillsTraining> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Targets out-of-school youth; distinguished from formal secondary education and adult literacy programs." .

uei:ActiveLaborMarketPolicies a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-07"^^xsd:date ;
    skos:broader uei:EmploymentPolicyIntervention ;
    skos:definition "Public policies or programs intended to improve employment, job matching, skills, or labor-market participation." ;
    skos:inScheme uei: ;
    skos:prefLabel "Active labor market policies" .

uei:AgriculturalAlternativeDevelopmentIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "alternative livelihoods",
        "illicit crop substitution" ;
    skos:broader uei:EconomicDevelopment ;
    skos:definition "Programs that support farmers to transition away from illicit drug crop cultivation — such as opium poppy or coca — to legal and sustainable agricultural livelihoods." ;
    skos:exactMatch dac:31165 ;
    skos:example "A program in Afghanistan supports poppy farmers to switch to wheat and vegetable cultivation by providing inputs, market linkages, and technical assistance." ;
    skos:hiddenLabel "coca eradication alternative",
        "drug crop replacement",
        "opium poppy substitution" ;
    skos:inScheme uei: ;
    skos:prefLabel "Agricultural alternative development" ;
    skos:related uei:AgriculturalExtension,
        uei:NarcoticsControlIntervention,
        uei:NonAgriculturalAlternativeDevelopmentIntervention ;
    skos:scopeNote "Specifically addresses the agricultural dimension of illicit drug production; related to but distinct from narcotics control interventions focused on law enforcement." .

uei:AgriculturalCooperativesIntervention a skos:Concept,
        ue:Intervention ;
    skos:altLabel "farmer cooperatives",
        "farmer groups",
        "producer organisations" ;
    skos:broader uei:InstitutionalReform ;
    skos:definition "Programs to establish, strengthen, and support farmer cooperatives and producer organizations to improve collective bargaining, market access, input procurement, and financial services for smallholder farmers." ;
    skos:exactMatch dac:31194 ;
    skos:example "A program supports the formation and governance capacity of dairy farmer cooperatives to collectively negotiate milk prices and access veterinary services." ;
    skos:hiddenLabel "agricultural producer group",
        "farming cooperative" ;
    skos:inScheme uei: ;
    skos:prefLabel "Agricultural cooperatives support" ;
    skos:related uei:AgriculturalExtension,
        uei:AgriculturalFinancialServicesIntervention,
        uei:BusinessDevelopmentServices .

<https://universalevidence.com/vocab/interventions/AgriculturalFinancialServicesIntervention>
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://universalevidence.com/ontology/Intervention> ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "agri-finance" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "agricultural credit" ;
    <http://www.w3.org/2004/02/skos/core#altLabel> "farm credit" ;
    <http://www.w3.org/2004/02/skos/core#broader> <https://universalevidence.com/vocab/interventions/AccessToFinance> ;
    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://webfs.oecd.org/crs-iati-xml/Lookup/DAC-CRS-CODES.xml#31193> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Programs to improve access to credit, savings, insurance, and other financial services specifically tailored to the needs of farmers and agribusinesses, including agricultural credit lines and crop insurance schemes." ;
    <http://www.w3.org/2004/02/skos/core#example> "A development bank establishes an agricultural credit guarantee fund to incentivize commercial banks to lend to smallholder farmers." ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "agricultural lending" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "crop insurance" ;
    <http://www.w3.org/2004/02/skos/core#hiddenLabel> "farm loans" ;
    <http://www.w3.org/2004/02/skos/core#inScheme> <https://universalevidence.com/vocab/interventions/> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Agricultural financial services" ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/AgriculturalCooperativesIntervention> ;
    <http://www.w3.org/2004/02/skos/core#related> <https://universalevidence.com/vocab/interventions/MicrofinanceCreditServices> ;
    <http://www.w3.org/2004/02/skos/core#scopeNote> "Focuses on financial services for the agricultural sector; distinct from general microfinance programs not targeted at agriculture." .

uei:AntiparasiticDrugTherapy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "Anthelmintic therapy",
        "Antiparasitic medication" ;
    skos:broader uei:AntiInfectiveDrugTherapy ;
    skos:definition "Treatment using medicines intended to prevent, suppress, or eliminate parasitic infections." ;
    skos:example "Albendazole administration for helminth infection." ;
    skos:inScheme uei: ;
    skos:prefLabel "Antiparasitic drug therapy" ;
    skos:related uei:AntibioticTherapy,
        uei:AntifungalTherapy,
        uei:AntimalarialDrugTherapy ;
    skos:scopeNote "Use antimalarial drug therapy for malaria-specific regimens." .

uei:AntiretroviralTherapy a skos:Concept,
        ue:Intervention ;
    skos:altLabel "ART",
        "HAART",
        "Highly active antiretroviral therapy" ;
    skos:broader uei:HIVAidsTreatmentIntervention ;
    skos:definition "Combination antiretroviral drug therapy for people living with HIV." ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D023241>,
        <https://id.nlm.nih.gov/mesh/D023241> ;
    skos:inScheme uei: ;
    skos:prefLabel "Antiretroviral therapy" ;
    skos:related uei:AntiviralTherapy,
        uei:HIVPreExposureProphylaxisIntervention,
        uei:STDControlIntervention .

uei:AntiviralTherapy a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-15"^^xsd:date ;
    skos:altLabel "Antiviral drug therapy" ;
    skos:broader uei:AntiInfectiveDrugTherapy ;

    skos:definition "Treatment using antiviral medicines to prevent, suppress, or treat viral infections other than HIV-specific antiretroviral therapy." ;
    skos:example "Acyclovir treatment for herpesvirus infection." ;
    skos:inScheme uei: ;
    skos:prefLabel "Antiviral therapy" ;
    skos:related uei:AntibioticTherapy,
        uei:AntifungalTherapy,
        uei:AntiretroviralTherapy ;
    skos:scopeNote "Use HIV/AIDS-specific antiretroviral therapy for ART and antiretroviral regimens." .

uei:AuditIntervention a skos:Concept,
        ue:Intervention ;
    dcterms:created "2026-06-10"^^xsd:date ;
    skos:broader uei:MonitoringIntervention ;
    skos:definition "Operational inspection, verification, review, or monitoring activities used to improve compliance, accountability, service quality, or performance." ;
    skos:inScheme uei: ;
    skos:prefLabel "Audit intervention" ;
    skos:related uei:TaxAuditIntervention ;
    skos:scopeNote "Includes audits deployed as operational or policy interventions; excludes audit-study, correspondence-experiment, and mystery-shopper methods used only to measure discrimination or behavior." .

uei:BankingFinancialServicesEducationTraining a skos:Concept,
        ue:Intervention ;
    skos:altLabel "banking education",
        "financial sector training" ;
    skos:broader uei:VocationalSkillsTraining ;
    skos:definition "Vocational and technical training programs that build workforce skills in banking, finance, insurance, and related financial services sectors." ;
    skos:exactMatch dac:24081 ;
    skos:example "A technical college program trains loan officers and bank branch staff in credit risk assessment and financial product management." ;
    skos:hiddenLabel "bank staff training",
        "finance training" ;
