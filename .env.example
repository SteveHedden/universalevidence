# Fuseki endpoint inside Compose; use http://localhost:3030/ue/query for a host-run API
FUSEKI_URL=http://fuseki:3030/ue/query

# Frontend reference only: put this setting in site/.env.local or set it at build time
# Local dev: http://localhost:8000 (calls FastAPI directly)
# VPS/production: /api (nginx proxies /api/ → localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Stable HMAC secret for graph edge-detail manifests (generate with openssl rand -hex 32)
GRAPH_EDGE_TOKEN_SECRET=

# Authorized Cloudflare R2 storage; access is not included with the repository
# Direct local loading can use existing files; Compose downloads when configured
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=universalevidence-data

# Search server response budget (seconds); Compose defaults to 10
QUERY_V2_RESPONSE_TIMEOUT_SECONDS=10
