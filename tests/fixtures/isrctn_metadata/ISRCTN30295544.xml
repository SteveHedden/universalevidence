<?xml version='1.0' encoding='utf-8'?>
<trial xmlns:ns0="http://www.67bricks.com/isrctn"><isrctn>ISRCTN30295544</isrctn><ns0:primaryOutcomes>
	<ns0:outcomeMeasure id="30ebf644-813f-4e16-aae1-6f9ce11f091b">
	  <ns0:variable>Maternal knowledge, attitudes, and practices (KAP) regarding child feeding</ns0:variable>
	  <ns0:method>structured KAP questionnaire (psychometrically validated, Cronbach's alpha ≥0.7)</ns0:method>
	  <ns0:timepoints>baseline (month 0), endline (month 18)</ns0:timepoints>
	</ns0:outcomeMeasure>
      </ns0:primaryOutcomes>
      <ns0:primaryOutcome />
      <ns0:secondaryOutcomes>
	<ns0:outcomeMeasure id="01cdf040-4aef-49a8-9523-130da93e64f1">
	  <ns0:variable>Global acute malnutrition (GAM) prevalence</ns0:variable>
	  <ns0:method>MUAC measurement; WHO Anthropometric Analyzer (Z-scores)</ns0:method>
	  <ns0:timepoints>baseline (month 0), midline (month 6), endline (month 18)</ns0:timepoints>
	</ns0:outcomeMeasure>
	<ns0:outcomeMeasure id="cfaddca0-085c-4467-908b-beb04d8a3c19">
	  <ns0:variable>Number of mothers trained in MUAC measurement</ns0:variable>
	  <ns0:method>training attendance log; competency assessment</ns0:method>
	  <ns0:timepoints>month 3, month 12</ns0:timepoints>
	</ns0:outcomeMeasure>
	<ns0:outcomeMeasure id="398068ff-b30f-4f31-90a5-0ff61b9fd1f3">
	  <ns0:variable>Proportion of children receiving nutritional supplements</ns0:variable>
	  <ns0:method>monthly distribution log; care card records</ns0:method>
	  <ns0:timepoints>months 1-18</ns0:timepoints>
	</ns0:outcomeMeasure>
