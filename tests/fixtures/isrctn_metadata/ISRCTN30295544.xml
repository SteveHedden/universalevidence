	  <ns0:method>monthly KAP questionnaire; care card review</ns0:method>
	  <ns0:timepoints>monthly</ns0:timepoints>
	</ns0:outcomeMeasure>
	<ns0:outcomeMeasure id="ee3d76af-23ec-4f1a-8381-1539e4a10cf1">
	  <ns0:variable>Attendance at peer support group meetings</ns0:variable>
	  <ns0:method>monthly attendance register</ns0:method>
	  <ns0:timepoints>months 1-18</ns0:timepoints>
	</ns0:outcomeMeasure>
